    {"tool": "dispatch", "args": {"role": "researcher", "framing": "failure-modes", "agent_id": "wave-3", "counts_toward_cap": false}},
    {"tool": "ingest_return", "args": {"agent_id": "wave-1", "actor": "MAIN", "framing": "first-principles",
