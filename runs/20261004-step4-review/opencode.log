=== live_dispatches semantics (dispatch.py) ===
141:def live_dispatches(events: list[dict]) -> int:
142:    """I5′ (DECISIONS_HYBRID_4 L3): computed from the journal, never a counter."""
143:    started = sum(1 for e in events if e.get("event") == "tool_call" and e["tool"] == "dispatch" and event_ok(e))
144:    returned = sum(1 for e in events if e.get("event") == "tool_call" and e["tool"] == "ingest_return" and event_ok(e))
145:    failed = sum(1 for e in events if e.get("event") == "dispatch_failed")
146:    return max(0, started - returned - failed)
