   270	def self_test(types_path: Path) -> int:
   271	    types = parse_types(types_path)
   272	    if len(types["categories"]) < 14 or "others" not in types["categories"]:
   273	        print(f"self-test FAIL: parsed {len(types['categories'])} categories from {types_path}")
   274	        return 1
   275	    import copy
   276	    ok = True
   277	
   278	    def expect(label, design, want_prefix):
   279	        nonlocal ok
   280	        findings = validate_design(design, types)
   281	        hit = (not findings) if want_prefix is None else any(x.startswith(want_prefix) for x in findings)
   282	        print(f"{'ok  ' if hit else 'FAIL'} self-test: {label}")
   283	        ok = ok and hit
   284	
   285	    expect("a good design passes clean", _good_design(), None)
   286	    d = copy.deepcopy(_good_design()); d["categories"] = ["research and reports"]
   287	    expect("research-only categories on a building design -> G2", d, "G2")
   288	    d = copy.deepcopy(_good_design()); d["categories"] = ["others"]
   289	    for n in d["nodes"]:
   290	        if n["category"] != "code review":
   291	            n["category"] = "others"
   292	    expect("others may build (exempt) -> clean", d, None)
   293	    d = copy.deepcopy(_good_design()); d["categories"] = ["research and reports"]
   294	    d["nodes"][0]["category"] = "research and reports"; d["nodes"][1]["category"] = "code generation"
   295	    expect("a node category the design does not list -> G8", d, "G8")
   296	    d = copy.deepcopy(_good_design()); d["categories"] = ["research and reports", "code generation", "classification"]
   297	    expect("a claimed category no node carries -> G8", d, "G8")
   298	    d = copy.deepcopy(_good_design()); d["nodes"][1]["check"] = ""
   299	    expect("a node without a check -> G3", d, "G3")
   300	    d = copy.deepcopy(_good_design()); d["nodes"][1]["loop"] = {"exit": "x", "feedback": "y"}
   301	    expect("a loop without a limit -> G3", d, "G3")
   302	    d = copy.deepcopy(_good_design()); d["nodes"][2]["needs"] = ["nope"]
   303	    expect("an edge to a missing node -> G4", d, "G4")
   304	    d = copy.deepcopy(_good_design()); d["nodes"][0]["needs"] = ["n3"]
   305	    expect("a cycle -> G4", d, "G4")
   306	    d = copy.deepcopy(_good_design()); d["nodes"][2]["engine"] = "codex gpt-6-astra"
   307	    expect("a same-kind reviewer on builders -> G6", d, "G6")
   308	    d = copy.deepcopy(_good_design()); d["nodes"] = d["nodes"][:2]
   309	    expect("builders without a reviewer -> G6", d, "G6")
   310	    d = copy.deepcopy(_good_design())
   311	    d["design_source"] = {"type": "challenger", "claim_margin": 0.19, "basis": "b"}
   312	    d["default_estimate"] = {"tokens": 100000}
   313	    d["coverage"] = d["default_coverage"] = {"criteria": ["R1.1"], "checks": ["pytest -q"]}
   314	    expect("a 19% claim -> G5", d, "G5")
   315	    d["design_source"] = {"type": "challenger", "claim_margin": 0.30, "basis": "b"}
   316	    d["estimate"] = {"tokens": 90000}
   317	    expect("margin arithmetic lie (claim .30, recomputed .10) -> G5", d, "G5")
   318	    d = copy.deepcopy(_good_design())
   319	    d["design_source"] = {"type": "challenger", "claim_margin": 0.25, "basis": "b"}
   320	    d["estimate"] = {"tokens": 75000}; d["default_estimate"] = {"tokens": 100000}
   321	    d["coverage"] = {"criteria": ["R1.1"], "checks": ["pytest -q"]}
   322	    d["default_coverage"] = {"criteria": ["R1.1", "R1.2"], "checks": ["pytest -q"]}
   323	    expect("coverage not equal -> G5 even with a real margin", d, "G5")
   324	    row = {k: "x" for k in LEDGER_FIELDS}
   325	    row.update({"design_source": "challenger", "claimed_margin": 0.25, "reconciled": True})
   326	    findings = validate_ledger_row(row)
   327	    print(f"{'ok  ' if not findings else 'FAIL'} self-test: a full challenger ledger row passes")
   328	    ok = ok and not findings
   329	    row2 = dict(row); row2["basis"] = "—"
   330	    hit = any(x.startswith("G7") for x in validate_ledger_row(row2))
   331	    print(f"{'ok  ' if hit else 'FAIL'} self-test: a challenger row without a basis -> G7")
   332	    ok = ok and hit
   333	    print("self-test:", "PASS — the gate can fail" if ok else "FAIL")
   334	    return 0 if ok else 1
