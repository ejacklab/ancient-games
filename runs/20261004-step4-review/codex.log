    66	def _table_rows(md: list[str], header_first_cell: str) -> list[list[str]]:
    67	    rows: list[list[str]] = []
    68	    in_tbl = False
    69	    for line in md:
    70	        s = line.strip()
    71	        if not in_tbl:
    72	            if s.startswith("|") and s.lstrip("|").strip().lower().startswith(header_first_cell.lower()):
    73	                in_tbl = True
    74	            continue
    75	        if not s.startswith("|"):
    76	            break
    77	        if set(s) <= set("|-: "):
    78	            continue
    79	        rows.append([c.strip() for c in s.strip("|").split("|")])
    80	    return rows
