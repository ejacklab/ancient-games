   123	def validate_design(d: dict, types: dict) -> list[str]:
   124	    f: list[str] = []
   125	    known = types["categories"]
   126	    cats = [c.strip().lower() for c in d.get("categories", [])]
   127	    for c in cats:
   128	        if c not in known:
   129	            f.append(f"G1: unknown category {c!r}")
   130	    builds = bool(d.get("builds"))
   131	    touched = d.get("touched_paths") or []
   132	    building_cats = [c for c in cats if known.get(c, {}).get("product") in ("yes", "mixed")]
   133	    if (builds or touched) and cats and not building_cats and "others" not in cats:
   134	        f.append("G2: category-vs-facts: the design builds or touches product paths but carries no "
   135	                 "building category — a wrong category is a stop, not a repair")
   136	    pure_yes = [c for c in cats if known.get(c, {}).get("product") == "yes"]
   137	    if pure_yes and not builds and not touched:
   138	        f.append(f"G2: category {pure_yes[0]!r} always writes product, but the design claims it touches "
   139	                 f"none (a mixed category may run read-only; a yes category may not)")
   140	    nodes = d.get("nodes") or []
   141	    ids = {n.get("id") for n in nodes}
   142	    for n in nodes:
   143	        nid = n.get("id", "?")
   144	        if not (n.get("check") or "").strip():
   145	            f.append(f"G3: node {nid} has no check")
   146	        missing = FIVE - {str(x).lower() for x in n.get("five_things", [])}
   147	        if missing:
   148	            f.append(f"G3: node {nid} is missing {sorted(missing)}")
   149	        lp = n.get("loop")
   150	        if lp is not None:
   151	            if not isinstance(lp.get("limit"), int) or lp["limit"] < 1:
   152	                f.append(f"G3: node {nid} loop has no attempt limit")
   153	            if not (lp.get("exit") or "").strip():
   154	                f.append(f"G3: node {nid} loop has no exit for the limit")
   155	            if not (lp.get("feedback") or "").strip():
   156	                f.append(f"G3: node {nid} loop has no specific feedback")
   157	    for n in nodes:
   158	        for dep in n.get("needs", []) or []:
   159	            if dep not in ids:
   160	                f.append(f"G4: node {n.get('id')} needs unknown node {dep!r}")
   161	    if _has_cycle(nodes):
   162	        f.append("G4: dependency cycle")
   163	    pipe = (d.get("pipeline") or "").strip().lower()
   164	    if pipe and pipe not in types["pipelines"]:
   165	        f.append(f"G4: unknown pipeline {pipe!r}")
   166	    src = d.get("design_source", "default")
   167	    if isinstance(src, dict):
   168	        if src.get("type") != "challenger":
   169	            f.append("G5: a design_source object must be type 'challenger'")
   170	        claim = src.get("claim_margin")
   171	        if not isinstance(claim, (int, float)) or isinstance(claim, bool) or claim < 0.20:
   172	            f.append("G5: challenger claim must be a number >= 0.20")
   173	        if not (src.get("basis") or "").strip():
   174	            f.append("G5: challenger claim has no basis")
   175	        est = (d.get("estimate") or {}).get("tokens")
   176	        dest = (d.get("default_estimate") or {}).get("tokens")
   177	        if isinstance(est, (int, float)) and isinstance(dest, (int, float)) and dest > 0:
   178	            recomputed = (dest - est) / dest
   179	            if recomputed < 0.20:
   180	                f.append(f"G5: recomputed margin {recomputed:.2f} < 0.20")
   181	            elif isinstance(claim, (int, float)) and abs(claim - recomputed) > 0.01:
   182	                f.append(f"G5: margin arithmetic: claim {claim} != recomputed {recomputed:.3f}")
   183	        else:
   184	            f.append("G5: challenger without estimate/default_estimate tokens — the arithmetic cannot be checked")
   185	        cov, dcov = d.get("coverage") or {}, d.get("default_coverage") or {}
   186	        if (set(cov.get("criteria", [])) != set(dcov.get("criteria", []))
   187	                or set(cov.get("checks", [])) != set(dcov.get("checks", []))):
   188	            f.append("G5: coverage differs from the default — coverage is a gate, not an axis")
   189	    builders = [n for n in nodes
   190	                if known.get(_cat(n), {}).get("product") == "yes"
   191	                or (builds and known.get(_cat(n), {}).get("product") == "mixed")]
   192	    if builders:
   193	        reviewers = [n for n in nodes if _cat(n) == "code review"]
   194	        if not reviewers:
   195	            f.append("G6: a design with building nodes has no review node")
   196	        else:
   197	            builder_ids = [b.get("id") for b in builders]
   198	            for r in reviewers:
   199	                rk = engine_kind(r.get("engine", ""))
   200	                targets = r.get("reviews") or builder_ids  # no pairing → reviewed against all builders
   201	                t_nodes = [n for n in nodes if n.get("id") in set(targets)]
   202	                t_kinds = {engine_kind(t.get("engine", "")) for t in t_nodes}
   203	                yes_kinds = {engine_kind(t.get("engine", "")) for t in t_nodes
   204	                             if known.get(_cat(t), {}).get("product") == "yes"}
   205	                # a reviewer must be a different kind from what it reviews; when its targets span
   206	                # kinds, the pure builders are the constraint (round-3, p195)
   207	                constraint = t_kinds if len(t_kinds) == 1 else (yes_kinds or t_kinds)
   208	                if rk == "unknown" or rk in constraint:
   209	                    f.append(f"G6: reviewer engine {r.get('engine')!r} is not a different kind from "
   210	                             f"what it reviews ({sorted(constraint)})")
   211	    node_cats = {_cat(n) for n in nodes if _cat(n)}
   212	    if cats and node_cats:
   213	        for c in sorted(set(cats) - node_cats):
   214	            f.append(f"G8: category {c!r} is claimed but no node carries it — relabel from the algorithm (3.2)")
   215	        # the in-run review node G6 demands is not a deliverable of the prompt, so it may be unlisted
   216	        for c in sorted(node_cats - set(cats) - {"code review"}):
   217	            f.append(f"G8: a node carries category {c!r} that the design does not list")
   218	    return f
