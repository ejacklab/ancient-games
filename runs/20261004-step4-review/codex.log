    48	def engine_kind(engine: str) -> str:
    49	    """The kind of engine a cell names. A **leading** name wins over an embedded one.
    50	
    51	    Two passes because a cell may name more than one engine — the build rows read "opencode ... + Codex ...", and
    52	    the engine named first is the primary one. Matching embedded tokens in one pass returned `codex` for those
    53	    cells (the "+ Codex" matches before the loop reaches `opencode`), which would have told the G6 different-kind
    54	    rule the wrong thing about 60% of the build work.
    55	    """
    56	    e = (engine or "").lower()
    57	    for tok, kind in _KINDS:
    58	        if e.startswith(tok):
    59	            return kind
    60	    for tok, kind in _KINDS:
    61	        if f" {tok}" in e:
    62	            return kind
    63	    return "unknown"
