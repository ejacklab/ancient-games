   221	def parse_ledger(path: Path) -> list[dict]:
   222	    """Read the markdown ledger table into row dicts (columns = LEDGER_KEYS, in order)."""
   223	    rows = []
   224	    for r in _table_rows(Path(path).read_text(errors="replace").splitlines(), "Date"):
   225	        if len(r) < len(LEDGER_KEYS):
   226	            continue
   227	        row = dict(zip(LEDGER_KEYS, r))
   228	        try:
   229	            row["claimed_margin"] = float(row["claimed_margin"])
   230	        except ValueError:
   231	            pass  # "—" for a default row stays a string
   232	        row["reconciled"] = row["reconciled"].strip().lower() in ("yes", "true")
   233	        rows.append(row)
   234	    return rows
