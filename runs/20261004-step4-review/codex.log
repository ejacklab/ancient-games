   102	def _has_cycle(nodes: list[dict]) -> bool:
   103	    by_id = {n.get("id"): n for n in nodes}
   104	    color = {i: 0 for i in by_id}
   105	
   106	    def dfs(u: str) -> bool:
   107	        color[u] = 1
   108	        for v in by_id[u].get("needs", []) or []:
   109	            if v not in color:
   110	                continue
   111	            if color[v] == 1 or (color[v] == 0 and dfs(v)):
   112	                return True
   113	        color[u] = 2
   114	        return False
   115	
   116	    return any(color[i] == 0 and dfs(i) for i in color)
