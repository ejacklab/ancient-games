   337	def main(argv: list[str] | None = None) -> int:
   338	    ap = argparse.ArgumentParser(description="Script layer of the default-first design rule.")
   339	    ap.add_argument("design", nargs="?", help="design JSON file")
   340	    ap.add_argument("--types", default=str(repo_root() / "docs" / "TASK_TYPES.md"))
   341	    ap.add_argument("--ledger-row", metavar="JSON", help="validate one ledger row JSON file")
   342	    ap.add_argument("--ledger", metavar="FILE", help="validate every row of a markdown ledger table")
   343	    ap.add_argument("--self-test", action="store_true")
   344	    a = ap.parse_args(argv)
   345	    if a.self_test:
   346	        return self_test(Path(a.types))
   347	    if not a.design and not a.ledger_row and not a.ledger:
   348	        ap.error("pass a design JSON, --ledger-row, --ledger, or --self-test")
   349	    types = parse_types(Path(a.types))
   350	    findings: list[str] = []
   351	    if a.ledger_row:
   352	        findings += validate_ledger_row(json.loads(Path(a.ledger_row).read_text()))
   353	    if a.ledger:
   354	        for i, row in enumerate(parse_ledger(Path(a.ledger)), 1):
   355	            findings += [f"row {i}: {x}" for x in validate_ledger_row(row)]
   356	    if a.design:
   357	        findings += validate_design(json.loads(Path(a.design).read_text()), types)
   358	    for x in findings:
   359	        print("finding:", x)
   360	    print("PASS" if not findings else f"FAIL: {len(findings)} finding(s)")
   361	    return 1 if findings else 0
   362	
   363	
   364	if __name__ == "__main__":
   365	    sys.exit(main())

