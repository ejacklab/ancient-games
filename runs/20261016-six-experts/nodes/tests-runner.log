# --- P6: one opencode expert at a time ("database is locked", SKILL.md §1)


def test_two_opencode_experts_never_run_at_the_same_time(tmp_path, monkeypatch):
    clock = Ticks()  # Linus moves to opencode, so both seats are opencode
    out, calls, _ticks, rc = run_seats(tmp_path, monkeypatch, "linus,lao-tzu", alive=2, clock=clock,
                                       codex_left=20.0)
    assert rc == 0
    spans = {}
    for sid, engine, model, _prompt in calls:
        if model == "end":
            spans[sid][1] = clock()
        else:
            spans[sid] = [clock(), None]
    assert set(spans) == {"linus", "lao-tzu"}
    assert all(e == "opencode" for _s, e, m, _p in calls if m != "end")
    first, second = sorted(spans.items(), key=lambda kv: kv[1][0])
    assert second[1][0] >= first[1][1], f"{first[0]} and {second[0]} overlapped: {spans}"


def test_the_waiting_expert_starts_only_after_the_first_opencode_expert_exits(tmp_path, monkeypatch, capsys):
    _out, _calls, _ticks, rc = run_seats(tmp_path, monkeypatch, "linus,lao-tzu", alive=2, codex_left=20.0)
    out_lines = [line for line in capsys.readouterr().out.splitlines() if "opencode" in line]
    assert any(line.startswith("waiting ") for line in out_lines), out_lines
    assert rc == 0
