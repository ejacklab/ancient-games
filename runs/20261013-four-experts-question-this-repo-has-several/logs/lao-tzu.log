#!/usr/bin/env python3
"""check-findings.py — the COO's deterministic check of a FINDINGS file.

Why this exists: the workflow's own check runs on the *returned JSON*, so a row the brief allows (a month-precision
date, a file:line source, the control row that cites queries) fails a node whose file on disk is fine. Runs 1 and 2
both blocked on exactly that. This check runs on the **file**, which is the deliverable; the agent's return is only
a digest (method 3.8 item 4).

Usage: check-findings.py FILE [FILE ...] [--labels verified,reported,unknown,unproven] [--min-rows 5]
Prints one line per file plus a per-row defect list. Exit 0 clean, 1 defects, 2 usage.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

LABELS = ("verified", "reported", "unknown", "unproven")
CONTROL = "magmamem"
CONTROL_NEGATED = re.compile(r"not.?found|no such|does not exist|no evidence|zero results|untrustworthy|fabricat|non.?existent", re.I)
ROW = re.compile(r"^\|\s*(F\d+)\s*\|(.*)$")
YEAR = re.compile(r"\b(19|20)\d{2}\b")
URL_OR_PATH = re.compile(r"https?://|\b[\w./-]+\.(md|py|js|ts|json|ya?ml|txt)(:\d+)?\b|\b[\w./-]+:\d+\b")


def rows(text: str):
    for line in text.splitlines():
        m = ROW.match(line)
        if not m:
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 4:
            yield m.group(1), line, None, None
            continue
        yield m.group(1), cells[1], cells[2], cells[3]


def check(path: Path, labels: tuple, min_rows: int) -> list[str]:
    bad: list[str] = []
    text = path.read_text(errors="replace")
    seen = list(rows(text))
    if len(seen) < min_rows:
        bad.append(f"{path.name}: only {len(seen)} finding rows (need >= {min_rows})")
    for rid, claim, label, source in seen:
        if label is None:
            bad.append(f"{path.name}: {rid} has fewer than 4 cells")
            continue
        if label not in labels:
            bad.append(f"{path.name}: {rid} label {label!r} not in {labels}")
        is_control = CONTROL in (claim or "").lower()
        if is_control and CONTROL_NEGATED.search(claim or ""):
            continue  # the control row documents NOT FOUND; it cites queries, not a URL
        if not YEAR.search(f"{claim} {source}"):
            bad.append(f"{path.name}: {rid} carries no dated citation")
        if not URL_OR_PATH.search(source or ""):
            bad.append(f"{path.name}: {rid} source carries no URL or file:line")
    if CONTROL not in text.lower():
        bad.append(f"{path.name}: no control-query row (the MagmaMem sabotage did not run)")
    return bad


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("files", nargs="+")
    ap.add_argument("--labels", default=",".join(LABELS))
    ap.add_argument("--min-rows", type=int, default=5)
    a = ap.parse_args()
    labels = tuple(x.strip() for x in a.labels.split(",") if x.strip())
    findings: list[str] = []
    total = 0
    for f in a.files:
        p = Path(f)
        if not p.exists():
            findings.append(f"{p}: missing")
            continue
        n = len(list(rows(p.read_text(errors="replace"))))
        total += n
        findings += check(p, labels, a.min_rows)
        print(f"{p.name}: {n} rows")
