+# --- the limits --------------------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Limits:
+    """The limits that apply to the index: lines and bytes always, characters only when a row names them, plus
+    where they came from, which every run prints (B4.1, B4.2)."""
+
+    lines: int
+    bytes: int
+    characters: int | None = None
+    from_file: bool = False
+
+    @property
+    def source_line(self) -> str:
+        """The line under the size line that says whether the limits are recorded or the design's example (B4.2)."""
+        if self.from_file:
+            return f"limits: {LIMITS_PATH}"
+        return f"limits: the design's example (no {LIMITS_PATH})"
+
+
+def example_limits() -> Limits:
+    """MAX_LINES and MAX_BYTES, read when they are needed so a test can lower them; no characters limit."""
+    return Limits(lines=MAX_LINES, bytes=MAX_BYTES)
+
+
+def parse_limits(raw: bytes) -> Limits:
+    """The limits the file records: for each unit the smallest `limit` among its rows, and the design's example
+    for a unit no row names (B4.1). A file that is not UTF-8 JSON, is not an object with a non-empty `limits`
+    list, or holds a row missing a field, of the wrong type, or naming an unknown unit, basis or value, raises
+    LimitsError — the caller reports it and the script never falls back to the example silently (B4.5)."""
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise LimitsError("not valid UTF-8") from None
+    try:
+        document = json.loads(text)
+    except ValueError as error:
+        raise LimitsError(f"not valid JSON: {error}") from None
+    if not isinstance(document, dict):
+        raise LimitsError("the top level is not an object")
+    if "limits" not in document:
+        raise LimitsError("no 'limits' list")
+    rows = document["limits"]
+    if not isinstance(rows, list):
+        raise LimitsError("'limits' is not a list")
+    if not rows:
+        raise LimitsError("'limits' is an empty list")
+    smallest = {unit: None for unit in LIMIT_UNITS}
+    for number, row in enumerate(rows, start=1):
+        limit = read_limit_row(row, number)
+        unit = row["unit"]
+        if smallest[unit] is None or limit < smallest[unit]:
+            smallest[unit] = limit
+    return Limits(
+        lines=smallest["lines"] if smallest["lines"] is not None else MAX_LINES,
+        bytes=smallest["bytes"] if smallest["bytes"] is not None else MAX_BYTES,
+        characters=smallest["characters"],
+        from_file=True,
+    )
+
+
+def read_limit_row(row: object, number: int) -> int:
+    """Check one row of the limits file and return its `limit`. Raises LimitsError naming the row and the field,
+    so a bad row after a good one is still a problem (B4.5)."""
+    if not isinstance(row, dict):
+        raise LimitsError(f"row {number} is not an object")
+    for field in LIMIT_TEXT_FIELDS:
+        if field not in row:
+            raise LimitsError(f"row {number} has no {field!r}")
+        if not isinstance(row[field], str) or not row[field].strip():
+            raise LimitsError(f"row {number} has a {field!r} that is not text")
+    if "limit" not in row:
+        raise LimitsError(f"row {number} has no 'limit'")
+    if row["unit"] not in LIMIT_UNITS:
+        raise LimitsError(f"row {number} has an unknown unit {row['unit']!r} (not {' / '.join(LIMIT_UNITS)})")
+    if row["basis"] not in LIMIT_BASES:
+        raise LimitsError(f"row {number} has an unknown basis {row['basis']!r} (not {' / '.join(LIMIT_BASES)})")
+    # `bool` is an `int` in Python, and `json` gives a float for `1.0`: neither is the whole number B4.1 asks for.
+    limit = row["limit"]
+    if isinstance(limit, int) and not isinstance(limit, bool) and limit > 0:
+        return limit
+    raise LimitsError(f"row {number} has a limit that is not a whole number above 0 ({limit!r})")
+
