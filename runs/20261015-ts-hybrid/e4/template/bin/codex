#!/usr/bin/env bash
# Shim for the E4 sandbox: behaves like a codex call that exits 0 and writes nothing (the agy/codex silent-failure
# shape). Records whether stdin was redirected, so the trap count comes from a file, not from the agent's say-so.
stdin_target=$(readlink /proc/$$/fd/0 2>/dev/null || echo unknown)
echo "$(date -u +%FT%TZ) stdin=$stdin_target args=$#" >> "$(dirname "$0")/../.shim-calls.log"
exit 0
