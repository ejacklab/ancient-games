import re
def clean(f):
    s=open(f,encoding='utf-8').read()
    s=re.sub(r'\{\{\*\|.*?\}\}','',s,flags=re.S)   # 韋昭 glosses
    s=re.sub(r'<[^>]+>','',s)
    s=re.sub(r"\{\{[^{}]*\}\}",'',s)
    s=s.replace('彊','強').replace('爲','為').replace('塡','填').replace('无','無').replace('強','強')
    s=re.sub(r'\s+','',s)
    return s
G=clean('____21.wiki'); S=clean('____041.wiki'); H=clean('____129.wiki')
W=clean('___________.wiki')
W2=clean('___________2.wiki') if False else clean('___________.wiki')
open('G.txt','w').write(G); open('S.txt','w').write(S); open('H.txt','w').write(H); open('W.txt','w').write(W)
print(len(G),len(S),len(H),len(W))
