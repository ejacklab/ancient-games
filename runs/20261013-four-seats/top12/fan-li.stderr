import re
PUNC='，。；：？！、「」『』《》〈〉()（）…—－~·“”\-'
def prep(s):
    s=re.sub(r'-\{(.*?)\}-',r'\1',s,flags=re.S)
    s=re.sub(r'\{\{\*\|.*?\}\}','',s,flags=re.S)
    s=re.sub(r'<[^>]+>','',s)
    s=re.sub(r"\{\{[^{}]*\}\}",'',s)
    for a,b in [('彊','強'),('爲','為'),('塡','填'),('无','無'),('于','於'),('－','-')]: s=s.replace(a,b)
    s=re.sub(r'\s+','',s)
    for p in PUNC: s=s.replace(p,'')
    return s
