import re,unicodedata
PUNC='，。；：？！、「」『』《》〈〉()（）…—－~·'
def prep(s):
    s=re.sub(r'\{\{\*\|.*?\}\}','',s,flags=re.S)
    s=re.sub(r'<[^>]+>','',s)
    s=re.sub(r"\{\{[^{}]*\}\}",'',s)
    s=s.replace('彊','強').replace('爲','為').replace('塡','填').replace('无','無')
    s=re.sub(r'\s+','',s)
    for p in PUNC: s=s.replace(p,'')
    return s
