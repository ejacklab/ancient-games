import re
G=open('guoyu21.txt',encoding='utf-8').read()
S=open('shiji041.txt',encoding='utf-8').read()
H=open('shiji129.txt',encoding='utf-8').read()
def norm(t):
    for a,b in [('彊','強'),('強','彊'),('爲','為'),('塡','填'),('无','無'),('讁','讁'),('說','說')]:
        t=t.replace(a,b)
    return t
def clean(t):
    t=re.sub(r'〈.*?〉','',t,flags=re.S)   # drop 韋昭 notes
    return re.sub(r'\s+','',t)
Gn,Sn=norm(clean(G)),norm(clean(S))
q=[
 ("A1 天時不作弗為人客", "天時不作弗為人客"),
 ("A2 人事不起弗為之始", "人事不起弗為之始"),
 ("A3 聖人隨時以行", "夫聖人隨時以行是謂守時"),
 ("B1 人事至天應未", "人事至矣天應未也王姑待之"),
 ("B2 天應至人事未盡", "天應至矣人事未盡也"),
 ("B3 相參成功", "夫人事必將與天地相參然後乃可以成功"),
 ("C1 逆節萌生", "逆節萌生天地未形而先為之征其事是以不成雜受其刑"),
 ("D1 上帝不考", "上帝不考時反是守彊索者不祥得時不成反受其殃"),
 ("D2 王無蚤圖", "王無蚤圖"),
 ("E1 從時救火", "從時者猶救火追亡人也蹶而趨之唯恐弗及"),
