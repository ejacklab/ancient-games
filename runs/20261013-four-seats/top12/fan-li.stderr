import re,html
for name,f in [('guoyu21','guoyu21.html'),('shiji041','shiji041.html')]:
    s=open(f,encoding='utf-8').read()
    m=re.search(r'<div class=\"mw-parser-output\">(.*?)<div class=\"printfooter\"',s,re.S)
    t=m.group(1) if m else s
    t=re.sub(r'<style.*?</style>','',t,flags=re.S)
    t=re.sub(r'<table.*?</table>','',t,flags=re.S)
    t=re.sub(r'<[^>]+>','\n',t)
    t=html.unescape(t)
    lines=[l.strip() for l in t.split('\n')]
    lines=[l for l in lines if l and not l.startswith('*') and '韋昭' not in l and 'biao' not in l.lower()]
    open(name+'.txt','w',encoding='utf-8').write('\n'.join(lines))
    print(name, len(lines))
"
