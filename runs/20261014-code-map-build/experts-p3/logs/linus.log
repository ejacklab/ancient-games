    21	export async function snapshotFiles(roots: string[]): Promise<FileSnapshot> {
    22	  const snapshot: FileSnapshot = {};
    23	  async function visit(path: string) {
    24	    if (Object.hasOwn(snapshot, path)) return;
    25	    const stat = await lstat(path, { bigint: true }).catch(error => {
    26	      if (error.code === "ENOENT") return undefined;
    27	      throw error;
    28	    });
    29	    if (!stat) return;
    30	    const metadata = `${stat.mode}:${stat.size}:${stat.mtimeNs}:${stat.ctimeNs}`;
    31	    if (stat.isSymbolicLink()) snapshot[path] = `symlink:${metadata}:${await readlink(path)}`;
    32	    else if (stat.isDirectory()) {
    33	      snapshot[path] = `directory:${stat.mode}:${stat.mtimeNs}:${stat.ctimeNs}`;
    34	      for (const entry of (await readdir(path)).sort()) await visit(join(path, entry));
    35	    } else if (stat.isFile()) snapshot[path] = `file:${metadata}:${createHash("sha256").update(await readFile(path)).digest("hex")}`;
    36	    else snapshot[path] = `other:${metadata}`;
    37	  }
    38	  for (const root of [...new Set(roots)].sort()) await visit(root);
    39	  return snapshot;
    40	}
