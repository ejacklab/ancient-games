import { writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import type { Answer } from "./answer.ts";
import { answerFor, type Options } from "./commands.ts";
import { renderText } from "./render.ts";

const commands = new Set(["where", "find", "callers", "callees", "chain", "tests", "map"]);

const valuedFlags = new Set(["--project", "--root", "--tests", "--siblings", "--up", "--down", "--fake-rule", "--file", "--out"]);

interface Parsed {
  options: Options;
  out?: string;
}

export function parseArguments(argv: string[]): Parsed {
  const project: string[] = [];
  const tests: string[] = [];
  const siblings: string[] = [];
  const query: string[] = [];
  let root = process.cwd();
  let json = false;
  let perFunction = false;
  let up: number | undefined;
  let down: number | undefined;
  let fakeRule: "count" | "exclude" | undefined;
  let file: string | undefined;
  let out: string | undefined;
  const command = argv[0];
  if (!command || !commands.has(command)) {
    throw new Error(`Usage: code-map <${[...commands].join("|")}> <query> --project <tsconfig.json> [--root <dir>] [--tests <glob>]... [--json]`);
  }
  for (let index = 1; index < argv.length; index++) {
    const flag = argv[index]!;
    if (flag === "--json") {
      json = true;
      continue;
    }
    if (flag === "--per-function") {
      perFunction = true;
      continue;
    }
    if (valuedFlags.has(flag)) {
      const value = argv[++index];
      if (value === undefined) throw new Error(`${flag} needs a value`);
      if (flag === "--project") project.push(value);
      else if (flag === "--tests") tests.push(value);
      else if (flag === "--siblings") siblings.push(value);
      else if (flag === "--root") root = value;
      else if (flag === "--out") out = value;
      else if (flag === "--file") file = value;
      else if (flag === "--up") up = positiveInteger(flag, value);
      else if (flag === "--down") down = positiveInteger(flag, value);
      else if (flag === "--fake-rule") {
        if (value !== "count" && value !== "exclude") throw new Error("--fake-rule needs count or exclude");
        fakeRule = value;
      }
      continue;
    }
    if (flag.startsWith("--")) throw new Error(`unknown option ${flag}`);
    query.push(flag);
  }
  if (!project.length) throw new Error("--project <tsconfig.json> is required");
  return {
    out,
    options: {
      command,
      query,
      project,
      root: resolve(root),
      tests,
      siblings,
      up,
      down,
      fakeRule,
      file,
      perFunction,
      json,
    },
  };
}

function positiveInteger(flag: string, value: string): number {
  const number = Number(value);
  if (!Number.isInteger(number) || number < 0) throw new Error(`${flag} needs a whole number of levels`);
  return number;
}

export async function run(argv: string[]): Promise<number> {
  let parsed: Parsed;
  try {
    parsed = parseArguments(argv);
  } catch (error) {
    console.error(String(error instanceof Error ? error.message : error));
    return 2;
  }
  const json = parsed.options.json;
  let answer: Answer;
  try {
    answer = answerFor(parsed.options);
  } catch (error) {
    console.error(String(error instanceof Error ? error.message : error));
    return 2;
  }
  const text = json ? JSON.stringify(answer) : renderText(answer);
  if (parsed.out) await writeFile(resolve(parsed.out), `${text}\n`);
  else console.log(text);
  return 0;
}

if (import.meta.main) process.exitCode = await run(Bun.argv.slice(2));export type NodeKind =
  | "function" | "method" | "arrow" | "effect-fn" | "property" | "class" | "variable" | "interface-member" | "other";

export type Loc = { file: string; line: number; endLine?: number };
export type Node = Loc & { name: string; kind: NodeKind };

export type LimitReason = "depth" | "dynamic" | "outside-repo" | "other-process" | "not-found" | "seen" | "other";
export type Limit = { at?: Loc; reason: LimitReason; text?: string; ref?: Loc };

export type Candidate = Node & { testFake: boolean };

export type Link = {
  from: Node;
  site: Loc;
  kind: "call" | "new" | "service-call";
  declaration?: Loc;
  resolution: "implementation" | "ambiguous" | "unresolved";
  to?: Node;
  candidates: Candidate[];
  via: "definition" | "implementation-lookup";
  reason?: string;
};

export type ChainStep = { level: number; link: Link; children: ChainStep[]; stop?: Limit };

export type TestCase = { file: string; line: number; name: string; path: Link[]; throughFake: boolean };
export type TestsAnswer = { label: "static-call-path"; count: number; tests: TestCase[]; undecided: TestCase[] };

export type StepKind = "call" | "if" | "else" | "loop" | "try" | "catch" | "return" | "yield*";
export type Step = { kind: StepKind; at: Loc; text: string; children?: Step[] };

export type Siblings = {
  members: string[];
  rows: { concern: string; status: "shared" | "varies" | "unclear"; cells: { member: string; text: string; at: Loc }[] }[];
};

export type ModuleMap = {
  definitions: Node[];
  links: Link[];
  entries: { fn: Node; steps: Step[] }[];
  siblings?: Siblings;
};

export type Answer = {
  command: string;
  query: string[];
  ambiguous?: boolean;
  matches?: Node[];
  links?: Link[];
  chain?: { up: ChainStep[]; down: ChainStep[] };
  tests?: TestsAnswer;
  map?: ModuleMap;
  limits: Limit[];
  empty?: "none found by static analysis";
};

export const emptyMarker = "none found by static analysis" as const;

export function isEmptyAnswer(answer: Answer): boolean {
  const collections: (Node[] | Link[] | ChainStep[] | TestCase[] | unknown[] | undefined)[] = [answer.matches, answer.links];
  if (answer.chain) collections.push(answer.chain.up, answer.chain.down);
  if (answer.tests) collections.push(answer.tests.tests, answer.tests.undecided);
  if (answer.map) collections.push(answer.map.definitions, answer.map.links, answer.map.entries);
  return collections.every(value => value === undefined || value.length === 0);
}

export function finish(answer: Answer): Answer {
  if (answer.empty === undefined && isEmptyAnswer(answer)) return { ...answer, empty: emptyMarker };
  return answer;
}

/** One limit per reason, at the first place it happened; each link keeps its own reason. */
export class LimitLog {
  private items: Limit[] = [];
  private keys = new Set<string>();

  add(limit: Limit): void {
    const key = limit.reason === "other" ? JSON.stringify(limit) : limit.reason;
    if (this.keys.has(key)) return;
    this.keys.add(key);
    this.items.push(limit);
  }

  addReason(reason: LimitReason, at?: Loc, text?: string): void {
    this.add(at ? { at, reason, ...(text ? { text } : {}) } : { reason, ...(text ? { text } : {}) });
  }

  get all(): Limit[] {
    return this.items;
  }
}import ts from "typescript";
import {
  finish, LimitLog, type Answer, type ChainStep, type Link, type ModuleMap, type Node, type Siblings,
  type TestCase, type TestsAnswer,
} from "./answer.ts";
import { stepsOf } from "./flow.ts";
import {
  analyzeCall, callSitesIn, computedCallsIn, findCallers, isTestFile, resolvedDeclaration, type AnalysisContext,
} from "./links.ts";
import {
  belongsTo, definitionKind, definitionsIn, isFunctionLikeDeclaration, lineOf, located, nearestFunction, nodeOf,
  placeableKind, searchableDefinitions, type Definition,
} from "./nodes.ts";
import { createProject, type Project } from "./project.ts";
import { siblingTable } from "./siblings.ts";

export interface Options {
  command: string;
  query: string[];
  project: string[];
  root: string;
  tests: string[];
  siblings: string[];
  up?: number;
  down?: number;
  fakeRule?: "count" | "exclude";
  file?: string;
  perFunction: boolean;
  json?: boolean;
}

interface Session {
  project: Project;
  limits: LimitLog;
  context: AnalysisContext;
  definitions: Definition[];
  index: Map<string, Definition>;
}

const normalize = (text: string) => text.replace(/[\t ]+$/gm, "").replace(/\s+$/, "");
const codeText = (text: string) => normalize(text).replace(/;$/, "");
const keyOf = (node: { file: string; line: number }) => `${node.file}:${node.line}`;
const isNameQuery = (query: string) => /^[A-Za-z_$][\w$]*(\.[A-Za-z_$][\w$]*)?$/.test(query);

/** The places a definition answers to: its own line, and the line of the function that implements it. */
function keysOf(project: Project, definition: Definition): string[] {
  const keys = [keyOf(definition.node)];
  if (definition.implementation) keys.push(keyOf(located(project, definition.implementation)));
  return keys;
}

function buildIndex(project: Project, definitions: Definition[]): Map<string, Definition> {
  const index = new Map<string, Definition>();
  for (const definition of definitions) {
    for (const key of keysOf(project, definition)) {
      const existing = index.get(key);
      if (!existing || (!placeableKind(existing.node.kind) && placeableKind(definition.node.kind))) index.set(key, definition);
    }
  }
  return index;
}

function definitionsByName(session: Session, query: string): Definition[] {
  return session.definitions.filter(definition =>
    definition.node.name === query || definition.node.name.endsWith(`.${query}`));
}

function firstLine(text: string): string {
  const line = text.split("\n")[0]!.trim();
  return line.length > 60 ? `${line.slice(0, 57)}...` : line;
}

function matchesByText(session: Session, query: string): Node[] {
  const wanted = codeText(query);
  const found = new Map<string, Node>();
  for (const file of session.project.files) {
    const visit = (node: ts.Node): void => {
      if (!ts.isToken(node) && codeText(node.getText(file)) === wanted) {
        const enclosing = nearestFunction(node);
        const match = enclosing
          ? nodeOf(session.project, enclosing)
          : { ...located(session.project, node), name: firstLine(node.getText(file)), kind: "other" as const };
        found.set(keyOf(match), match);
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return [...found.values()];
}

/** The nodes whose written comments belong to a definition: the declaration, and the statement it sits in. */
function documentedNodes(declaration: ts.Node): ts.Node[] {
  const nodes = [declaration];
  for (let parent = declaration.parent; parent && !ts.isSourceFile(parent); parent = parent.parent) {
    if (ts.isStatement(parent) || ts.isClassElement(parent) || ts.isInterfaceDeclaration(parent)) {
      nodes.push(parent);
      break;
    }
  }
  return nodes;
}

/** What a definition says in writing: its name, plus the comments and string literals around and inside it. */
function writtenText(definition: Definition): string {
  const source = definition.declaration.getSourceFile();
  const written: string[] = [];
  const commentTexts = (ranges: ts.CommentRange[] | undefined): string[] =>
    (ranges ?? []).map(range => source.text.slice(range.pos, range.end).toLowerCase());
  for (const node of documentedNodes(definition.declaration)) written.push(...commentTexts(ts.getLeadingCommentRanges(source.text, node.getFullStart())));
  written.push(...commentTexts(ts.getTrailingCommentRanges(source.text, definition.declaration.getEnd())));
  const scanner = ts.createScanner(
    ts.ScriptTarget.Latest, false, source.languageVariant ?? ts.LanguageVariant.Standard,
    source.text.slice(definition.declaration.getStart(source), definition.declaration.getEnd()),
  );
  for (let token = scanner.scan(); token !== ts.SyntaxKind.EndOfFileToken; token = scanner.scan()) {
    if (token === ts.SyntaxKind.SingleLineCommentTrivia || token === ts.SyntaxKind.MultiLineCommentTrivia ||
        token === ts.SyntaxKind.StringLiteral || token === ts.SyntaxKind.NoSubstitutionTemplateLiteral) {
      written.push(scanner.getTokenText().toLowerCase());
    }
  }
  return [definition.node.name.toLowerCase(), ...written].join("\n");
}

function matchesByDescription(session: Session, query: string): Node[] {
  const wanted = query.toLowerCase().trim();
  const words = wanted.split(/\s+/).filter(Boolean);
  const scored: { node: Node; score: number }[] = [];
  for (const definition of session.definitions) {
    const name = definition.node.name.toLowerCase();
    const written = writtenText(definition);
    const score = name.includes(wanted) ? 3
      : words.every(word => name.includes(word)) ? 2
      : words.every(word => written.includes(word)) ? 1
      : 0;
    if (score) scored.push({ node: definition.node, score });
  }
  const best = scored.reduce((most, entry) => Math.max(most, entry.score), 0);
  return best ? scored.filter(entry => entry.score === best).map(entry => entry.node) : [];
}

interface TestRecord {
  node: Node;
  body: ts.Node;
}

function testRecords(session: Session): TestRecord[] {
  const records: TestRecord[] = [];
  for (const file of session.project.files) {
    if (!isTestFile(session.context.testPatterns, session.project.pathOf(file)!)) continue;
    const visit = (node: ts.Node): void => {
      if (ts.isCallExpression(node)) {
        const callee = node.expression.getText().split(".").pop();
        const title = node.arguments[0];
        const body = node.arguments[1];
        if ((callee === "test" || callee === "it") && title && ts.isStringLiteralLike(title) && body &&
