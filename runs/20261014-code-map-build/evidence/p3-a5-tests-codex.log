diff --git a/code_map/test/a5/one-question-one-answer.test.ts b/code_map/test/a5/one-question-one-answer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf0850396247cf820391a0ca6001a3c7239566a0
--- /dev/null
