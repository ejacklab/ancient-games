+        (value.endLine !== undefined && (!Number.isInteger(value.endLine) || (value.endLine as number) < (value.line as number)))) {
+      fail(path, "relative file and positive 1-based line (endLine >= line)", value); return false;
+    }
+    return true;
+  }
