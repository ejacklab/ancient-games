  tests: string[];
  siblings: string[];
  up?: number;
  down?: number;
  fakeRule?: "count" | "exclude";
  file?: string;
  perFunction: boolean;
  json?: boolean;
}

interface Session {
  project: Project;
  limits: LimitLog;
  context: AnalysisContext;
  definitions: Definition[];
  index: Map<string, Definition>;
}

const normalize = (text: string) => text.replace(/[\t ]+$/gm, "").replace(/\s+$/, "");
const codeText = (text: string) => normalize(text).replace(/;$/, "");
const keyOf = (node: { file: string; line: number }) => `${node.file}:${node.line}`;
const isNameQuery = (query: string) => /^[A-Za-z_$][\w$]*(\.[A-Za-z_$][\w$]*)?$/.test(query);

/** The places a definition answers to: its own line, and the line of the function that implements it. */
function keysOf(project: Project, definition: Definition): string[] {
  const keys = [keyOf(definition.node)];
  if (definition.implementation) keys.push(keyOf(located(project, definition.implementation)));
  return keys;
}

function buildIndex(project: Project, definitions: Definition[]): Map<string, Definition> {
  const index = new Map<string, Definition>();
  for (const definition of definitions) {
    for (const key of keysOf(project, definition)) {
      const existing = index.get(key);
      if (!existing || (!placeableKind(existing.node.kind) && placeableKind(definition.node.kind))) index.set(key, definition);
    }
  }
  return index;
}

function definitionsByName(session: Session, query: string): Definition[] {
  return session.definitions.filter(definition =>
    definition.node.name === query || definition.node.name.endsWith(`.${query}`));
}

function firstLine(text: string): string {
  const line = text.split("\n")[0]!.trim();
  return line.length > 60 ? `${line.slice(0, 57)}...` : line;
}

function matchesByText(session: Session, query: string): Node[] {
  const wanted = codeText(query);
  const found = new Map<string, Node>();
  for (const file of session.project.files) {
    const visit = (node: ts.Node): void => {
      if (!ts.isToken(node) && codeText(node.getText(file)) === wanted) {
        const enclosing = nearestFunction(node);
        const match = enclosing
          ? nodeOf(session.project, enclosing)
          : { ...located(session.project, node), name: firstLine(node.getText(file)), kind: "other" as const };
        found.set(keyOf(match), match);
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return [...found.values()];
}

/** The nodes whose written comments belong to a definition: the declaration, and the statement it sits in. */
function documentedNodes(declaration: ts.Node): ts.Node[] {
  const nodes = [declaration];
  for (let parent = declaration.parent; parent && !ts.isSourceFile(parent); parent = parent.parent) {
    if (ts.isStatement(parent) || ts.isClassElement(parent) || ts.isInterfaceDeclaration(parent)) {
      nodes.push(parent);
      break;
    }
  }
  return nodes;
}

/** What a definition says in writing: its name, plus the comments and string literals around and inside it. */
function writtenText(definition: Definition): string {
  const source = definition.declaration.getSourceFile();
  const written: string[] = [];
  const commentTexts = (ranges: ts.CommentRange[] | undefined): string[] =>
    (ranges ?? []).map(range => source.text.slice(range.pos, range.end).toLowerCase());
  for (const node of documentedNodes(definition.declaration)) written.push(...commentTexts(ts.getLeadingCommentRanges(source.text, node.getFullStart())));
  written.push(...commentTexts(ts.getTrailingCommentRanges(source.text, definition.declaration.getEnd())));
  const scanner = ts.createScanner(
    ts.ScriptTarget.Latest, false, source.languageVariant ?? ts.LanguageVariant.Standard,
    source.text.slice(definition.declaration.getStart(source), definition.declaration.getEnd()),
  );
  for (let token = scanner.scan(); token !== ts.SyntaxKind.EndOfFileToken; token = scanner.scan()) {
    if (token === ts.SyntaxKind.SingleLineCommentTrivia || token === ts.SyntaxKind.MultiLineCommentTrivia ||
        token === ts.SyntaxKind.StringLiteral || token === ts.SyntaxKind.NoSubstitutionTemplateLiteral) {
      written.push(scanner.getTokenText().toLowerCase());
    }
  }
  return [definition.node.name.toLowerCase(), ...written].join("\n");
}

function matchesByDescription(session: Session, query: string): Node[] {
  const wanted = query.toLowerCase().trim();
  const words = wanted.split(/\s+/).filter(Boolean);
  const scored: { node: Node; score: number }[] = [];
  for (const definition of session.definitions) {
    const name = definition.node.name.toLowerCase();
    const written = writtenText(definition);
    const score = name.includes(wanted) ? 3
      : words.every(word => name.includes(word)) ? 2
      : words.every(word => written.includes(word)) ? 1
      : 0;
    if (score) scored.push({ node: definition.node, score });
  }
  const best = scored.reduce((most, entry) => Math.max(most, entry.score), 0);
  return best ? scored.filter(entry => entry.score === best).map(entry => entry.node) : [];
}

interface TestRecord {
  node: Node;
  body: ts.Node;
}

function testRecords(session: Session): TestRecord[] {
  const records: TestRecord[] = [];
  for (const file of session.project.files) {
    if (!isTestFile(session.context.testPatterns, session.project.pathOf(file)!)) continue;
    const visit = (node: ts.Node): void => {
      if (ts.isCallExpression(node)) {
        const callee = node.expression.getText().split(".").pop();
        const title = node.arguments[0];
        const body = node.arguments[1];
        if ((callee === "test" || callee === "it") && title && ts.isStringLiteralLike(title) && body &&
            (ts.isArrowFunction(body) || ts.isFunctionExpression(body))) {
          records.push({
            body,
            node: { ...located(session.project, node), name: title.text, kind: "arrow" },
          });
        }
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return records.sort((left, right) => keyOf(left.node).localeCompare(keyOf(right.node)));
}

function throughFakeOf(path: Link[]): boolean {
  return path.some(link => link.kind === "service-call" && link.candidates.some(candidate => candidate.testFake));
}

interface Reach {
  node: Node;
  path: Link[];
}

function reachableFrom(session: Session, start: ts.Node, from: Node): Map<string, Reach> {
  const reached = new Map<string, Reach>();
  const queue: { declaration: ts.Node; from: Node; path: Link[] }[] = [{ declaration: start, from, path: [] }];
  let visited = 0;
  while (queue.length && visited < 400) {
    const current = queue.shift()!;
    visited++;
    for (const site of callSitesIn(session.project, current.declaration.getSourceFile())) {
      if (!belongsTo(site.node, current.declaration)) continue;
      const link = analyzeCall(session.project, site, session.context);
      if (current.path.length === 0) link.from = current.from;
      if (!link.to) continue;
      const key = keyOf(link.to);
      if (reached.has(key)) continue;
      const path = [...current.path, link];
      reached.set(key, { node: link.to, path });
      const definition = session.index.get(key);
      if (definition && placeableKind(definition.node.kind)) {
        queue.push({ declaration: walkTarget(definition), from: link.to, path });
      }
    }
  }
  return reached;
}

/** The function that carries a definition's body: its initializer, or the body a wrapper call was given. */
function walkTarget(definition: Definition): ts.Node {
  return definition.implementation ?? definition.declaration;
}

/**
 * The place a line names when no definition begins there: the function written around it — a body inside a
 * named function belongs to that function — or the module's top level when the line is a call no function and
 * no declaration carries. Every node a link names as its `from` answers to one of these, so `callees` on it
 * can be asked.
 */
function placeAround(session: Session, file: string, line: number): Definition | undefined {
  const project = session.project;
  const source = project.sourceOf({ file });
  if (!source) return undefined;
  let inner: ts.Node | undefined;
  let topLevel: ts.Node | undefined;
  const visit = (node: ts.Node): void => {
    if (isFunctionLikeDeclaration(node)) {
      const span = located(project, node);
      if (span.line <= line && line <= (span.endLine ?? span.line)) inner = node;
    }
    else if (!topLevel && (ts.isCallExpression(node) || ts.isNewExpression(node)) &&
             lineOf(source, node.getStart(source)) === line && belongsTo(node, source)) {
      topLevel = node;
    }
    ts.forEachChild(node, visit);
  };
  visit(source);
  if (inner) {
    const written = nodeOf(project, inner);
    return {
      node: { ...written, kind: definitionKind(project, inner) ?? written.kind },
      declaration: inner as ts.Declaration,
    };
  }
  if (topLevel) return { node: { ...located(project, topLevel), name: "<module>", kind: "other" }, declaration: source };
  return undefined;
}

function placeFor(session: Session, argument: string): { place?: Definition; candidates: Definition[] } {
  const position = /^(.*):(\d+)$/.exec(argument);
  if (position) {
    const file = position[1]!;
    const line = Number(position[2]);
    const definitions = session.definitions.filter(definition => keysOf(session.project, definition).includes(`${file}:${line}`));
    const place = definitions.find(definition => placeableKind(definition.node.kind)) ?? definitions[0];
    return { place: place ?? placeAround(session, file, line), candidates: [] };
  }
  const candidates = definitionsByName(session, argument);
  return candidates.length === 1 ? { place: candidates[0], candidates } : { place: undefined, candidates };
}

function isExported(session: Session, declaration: ts.Declaration): boolean {
  const checker = session.project.checker;
  const modifiers = (declaration as { modifiers?: ts.NodeArray<ts.ModifierLike> }).modifiers;
  if (modifiers?.some(modifier => modifier.kind === ts.SyntaxKind.ExportKeyword)) return true;
  const file = declaration.getSourceFile();
  const moduleSymbol = checker.getSymbolAtLocation(file);
  const name = (declaration as { name?: ts.Node }).name;
  const symbol = name ? checker.getSymbolAtLocation(name) : undefined;
  if (!moduleSymbol || !symbol) return false;
  const resolved = symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol;
  return checker.getExportsOfModule(moduleSymbol).some(exported => exported === symbol || exported === resolved);
}

function moduleFiles(session: Session, paths: string[]): ts.SourceFile[] {
  const wanted = new Set<string>();
  for (const path of paths) {
    const trimmed = path.replace(/^\.\/+/, "").replace(/\/+$/, "");
    if (trimmed === "" || trimmed === ".") {
      for (const file of session.project.files) wanted.add(session.project.pathOf(file)!);
      continue;
    }
    const source = session.project.sourceOf({ file: trimmed });
    if (source) {
      wanted.add(trimmed);
      continue;
    }
    const prefix = `${trimmed}/`;
    let found = false;
    for (const file of session.project.files) {
      const path2 = session.project.pathOf(file)!;
      if (path2 === trimmed || path2.startsWith(prefix)) {
        wanted.add(path2);
        found = true;
      }
    }
    if (!found) {
      session.limits.addReason("not-found", undefined, `${path} is not a file or folder of this program`);
    }
  }
  return session.project.files.filter(file => wanted.has(session.project.pathOf(file)!));
}

/** Calls made inside one place, including the bodies written straight into calls inside it. */
function calleesOf(session: Session, implementation: ts.Node): Link[] {
  const file = implementation.getSourceFile();
  for (const node of computedCallsIn(file)) {
    if (!belongsTo(node, implementation)) continue;
    session.limits.addReason("dynamic", located(session.project, node), `${node.getText()} names its callee at run time`);
  }
  return callSitesIn(session.project, file)
    .filter(site => belongsTo(site.node, implementation))
    .map(site => analyzeCall(session.project, site, session.context));
}

function chainDown(session: Session, declaration: ts.Node, level: number, maxDepth: number, expanded: Map<string, Node>): ChainStep[] {
  if (level > maxDepth) return [];
  return calleesOf(session, declaration).map(link => {
    const step: ChainStep = { level, link, children: [] };
    const target = link.to;
    if (target) {
      const firstSeen = expanded.get(keyOf(target));
      if (firstSeen) {
        step.stop = { reason: "seen", ref: { file: firstSeen.file, line: firstSeen.line } };
      } else {
        expanded.set(keyOf(target), target);
        const next = session.index.get(keyOf(target));
        if (level < maxDepth && next && placeableKind(next.node.kind)) {
          step.children = chainDown(session, walkTarget(next), level + 1, maxDepth, expanded);
        }
      }
    }
    if (level === maxDepth && !step.stop) step.stop = { reason: "depth" };
    return step;
  });
}

function chainUp(session: Session, place: Definition, level: number, maxDepth: number, expanded: Map<string, Node>): ChainStep[] {
  if (level > maxDepth) return [];
  const steps: ChainStep[] = [];
  for (const entry of findCallers(session.project, place.declaration, session.context)) {
    const link = entry.link;
    const joined = link.to && keyOf(link.to) === keyOf(place.node);
    if (!joined) {
      session.limits.addReason("other", link.site, `a call to ${place.node.name} did not resolve to this one implementation and was not expanded`);
      continue;
    }
    const step: ChainStep = { level, link, children: [] };
    const target = link.from;
    const firstSeen = expanded.get(keyOf(target));
    if (firstSeen) {
      step.stop = { reason: "seen", ref: { file: firstSeen.file, line: firstSeen.line } };
    } else {
      expanded.set(keyOf(target), target);
      const next = session.index.get(keyOf(target));
      if (level < maxDepth && next && placeableKind(next.node.kind) && entry.enclosing) {
        step.children = chainUp(session, next, level + 1, maxDepth, expanded);
      }
    }
    if (level === maxDepth && !step.stop) step.stop = { reason: "depth" };
    steps.push(step);
  }
  return steps;
}

function siblingMembers(session: Session, globs: string[]): string[] {
  return session.project.files
    .map(file => session.project.pathOf(file)!)
    .filter(path => globs.some(glob => new Bun.Glob(glob).match(path)))
    .sort();
}

function buildMap(session: Session, options: Options): ModuleMap {
  const files = moduleFiles(session, options.query);
  const definitions: Node[] = [];
  const links: Link[] = [];
  for (const file of files) {
    for (const definition of definitionsIn(session.project, file)) definitions.push(definition.node);
    links.push(...calleesOfFile(session, file));
  }
  const inside = new Set(files.map(file => session.project.pathOf(file)!));
  const insideDefinitions = new Map<string, Definition>();
  for (const definition of session.definitions) {
    if (!inside.has(definition.node.file)) continue;
    for (const key of keysOf(session.project, definition)) insideDefinitions.set(key, definition);
  }
  const called = new Set<string>();
  for (const file of session.project.files) {
    if (inside.has(session.project.pathOf(file)!)) continue;
    for (const site of callSitesIn(session.project, file)) {
      const declaration = resolvedDeclaration(session.project, site);
      if (!declaration) continue;
      const path = session.project.pathOf(declaration);
      if (!path || !inside.has(path)) continue;
      const key = keyOf(located(session.project, declaration));
      if (insideDefinitions.has(key)) called.add(key);
    }
  }
  const entries = [...called]
    .map(key => insideDefinitions.get(key)!)
    .filter(definition => placeableKind(definition.node.kind) && isExported(session, definition.declaration))
    .sort((left, right) => keyOf(left.node).localeCompare(keyOf(right.node)))
    .map(definition => ({ fn: definition.node, steps: stepsOf(session.project, definition.declaration) }));
  const map: ModuleMap = { definitions, links, entries };
  if (options.siblings.length) {
    const members = siblingMembers(session, options.siblings);
    const table: Siblings | undefined = members.length ? siblingTable(session.project, members) : undefined;
    if (table) map.siblings = table;
    else session.limits.addReason("other", undefined, "the sibling rule matched no files of this program");
  } else {
    session.limits.addReason("other", undefined, "no sibling rule given (A1)");
  }
  return map;
}

function calleesOfFile(session: Session, file: ts.SourceFile): Link[] {
  return callSitesIn(session.project, file).map(site => analyzeCall(session.project, site, session.context));
}

function buildTests(session: Session, options: Options, keys: Set<string>): TestsAnswer {
  const cases: TestCase[] = [];
  for (const record of testRecords(session)) {
    const reached = reachableFrom(session, record.body, record.node);
    for (const key of keys) {
      const reach = reached.get(key);
      if (!reach || !reach.path.length) continue;
      cases.push({ file: record.node.file, line: record.node.line, name: record.node.name, path: reach.path, throughFake: throughFakeOf(reach.path) });
    }
  }
  const decided = cases.filter(testCase => !testCase.throughFake);
  const faked = cases.filter(testCase => testCase.throughFake);
  const tests = options.fakeRule === "count" ? decided.concat(faked) : decided;
  const undecided = options.fakeRule ? [] : faked;
  if (undecided.length) session.limits.addReason("other", undefined, "fake rule not set (A3)");
  return { label: "static-call-path", count: tests.length, tests, undecided };
}

function testsFor(session: Session, options: Options, argument: string | undefined): TestsAnswer {
  const keys = new Set<string>();
  if (options.file !== undefined) {
    for (const definition of session.definitions) {
      if (definition.node.file !== options.file || !placeableKind(definition.node.kind)) continue;
      for (const key of keysOf(session.project, definition)) keys.add(key);
    }
  } else if (argument !== undefined) {
    const place = placeFor(session, argument).place;
    if (place) keys.add(keyOf(place.node));
  }
  return buildTests(session, options, keys);
}

/** One place, every candidate when the name is ambiguous, or the not-found limit. */
function answerThePlace(answer: Answer, session: Session, argument: string): Definition | undefined {
  const { place, candidates } = placeFor(session, argument);
  if (candidates.length > 1) {
    answer.matches = candidates.map(candidate => candidate.node);
    answer.ambiguous = true;
    return undefined;
  }
  if (!place) {
    answer.matches = [];
    answer.ambiguous = false;
    session.limits.addReason("not-found", undefined, `no definition was found at ${argument}`);
    return undefined;
  }
  return place;
}

export function answerFor(options: Options): Answer {
  const project = createProject(options.project, options.root);
  const limits = new LimitLog();
  const session: Session = {
    project,
    limits,
    context: { testPatterns: options.tests, limits },
    definitions: searchableDefinitions(project),
    index: new Map(),
  };
  session.index = buildIndex(project, session.definitions);
  if (!options.tests.length) limits.addReason("other", undefined, "no test-file pattern given");
  const answer: Answer = { command: options.command, query: options.query, limits: [] };
  const argument = options.query[0] ?? "";

  switch (options.command) {
    case "where":
    case "find": {
      let matches: Node[];
      if (isNameQuery(argument)) {
        matches = definitionsByName(session, argument).map(definition => definition.node);
        // A word that names nothing may still be what a definition says about itself.
        if (!matches.length) matches = matchesByDescription(session, argument);
      }
      else {
        matches = matchesByText(session, argument);
        if (!matches.length) matches = matchesByDescription(session, argument);
      }
      answer.matches = matches;
      answer.ambiguous = matches.length > 1;
      if (!matches.length) {
        session.limits.addReason("not-found", undefined, `nothing named or written like ${argument} was found`);
      }
      break;
    }
    case "map": {
      answer.map = buildMap(session, options);
      break;
    }
    case "tests": {
      if (options.file !== undefined) {
        if (!options.perFunction) {
          session.limits.addReason("other", undefined, "per-function report requires --per-function (A3)");
          answer.empty = "none found by static analysis";
          break;
        }
        answer.tests = testsFor(session, options, undefined);
        break;
      }
      const place = answerThePlace(answer, session, argument);
      if (place) answer.tests = testsFor(session, options, argument);
      break;
    }
    case "callers":
    case "callees":
    case "chain": {
      const place = answerThePlace(answer, session, argument);
      if (!place) break;
      if (!placeableKind(place.node.kind) && !ts.isSourceFile(place.declaration)) {
        answer.matches = [place.node];
        answer.ambiguous = false;
        session.limits.addReason("other", undefined, `${place.node.name} is a declaration, not an implementation to walk`);
        break;
      }
      if (options.command === "callees") answer.links = calleesOf(session, walkTarget(place));
      else if (options.command === "callers") {
        answer.links = findCallers(project, place.declaration, session.context).map(entry => entry.link);
      } else {
        const up = options.up ?? 6;
        const down = options.down ?? 6;
        if (up === 0 || down === 0) {
          session.limits.addReason("depth", { file: place.node.file, line: place.node.line },
            `chain depth ${up} up and ${down} down`);
        }
        answer.chain = {
          up: up > 0 ? chainUp(session, place, 1, up, new Map([[keyOf(place.node), place.node]])) : [],
          down: down > 0 ? chainDown(session, walkTarget(place), 1, down, new Map([[keyOf(place.node), place.node]])) : [],
        };
      }
      break;
    }
    default:
      session.limits.addReason("other", undefined, `unknown command ${options.command}`);
      break;
  }
  answer.limits = session.limits.all;
  return finish(answer);
}import ts from "typescript";
import type { Candidate, Limit, Link, Loc, Node } from "./answer.ts";
import {
  definitionKind, enclosingNode, isFunctionLikeDeclaration, lineOf, located, nameOfDeclaration, nearestFunction,
  nodeOf, placeableKind, propertyNameText,
} from "./nodes.ts";
import type { Project, WrittenObject } from "./project.ts";

export interface CallSite {
  node: ts.CallExpression | ts.NewExpression;
  file: ts.SourceFile;
  callee: ts.Expression;
  from: Node;
  site: Loc;
  name: string;
}

export function isComputedCallee(callee: ts.Expression): boolean {
  if (!ts.isElementAccessExpression(callee)) return false;
  const key = callee.argumentExpression;
  return !(ts.isStringLiteralLike(key) || ts.isNumericLiteral(key));
}

function calleeName(callee: ts.Expression): string | undefined {
  if (ts.isIdentifier(callee)) return callee.text;
  if (ts.isPropertyAccessExpression(callee)) return callee.getText();
  if (ts.isElementAccessExpression(callee) && ts.isStringLiteralLike(callee.argumentExpression)) {
    const key = callee.argumentExpression.text;
    return ts.isPropertyAccessExpression(callee.expression) ? `${callee.expression.getText()}.${key}` : key;
  }
  return undefined;
}

export function callSitesIn(project: Project, file: ts.SourceFile): CallSite[] {
  const found: CallSite[] = [];
  const visit = (node: ts.Node): void => {
    if (ts.isCallExpression(node) || ts.isNewExpression(node)) {
        const callee = node.expression;
        if (!isComputedCallee(callee)) {
          const name = calleeName(callee);
          if (name) {
            const start = node.getStart(file);
            const end = Math.max(start, node.getEnd() - 1);
            found.push({
              node, file, callee, name,
              from: enclosingNode(project, node),
              site: { file: project.pathOf(file)!, line: lineOf(file, start), endLine: lineOf(file, end) },
            });
          }
        }
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  return found.sort((left, right) => left.node.getStart() - right.node.getStart());
}

export function computedCallsIn(file: ts.SourceFile): (ts.CallExpression | ts.NewExpression)[] {
  const found: (ts.CallExpression | ts.NewExpression)[] = [];
  const visit = (node: ts.Node): void => {
    if ((ts.isCallExpression(node) || ts.isNewExpression(node)) && isComputedCallee(node.expression)) found.push(node);
    ts.forEachChild(node, visit);
  };
  visit(file);
  return found;
}

function symbolOf(project: Project, node: ts.Node | undefined): ts.Symbol | undefined {
  if (!node) return undefined;
  const checker = project.checker;
  const symbol = checker.getSymbolAtLocation(node);
  if (!symbol) return undefined;
  return symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol;
}

function declarationSymbol(project: Project, declaration: ts.Declaration | undefined): ts.Symbol | undefined {
  if (!declaration) return undefined;
  const named = (declaration as { name?: ts.Node }).name;
  if (named) {
    const symbol = symbolOf(project, named);
    if (symbol) return symbol;
  }
  // A function expression has no name of its own; the symbol that names it is the one holding it.
  const holder = isFunctionLikeDeclaration(declaration) ? functionHolderOf(declaration) : undefined;
  if (holder) {
    const held = (holder as { name?: ts.Node }).name;
    const symbol = symbolOf(project, held ?? holder);
    if (symbol) return symbol;
  }
  return symbolOf(project, declaration);
}

function isHeldFunction(declaration: ts.Node): boolean {
  const holder = declaration.parent;
  if (!holder) return false;
  if (ts.isVariableDeclaration(holder) || ts.isPropertyDeclaration(holder) || ts.isPropertyAssignment(holder)) {
    return holder.initializer === declaration;
  }
  return false;
}

/** A written function type: a shape with no body of its own, which a wrapper hands back unchanged. */
function isFunctionType(declaration: ts.Node): boolean {
  return ts.isFunctionTypeNode(declaration) || ts.isConstructorTypeNode(declaration);
}

/**
 * A signature with no body of its own: what a wrapper call returns, not an implementation.
 * `const compute = Effect.fn("Compute")(body)` is `compute`, not the arrow the wrapper happens to
 * return — and neither is the `(…args) => A` type the wrapper is written with.
 */
function isWrapperResult(declaration: ts.Node): boolean {
  if (isFunctionType(declaration)) return true;
  if (!ts.isArrowFunction(declaration) && !ts.isFunctionExpression(declaration)) return false;
  if ((declaration as ts.FunctionExpression).name) return false;
  return !isHeldFunction(declaration);
}

function symbolDeclaration(project: Project, node: ts.Node | undefined): ts.Symbol | undefined {
  if (!node) return undefined;
  const checker = project.checker;
  const symbol = checker.getSymbolAtLocation(node);
  if (!symbol) return undefined;
  return symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol;
}

/**
 * What the name at a call site stands for, when the type checker points only at a wrapper's return value:
 * `const compute = Effect.fn("Compute")(body)` is `compute`, not the arrow the wrapper happens to return.
 */
function namedImplementation(project: Project, declaration: ts.Declaration | undefined, callee: ts.Expression): ts.Declaration | undefined {
  if (!declaration || !isWrapperResult(declaration)) return undefined;
  const symbol = symbolOf(project, callee);
  const value = symbol?.valueDeclaration ?? symbol?.declarations?.[0];
  return value && definitionKind(project, value) ? value : undefined;
}

export function resolvedDeclaration(project: Project, site: CallSite): ts.Declaration | undefined {
  const signature = project.checker.getResolvedSignature(site.node)?.declaration;
  if (signature) return namedImplementation(project, signature, site.callee) ?? signature;
  const checker = project.checker;
  const symbol = checker.getSymbolAtLocation(site.callee);
  if (!symbol) return undefined;
  const resolved = symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol;
  return resolved.valueDeclaration ?? resolved.declarations?.[0];
}

function isConcreteImplementation(declaration: ts.Declaration): boolean {
  if (isFunctionLikeDeclaration(declaration)) return Boolean((declaration as { body?: ts.Node }).body);
  if (ts.isClassDeclaration(declaration)) return true;
  if (ts.isVariableDeclaration(declaration)) return Boolean(declaration.initializer);
  return false;
}

function ownerTypeSymbol(project: Project, declaration: ts.Declaration): ts.Symbol | undefined {
  const parent = declaration.parent;
  if (!parent) return undefined;
  if (ts.isInterfaceDeclaration(parent) || ts.isClassDeclaration(parent)) return symbolOf(project, parent.name);
  if (ts.isTypeAliasDeclaration(parent)) return symbolOf(project, parent.name);
  // A shape written inline has no name of its own; its type is what another written place can share.
  if (ts.isTypeLiteralNode(parent)) return project.checker.getTypeFromTypeNode(parent).symbol;
  return undefined;
}

function memberOfClass(project: Project, classDeclaration: ts.ClassDeclaration, owner: ts.Symbol,
  memberName: string, seen: Set<ts.ClassDeclaration>): ts.Declaration | undefined {
  const checker = project.checker;
  const classType = checker.getTypeAtLocation(classDeclaration);
  for (const clause of classDeclaration.heritageClauses ?? []) {
    for (const type of clause.types) {
      const base = checker.getTypeAtLocation(type) as ts.ObjectType;
      if (base.symbol === owner) return checker.getPropertyOfType(classType, memberName)?.valueDeclaration;
      if (clause.token !== ts.SyntaxKind.ExtendsKeyword) continue;
      const baseDeclaration = base.symbol?.declarations?.find(ts.isClassDeclaration);
      if (!baseDeclaration || seen.has(baseDeclaration)) continue;
      seen.add(baseDeclaration);
      const inherited = memberOfClass(project, baseDeclaration, owner, memberName, seen);
      if (inherited) return inherited;
    }
  }
  return undefined;
}

function heldFunction(value: ts.Node): ts.Declaration | undefined {
  const holder = value.parent;
  if (!holder) return undefined;
  if (ts.isVariableDeclaration(holder) || ts.isPropertyDeclaration(holder) || ts.isPropertyAssignment(holder)) {
    return holder.initializer === value ? holder : undefined;
  }
  return undefined;
}

/** The function a written function type belongs to: a variable, a property or the enclosing arrow. */
function functionHolderOf(declaration: ts.Declaration): ts.Declaration | undefined {
  const direct = heldFunction(declaration);
  if (direct) return direct;
  let current: ts.Node | undefined = declaration;
  while (current && !isFunctionLikeDeclaration(current)) current = current.parent;
  return current ? heldFunction(current) : undefined;
}

/** The type that owns a member: an interface, a class, or the shape written inline. */
function ownsMembers(node: ts.Node | undefined): boolean {
  if (!node) return false;
  return ts.isInterfaceDeclaration(node) || ts.isClassLike(node) || ts.isTypeLiteralNode(node);
}

/** A member written as a type, with no body of its own. */
function isTypeMember(node: ts.Node): boolean {
  return ts.isFunctionTypeNode(node) || ts.isConstructorTypeNode(node) || ts.isMethodSignature(node) ||
    ts.isPropertySignature(node) || ts.isCallSignatureDeclaration(node) || ts.isIndexSignatureDeclaration(node);
}

/**
 * The written member a callee names, when the checker points at the shape rather than at a body:
 * `permission.assert(…)` on `readonly assert: (…) => T` is that interface member, not the type node.
 */
export function memberDeclaration(declaration: ts.Declaration): ts.Declaration {
  let current: ts.Node = declaration;
  for (let parent = current.parent; parent; current = parent, parent = current.parent) {
    if (ownsMembers(parent)) return current as ts.Declaration;
    if (!isTypeMember(current)) break;
  }
  return declaration;
}

/** A member written into a type, which is dispatched rather than carried: the call goes through it. */
function dispatchedThroughType(declaration: ts.Declaration): boolean {
  const parent = declaration.parent;
  return Boolean(parent && (ts.isInterfaceDeclaration(parent) || ts.isTypeLiteralNode(parent)));
}

/** The symbols a written type stands for: itself, its parts, and everything it is built on. */
function symbolsOfType(type: ts.Type | undefined): ts.Symbol[] {
  const symbols: ts.Symbol[] = [];
  const seen = new Set<ts.Type>();
  const visit = (current: ts.Type | undefined): void => {
    if (!current || seen.has(current)) return;
    seen.add(current);
    if (current.isUnionOrIntersection()) {
      for (const part of current.types) visit(part);
      return;
    }
    if (current.symbol) symbols.push(current.symbol);
    if (current.flags & ts.TypeFlags.Object) {
      for (const base of (current as ts.ObjectType).getBaseTypes() ?? []) visit(base);
    }
  };
  visit(type);
  return symbols;
}

function isCallableType(project: Project, node: ts.Node): boolean {
  return project.checker.getTypeAtLocation(node).getCallSignatures().length > 0;
}

/**
 * What a written `{ assert, ask }` names: the property that carries the member, or — for the shorthand
 * `Service.of({ get })` — the variable the shorthand refers to, which is the written implementation.
 */
function writtenPropertyDeclaration(project: Project, property: ts.ObjectLiteralElementLike): ts.Declaration | undefined {
  if (ts.isShorthandPropertyAssignment(property)) {
    const symbol = project.checker.getShorthandAssignmentValueSymbol(property);
    const value = symbol?.valueDeclaration ?? symbol?.declarations?.[0];
    return value && isCallableType(project, value) ? value : undefined;
  }
  if (ts.isPropertyAssignment(property) || ts.isMethodDeclaration(property)) {
    return isCallableType(project, property) ? property : undefined;
  }
  return undefined;
}

/** Every object literal in the program written where a service type is expected. */
function writtenObjectsOf(project: Project): WrittenObject[] {
  const checker = project.checker;
  const written: WrittenObject[] = [];
  const consider = (literal: ts.ObjectLiteralExpression, type: ts.Type | undefined): void => {
    const owners = symbolsOfType(type);
    if (owners.length) written.push({ literal, owners });
  };
  for (const file of project.files) {
    const visit = (node: ts.Node): void => {
      if (ts.isCallExpression(node) || ts.isNewExpression(node)) {
        for (const argument of node.arguments ?? []) {
          if (ts.isObjectLiteralExpression(argument)) consider(argument, checker.getContextualType(argument));
        }
      }
      else if (ts.isVariableDeclaration(node) || ts.isPropertyDeclaration(node)) {
        const initializer = node.initializer;
        if (initializer && ts.isObjectLiteralExpression(initializer) && node.type) {
          consider(initializer, checker.getTypeFromTypeNode(node.type));
        }
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return written;
}

/** Every implementation a written member has: the class members that carry it, and the written objects that do. */
export function implementationsOfMember(project: Project, owner: ts.Symbol, memberName: string): ts.Declaration[] {
  const byName = project.cache.implementationsByMember.get(owner);
  const cached = byName?.get(memberName);
  if (cached) return cached;
  const found: ts.Declaration[] = [];
  for (const file of project.files) {
    for (const statement of file.statements) {
      if (ts.isClassDeclaration(statement) && statement.name) {
        const member = memberOfClass(project, statement, owner, memberName, new Set([statement]));
        if (member && !found.some(existing => existing === member)) found.push(member);
      }
    }
  }
  const written = project.cache.writtenObjects ?? (project.cache.writtenObjects = writtenObjectsOf(project));
  for (const object of written) {
    if (!object.owners.includes(owner)) continue;
    for (const property of object.literal.properties) {
      if (propertyNameText(property.name) !== memberName) continue;
      const declaration = writtenPropertyDeclaration(project, property);
      if (declaration && !found.includes(declaration)) found.push(declaration);
    }
  }
  if (byName) byName.set(memberName, found);
  else project.cache.implementationsByMember.set(owner, new Map([[memberName, found]]));
  return found;
}

export interface ImplementationLookup {
  implementations: ts.Declaration[];
  via: "definition" | "implementation-lookup";
}

export function lookupImplementation(project: Project, declaration: ts.Declaration | undefined): ImplementationLookup {
  const lookup = (implementations: ts.Declaration[], via: "definition" | "implementation-lookup"): ImplementationLookup =>
    ({ implementations, via });
  if (!declaration) return lookup([], "definition");
  const member = memberDeclaration(declaration);
  if (member !== declaration) {
    const owner = ownerTypeSymbol(project, member);
    const memberName = nameOfDeclaration(member);
    if (owner && memberName) return lookup(implementationsOfMember(project, owner, memberName), "implementation-lookup");
  }
  if (isFunctionType(declaration)) {
    const holder = functionHolderOf(declaration);
    return lookup(holder ? [holder] : [], "definition");
  }
  if (isConcreteImplementation(declaration)) return lookup([declaration], "definition");
  const owner = ownerTypeSymbol(project, declaration);
  const memberName = nameOfDeclaration(declaration);
  if (!owner || !memberName) return lookup([], "definition");
  const parent = declaration.parent!;
  if (ts.isClassDeclaration(parent)) {
    const inherited = memberOfClass(project, parent, owner, memberName, new Set([parent]));
    return lookup(inherited ? [inherited] : [], "implementation-lookup");
  }
  if (!dispatchedThroughType(declaration)) return lookup([], "definition");
  return lookup(implementationsOfMember(project, owner, memberName), "implementation-lookup");
}

export function interfaceMembersOf(project: Project, declaration: ts.Declaration): ts.Declaration[] {
  const checker = project.checker;
  const parent = declaration.parent;
  if (!parent || !ts.isClassDeclaration(parent)) return [];
  const memberName = nameOfDeclaration(declaration);
  if (!memberName) return [];
  const found: ts.Declaration[] = [];
  const visit = (classDeclaration: ts.ClassDeclaration, seen: Set<ts.ClassDeclaration>): void => {
    if (seen.has(classDeclaration)) return;
    seen.add(classDeclaration);
    for (const clause of classDeclaration.heritageClauses ?? []) {
      for (const type of clause.types) {
        const base = checker.getTypeAtLocation(type);
        if (!(base.flags & ts.TypeFlags.Object)) continue;
        const member = checker.getPropertyOfType(base as ts.ObjectType, memberName);
        const memberDeclaration = member?.valueDeclaration;
        if (memberDeclaration && ts.isMethodSignature(memberDeclaration) && !found.includes(memberDeclaration)) {
          found.push(memberDeclaration);
        }
        const baseDeclaration = (base as ts.ObjectType).symbol?.declarations?.find(ts.isClassDeclaration);
        if (clause.token === ts.SyntaxKind.ExtendsKeyword && baseDeclaration) visit(baseDeclaration, seen);
      }
    }
  };
  visit(parent, new Set());
  return found;
}

export function isTestFile(patterns: string[], file: string): boolean {
  return patterns.some(pattern => new Bun.Glob(pattern).match(file));
}

function candidateNode(project: Project, declaration: ts.Declaration, testPatterns: string[]): Candidate | undefined {
  const path = project.pathOf(declaration);
  if (!path || !project.isSource(declaration)) return undefined;
  const written = nodeOf(project, declaration);
  const kind = definitionKind(project, declaration);
  return { ...written, ...(kind && placeableKind(kind) ? { kind } : {}), testFake: isTestFile(testPatterns, path) };
}

export interface AnalysisContext {
  testPatterns: string[];
  limits: { addReason(reason: Limit["reason"], at?: Loc, text?: string): void };
}

function dynamicReason(project: Project, site: CallSite, declaration: ts.Declaration | undefined): string | undefined {
  if (ts.isElementAccessExpression(site.callee)) return "the member called is chosen at run time";
  if (!ts.isIdentifier(site.callee)) return undefined;
  const symbol = project.checker.getSymbolAtLocation(site.callee);
  const value = symbol?.valueDeclaration;
  if (value && ts.isParameter(value)) return `${site.name} is a parameter, so the function it names is only known at run time`;
  if (value && ts.isVariableDeclaration(value) && !value.initializer) {
    return `${site.name} is assigned at run time, so the function it names is only known then`;
  }
  if (!declaration && !value) return `${site.name} has no declaration in this program`;
  return undefined;
}

export function analyzeCall(project: Project, site: CallSite, context: AnalysisContext): Link {
  const resolved = resolvedDeclaration(project, site);
  // What the checker names is the written member when the call is dispatched through a type.
  const declaration = resolved ? memberDeclaration(resolved) : undefined;
  const declaredHere = project.isSource(declaration);
  const dispatchedThroughTypeAtCall = Boolean(declaredHere && declaration && dispatchedThroughType(declaration));
  const { implementations, via } = lookupImplementation(project, resolved);
  const candidates = implementations
    .map(implementation => candidateNode(project, implementation, context.testPatterns))
    .filter((candidate): candidate is Candidate => candidate !== undefined);
  const realImplementations = candidates.filter(candidate => !candidate.testFake);
  const link: Link = {
    from: site.from,
    site: site.site,
    kind: ts.isNewExpression(site.node) ? "new" : dispatchedThroughTypeAtCall ? "service-call" : "call",
    resolution: realImplementations.length === 0 ? "unresolved"
      : realImplementations.length === 1 ? "implementation" : "ambiguous",
    candidates,
    via,
  };
  if (declaration && declaredHere) link.declaration = located(project, declaration);
  if (link.resolution === "implementation") link.to = realImplementations[0];
  if (link.resolution === "unresolved") {
    if (declaration && !declaredHere) {
      link.reason = `${site.name} is implemented outside the repository`;
      context.limits.addReason("outside-repo", site.site);
    } else if (candidates.length > 0) {
      link.reason = `the only implementations of ${site.name} are in test files`;
      context.limits.addReason("not-found", site.site);
    } else {
      const dynamic = dynamicReason(project, site, declaration);
      if (dynamic) {
        link.reason = dynamic;
        context.limits.addReason("dynamic", site.site);
      } else {
        link.reason = `no implementation of ${site.name} was found by static analysis`;
        context.limits.addReason("not-found", site.site);
      }
    }
  }
  return link;
}

export interface CallerLink {
  link: Link;
  enclosing?: ts.Node;
}

/** True when a call site reaches the given declaration: by its own name, or through the member it carries. */
function reachesDeclaration(project: Project, calleeDeclaration: ts.Declaration, target: ts.Declaration): boolean {
  if (calleeDeclaration === target) return true;
  return lookupImplementation(project, calleeDeclaration).implementations.includes(target);
}

export function findCallers(project: Project, declaration: ts.Declaration, context: AnalysisContext): CallerLink[] {
  const symbols = new Set<ts.Symbol>();
  const own = declarationSymbol(project, declaration);
  if (own) symbols.add(own);
  for (const member of interfaceMembersOf(project, declaration)) {
    const symbol = declarationSymbol(project, member);
    if (symbol) symbols.add(symbol);
  }
  const found: CallerLink[] = [];
  for (const file of project.files) {
    for (const site of callSitesIn(project, file)) {
      const calleeDeclaration = resolvedDeclaration(project, site);
      if (!calleeDeclaration) continue;
      const calleeSymbol = declarationSymbol(project, calleeDeclaration);
      const named = Boolean(calleeSymbol && symbols.has(calleeSymbol));
      if (!named && !reachesDeclaration(project, calleeDeclaration, declaration)) continue;
      found.push({ link: analyzeCall(project, site, context), enclosing: nearestFunction(site.node) });
    }
  }
  return found.sort((left, right) => left.link.site.file.localeCompare(right.link.site.file) ||
    left.link.site.line - right.link.site.line);
}import ts from "typescript";
import type { Loc, Node, NodeKind } from "./answer.ts";
import type { Project } from "./project.ts";

export interface Definition {
  node: Node;
  declaration: ts.Declaration;
  /** The function the declaration implements: its initializer, or the body a wrapper call was given. */
  implementation?: ts.Node;
}

export function lineOf(file: ts.SourceFile, position: number): number {
  return file.getLineAndCharacterOfPosition(position).line + 1;
}

export function locOf(node: ts.Node): Loc {
  const file = node.getSourceFile();
  const start = node.getStart(file);
  const end = Math.max(start, node.getEnd() - 1);
  return {
    file: file.fileName,
    line: lineOf(file, start),
    endLine: lineOf(file, end),
  };
}

export function located(project: Project, node: ts.Node): Loc {
  const { file, line, endLine } = locOf(node);
  return { file: project.pathOf(node) ?? file, line, endLine };
}

function nameText(name: ts.DeclarationName | undefined): string | undefined {
  if (!name) return undefined;
  if (ts.isIdentifier(name) || ts.isPrivateIdentifier(name)) return name.text;
  if (ts.isStringLiteralLike(name) || ts.isNumericLiteral(name)) return name.text;
  return undefined;
}

export function propertyNameText(name: ts.PropertyName | undefined): string | undefined {
  if (!name) return undefined;
  if (ts.isIdentifier(name) || ts.isPrivateIdentifier(name) || ts.isStringLiteralLike(name) || ts.isNumericLiteral(name)) {
    return name.text;
  }
  return undefined;
}

function declaringClass(node: ts.Node): ts.ClassLikeDeclaration | undefined {
  let parent: ts.Node | undefined = node.parent;
  while (parent) {
    if (ts.isClassLike(parent)) return parent;
    if (ts.isFunctionLike(parent)) return undefined;
    parent = parent.parent;
  }
  return undefined;
}

function declaringInterface(node: ts.Node): ts.InterfaceDeclaration | undefined {
  let parent: ts.Node | undefined = node.parent;
  while (parent) {
    if (ts.isInterfaceDeclaration(parent)) return parent;
    if (ts.isFunctionLike(parent)) return undefined;
    parent = parent.parent;
  }
  return undefined;
}

function memberName(node: ts.Node): string | undefined {
  if (ts.isPropertyAssignment(node) || ts.isPropertyDeclaration(node) || ts.isMethodDeclaration(node)) {
    return propertyNameText(node.name);
  }
  return undefined;
}

/**
 * The written names that lead to a declaration, outermost first: `{ get: … }` inside `const svc = {…}`
 * gives `["svc", "get"]`, a name at the top of a module gives `["svc"]`, and a name inside a function
 * body gives nothing above its own.
 */
function holderChain(node: ts.Node): string[] {
  const names: string[] = [];
  let current: ts.Node | undefined = node;
  while (current && !isFunctionLikeDeclaration(current) && !ts.isClassLike(current)) {
    const name = ts.isVariableDeclaration(current) ? nameText(current.name) : memberName(current);
    if (name) names.unshift(name);
    else if (ts.isVariableDeclaration(current)) break;
    current = current.parent;
  }
  return names;
}

const chainName = (node: ts.Node): string | undefined => {
  const names = holderChain(node);
  return names.length ? names.join(".") : undefined;
};

function isTestCall(expression: ts.Expression): boolean {
  const text = expression.getText();
  const name = ts.isPropertyAccessExpression(expression) ? expression.name.text : text;
  return name === "test" || name === "it";
}

function callTitleText(call: ts.CallExpression): string | undefined {
  if (!isTestCall(call.expression)) return undefined;
  const title = call.arguments[0];
  return title && ts.isStringLiteralLike(title) ? title.text : undefined;
}

/** `Effect.fn("Name")(body)` and its relatives: a wrapper call given a function, whose result is that shape. */
function wrapperBody(project: Project, call: ts.CallExpression): ts.Node | undefined {
  const body = call.arguments.find(argument => ts.isArrowFunction(argument) || ts.isFunctionExpression(argument));
  if (!body || !project.checker.getTypeAtLocation(call).getCallSignatures().length) return undefined;
  return body;
}

function anonymousName(project: Project, fn: ts.ArrowFunction | ts.FunctionExpression): { name: string; kind: NodeKind } {
  const kind: NodeKind = ts.isArrowFunction(fn) ? "arrow" : "function";
  const parent: ts.Node | undefined = fn.parent;
  const held = parent ? chainName(parent) : undefined;
  if (held) {
    const wrapped = ts.isCallExpression(parent!) && wrapperBody(project, parent!) === fn;
    return { name: held, kind: wrapped ? "effect-fn" : kind };
  }
  if (parent && ts.isCallExpression(parent)) {
    const title = callTitleText(parent);
    return { name: title ?? `${parent.expression.getText()} callback`, kind };
  }
  const named = ts.isFunctionExpression(fn) ? fn.name?.getText() : undefined;
  return { name: named ?? "<anonymous>", kind };
}

export function nodeOf(project: Project, node: ts.Node): Node {
  const loc = located(project, node);
  if (ts.isFunctionDeclaration(node)) {
    return { ...loc, name: nameText(node.name) ?? "<anonymous>", kind: "function" };
  }
  if (ts.isClassDeclaration(node) || ts.isClassExpression(node)) {
    return { ...loc, name: nameText(node.name) ?? "<anonymous>", kind: "class" };
  }
  if (ts.isMethodDeclaration(node) || ts.isMethodSignature(node)) {
    const owner = declaringClass(node);
    const name = nameText(node.name) ?? "<anonymous>";
    const holder = owner ? nameText(owner.name) : chainName(node.parent ?? node);
    return { ...loc, name: holder ? `${holder}.${name}` : name, kind: "method" };
  }
  if (ts.isConstructorDeclaration(node)) {
    const owner = declaringClass(node);
    return { ...loc, name: `${owner ? nameText(owner.name) ?? "<anonymous>" : "<anonymous>"}.constructor`, kind: "method" };
  }
  if (ts.isGetAccessorDeclaration(node) || ts.isSetAccessorDeclaration(node)) {
    const owner = declaringClass(node);
    const name = nameText(node.name) ?? "<anonymous>";
    return { ...loc, name: owner ? `${nameText(owner.name)}.${name}` : name, kind: "property" };
  }
  if (ts.isArrowFunction(node) || ts.isFunctionExpression(node)) {
    const { name, kind } = anonymousName(project, node);
    return { ...loc, name, kind };
  }
  if (ts.isVariableDeclaration(node) || ts.isPropertyDeclaration(node) || ts.isPropertyAssignment(node)) {
    const name = nameText(node.name as ts.BindingName | undefined) ?? propertyNameText(node.name as ts.PropertyName);
    return { ...loc, name: chainName(node) ?? name ?? "<anonymous>", kind: "variable" };
  }
  const owner = declaringInterface(node);
  const interfaceName = owner?.name.text;
  const interfaceMember = interfaceName ? nameText((node as { name?: ts.DeclarationName }).name) : undefined;
  if (interfaceName && interfaceMember) {
    return { ...loc, name: `${interfaceName}.${interfaceMember}`, kind: "interface-member" };
  }
  return { ...loc, name: "<declaration>", kind: "other" };
}

export function definitionKind(project: Project, node: ts.Node): NodeKind | undefined {
  if (ts.isFunctionDeclaration(node)) return "function";
  if (ts.isClassDeclaration(node)) return "class";
  if (ts.isMethodDeclaration(node)) return "method";
  if (ts.isMethodSignature(node)) return "interface-member";
  if (ts.isVariableDeclaration(node) || ts.isPropertyDeclaration(node) || ts.isPropertyAssignment(node)) {
    const init = node.initializer;
    if (!init) return undefined;
    if (ts.isArrowFunction(init)) return "arrow";
    if (ts.isFunctionExpression(init)) return "function";
    if (implementationBody(project, node)) return "effect-fn";
    return undefined;
  }
  return undefined;
}

/**
 * The function a declaration implements: the declaration itself, its initializer, or the body a wrapper
 * call such as `Effect.fn("Name")(body)` was given.
 */
export function implementationBody(project: Project, node: ts.Node): ts.Node | undefined {
  if (isFunctionLikeDeclaration(node)) return node;
  if (!ts.isVariableDeclaration(node) && !ts.isPropertyDeclaration(node) && !ts.isPropertyAssignment(node)) return undefined;
  const init = node.initializer;
  if (!init) return undefined;
  if (ts.isArrowFunction(init) || ts.isFunctionExpression(init)) return init;
  return ts.isCallExpression(init) ? wrapperBody(project, init) : undefined;
}

function declarationOrder(left: ts.Node, right: ts.Node): number {
  return left.getStart() - right.getStart();
}

export function definitionsIn(project: Project, file: ts.SourceFile): Definition[] {
  const found: Definition[] = [];
  const visit = (node: ts.Node): void => {
    const kind = definitionKind(project, node);
    if (kind && kind !== "interface-member") {
      found.push({
        node: { ...located(project, node), name: nodeOf(project, node).name, kind },
        declaration: node as ts.Declaration,
        implementation: implementationBody(project, node),
      });
    }
    ts.forEachChild(node, visit);
  };
  visit(file);
  return found.sort((left, right) => declarationOrder(left.declaration, right.declaration));
}

export function searchableDefinitions(project: Project): Definition[] {
  const found: Definition[] = [];
  for (const file of project.files) {
    const visit = (node: ts.Node): void => {
      const kind = definitionKind(project, node);
      if (!kind && !ts.isMethodSignature(node)) {
        ts.forEachChild(node, visit);
        return;
      }
      const written = nodeOf(project, node);
      found.push({
        node: kind ? { ...written, kind } : written,
        declaration: node as ts.Declaration,
        implementation: implementationBody(project, node),
      });
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return found.sort((left, right) => {
    const leftPath = left.node.file;
    const rightPath = right.node.file;
    if (leftPath !== rightPath) return leftPath < rightPath ? -1 : 1;
    return left.node.line - right.node.line || declarationOrder(left.declaration, right.declaration);
