diff --git a/code_map/test/a2/fixtures/effect-runtime.ts b/code_map/test/a2/fixtures/effect-runtime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f97abc5115e4ccbc59469211fde07901e4492c7
--- /dev/null
+++ b/code_map/test/a2/fixtures/effect-runtime.ts
@@ -0,0 +1,17 @@
+export type Task<A> = Generator<unknown, A, unknown>;
+
+export namespace Context {
+  export function Service<Self, Shape>() {
+    return (_key: string) => class {
+      static Service: Task<Shape>;
+      static of(implementation: Shape): Shape { return implementation; }
+    };
+  }
+}
+
+export namespace Effect {
+  export function fn(_label: string) {
+    return <Args extends unknown[], A>(body: (...args: Args) => Task<A>) => body;
+  }
+  export function gen<A>(body: () => Task<A>): Task<A> { return body(); }
+}
