+  }, 20_000);
+}
+
+for (const entry of ["launchDetourFirst", "launchShortcutFirst"]) {
+  test(`A2 service shortest callee route from ${entry} preserves its tail — Fails if: "${missingLink}"`, async () => {
+    const root = loc("service-routes", "live.ts", `const ${entry} =`);
