+
+for (const direction of ["up", "down"] as const) {
+  test(`A2 direct shortest ${direction} route preserves its tail — Fails if: "${missingLink}"`, async () => {
+    const rootName = direction === "down" ? "beginInspection" : "receiveInspection";
