export type Task<A> = Generator<unknown, A, unknown>;

export namespace Context {
  export function Service<Self, Shape>() {
    return (_key: string) => class {
      static Service: Task<Shape>;
      static of(implementation: Shape): Shape { return implementation; }
    };
  }
}

export namespace Effect {
  export function fn(_label: string) {
    return <Args extends unknown[], A>(body: (...args: Args) => Task<A>) => body;
  }
  export function* succeed<A>(value: A): Task<A> { return value; }
}
import { Context, type Task } from "../effect-runtime";

export interface Request { readonly resource: string }

export interface Interface {
  readonly assert: (input: Request) => Task<boolean>;
  readonly ask: (prompt: string) => Task<string>;
}

export class Permission extends Context.Service<Permission, Interface>()("@app/Permission") {}
import { Effect } from "../effect-runtime";
import { Permission } from "./contract";

export const approveDraft = Effect.fn("Draft.approve")(function* (resource: string) {
  const permission = yield* Permission.Service;
  const allowed = yield* permission.assert({ resource });
  yield* permission.ask("publish draft?");
  return allowed;
});

export const approveBatch = Effect.fn("Batch.approve")(function* () {
  const permission = yield* Permission.Service;
  yield* permission.assert({ resource: "draft/first" });

  // A property access need not share its receiver's source line.
  yield* permission
    .assert({ resource: "draft/second" });
});
import { Effect } from "../effect-runtime";
import { Permission, type Request } from "./contract";

// The returned object carries references, not method bodies.
export const permissionLayer = Effect.fn("Permission.layer")(function* () {
  const prefix = "draft/";

  const assert = Effect.fn("Permission.assert")(function* (input: Request) {
    return yield* Effect.succeed(input.resource.startsWith(prefix));
  });

  const ask = Effect.fn("Permission.ask")(function* (prompt: string) {
    return yield* Effect.succeed(`question: ${prompt}`);
  });

  return Permission.of({ assert, ask });
});
