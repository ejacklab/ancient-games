+
+export const remoteLayer = Effect.fn("Capacity.remote")(function* () {
+  const offset = 23;
+
+  const reserve = Effect.fn("Remote.reserve")(function* (units: number) {
+    return yield* Effect.succeed(units + offset);
+  });
+  return Capacity.of({ reserve });
+});
