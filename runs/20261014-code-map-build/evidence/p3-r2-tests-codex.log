+
+export interface Request { readonly resource: string }
+
+export interface Interface {
+  readonly assert: (input: Request) => Task<boolean>;
+  readonly ask: (prompt: string) => Task<string>;
+}
+
+export class Permission extends Context.Service<Permission, Interface>()("@app/Permission") {}
diff --git a/code_map/test/r2/fixtures/shorthand-permission/live-layer.ts b/code_map/test/r2/fixtures/shorthand-permission/live-layer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7777c44b82172b448e551318e2825a22e10225e
--- /dev/null
+++ b/code_map/test/r2/fixtures/shorthand-permission/live-layer.ts
@@ -0,0 +1,17 @@
+import { Effect } from "../effect-runtime";
+import { Permission, type Request } from "./contract";
+
+// The returned object carries references, not method bodies.
+export const permissionLayer = Effect.fn("Permission.layer")(function* () {
+  const prefix = "draft/";
+
+  const assert = Effect.fn("Permission.assert")(function* (input: Request) {
+    return yield* Effect.succeed(input.resource.startsWith(prefix));
+  });
+
+  const ask = Effect.fn("Permission.ask")(function* (prompt: string) {
+    return yield* Effect.succeed(`question: ${prompt}`);
+  });
+
+  return Permission.of({ assert, ask });
+});
