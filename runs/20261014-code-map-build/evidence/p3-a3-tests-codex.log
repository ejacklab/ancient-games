+  const item = found[0];
+  expect(item).toMatchObject({ ...at, name, throughFake });
+  expectLoc(project, item);
+  expect(item.path).toHaveLength(hops.length);
+  let previous = at;
+  for (const [index, hop] of hops.entries()) {
