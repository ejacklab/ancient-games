```ts
/** The source modules a namespace qualifier stands for: `export * as Permission from "./permission"` and its relatives. */
function namespaceModules(session: Session, qualifier: string): ts.SourceFile[] {
  const checker = session.project.checker;
  const modules = new Map<string, ts.SourceFile>();
  for (const file of session.project.files) {
    const visit = (node: ts.Node): void => {
      if (ts.isIdentifier(node) && node.text === qualifier) {
        const symbol = checker.getSymbolAtLocation(node);
        const target = symbol && (symbol.flags & ts.SymbolFlags.Alias) ? checker.getAliasedSymbol(symbol) : symbol;
        for (const declaration of target?.declarations ?? []) {
          if (ts.isSourceFile(declaration) && session.project.isSource(declaration)) modules.set(declaration.fileName, declaration);
        }
      }
      ts.forEachChild(node, visit);
    };
    visit(file);
  }
  return [...modules.values()];
}
```

Note: for identifier `Permission` in `export * as Permission`, symbol is alias flags 2097152 (Alias). getAliasedSymbol gives module symbol with declaration SourceFile permission.ts. Good. Also index.ts's own source file symbol? For namespace import, alias resolves to module.

But iterating every identifier named qualifier includes the identifier in `export * as Permission` and maybe others; fine.

Definition candidate predicate:

```ts
function namedMemberDeclaration(node: ts.Node, name: string): boolean {
  const declared = (node as {name?: ts.Node}).name;
  if (!declared || propertyNameText(declared as ts.PropertyName) !== name) return false;
  return ts.isFunctionDeclaration(node) || ts.isClassDeclaration(node) || ts.isMethodDeclaration(node) ||
    ts.isMethodSignature(node) || ts.isPropertyDeclaration(node) || ts.isPropertySignature(node) ||
    ts.isGetAccessorDeclaration(node) || ts.isSetAccessorDeclaration(node) ||
    ts.isVariableDeclaration(node) || ts.isPropertyAssignment(node);
}
```

