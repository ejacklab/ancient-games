import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { isObject, selectPath, type Expectation } from "./matcher.ts";
import { requirementLines, type Requirement } from "./requirements.ts";

export type EvalCase = { id: string; requirement: Requirement; line: string; args: string[]; expect: Expectation };
export type CaseFile = { project: string[]; root: string; tests: string[]; cases: EvalCase[] };
export type LoadedCaseFile = CaseFile & { source: string };

function stringArray(value: unknown): value is string[] {
  return Array.isArray(value) && value.every(item => typeof item === "string");
}

export function validateCaseFile(value: unknown): CaseFile {
  if (!isObject(value) || !stringArray(value.project) || !value.project.length ||
      typeof value.root !== "string" || !stringArray(value.tests) || !Array.isArray(value.cases)) {
    throw new Error("Case file needs project: string[], root: string, tests: string[], cases: array");
  }
  const ids = new Set<string>();
  for (const candidate of value.cases) {
    if (!isObject(candidate) || typeof candidate.id !== "string" || !candidate.id || ids.has(candidate.id) ||
        typeof candidate.requirement !== "string" || !(candidate.requirement in requirementLines) ||
        typeof candidate.line !== "string" || !stringArray(candidate.args) || !candidate.args.length || !isObject(candidate.expect)) {
      throw new Error("Invalid or duplicate case: " + JSON.stringify(candidate));
    }
    ids.add(candidate.id);
    const lines: readonly string[] = requirementLines[candidate.requirement as Requirement];
    if (!lines.includes(candidate.line.replace(/\.$/, ""))) throw new Error(`Unknown Fails-if line in ${candidate.id}: ${candidate.line}`);
    candidate.line = candidate.line.replace(/\.$/, "");
    const expect = candidate.expect;
    if (!Array.isArray(expect.includes) || !Array.isArray(expect.excludes) || !Array.isArray(expect.equals) ||
        ![true, false, null].includes(expect.ambiguous as boolean | null) || !stringArray(expect.limitReasons)) {
      throw new Error(`Invalid expectation in ${candidate.id}`);
    }
    for (const location of [...expect.includes, ...expect.excludes]) {
      if (!isObject(location) || typeof location.path !== "string" || typeof location.file !== "string" ||
          !Number.isInteger(location.line) || (location.line as number) < 1) throw new Error(`Invalid location in ${candidate.id}`);
      selectPath({}, location.path);
    }
    for (const equality of expect.equals) {
      if (!isObject(equality) || typeof equality.path !== "string" || !Object.hasOwn(equality, "value")) {
        throw new Error(`Invalid equality in ${candidate.id}`);
      }
      selectPath({}, equality.path);
    }
  }
  return value as CaseFile;
}

export async function loadCaseFile(path: string): Promise<LoadedCaseFile> {
  const source = resolve(path);
  const value = validateCaseFile(JSON.parse(await readFile(source, "utf8")));
  // Bundled examples remain runnable from either the repository or the package directory.
  const base = source === resolve(import.meta.dir, "cases/fixtures.json") ? resolve(import.meta.dir, "..") : process.cwd();
  return { ...value, source, root: resolve(base, value.root), project: value.project.map(project => resolve(base, project)) };
}
import { isDeepStrictEqual } from "node:util";

export type LocationExpectation = { path: string; file: string; line: number };
export type Expectation = {
  includes: LocationExpectation[];
  excludes: LocationExpectation[];
  equals: { path: string; value: unknown }[];
  ambiguous: boolean | null;
  limitReasons: string[];
};
export type Mismatch = { path: string; expected: unknown; actual: unknown; message: string };

export function isObject(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function descendants(value: unknown): unknown[] {
  if (!isObject(value) || !Array.isArray(value.children)) return [];
  return value.children.flatMap(child => [child, ...descendants(child)]);
}

/** Missing values stay absent; [] collects values, and children searches descendants. */
export function selectPath(value: unknown, path: string): unknown[] {
  let values: unknown[] = [value];
  for (const segment of path.split(".")) {
    const match = /^([A-Za-z_$][\w$]*)(\[\])?$/.exec(segment);
    if (!match) throw new Error(`Invalid expectation path: ${path}`);
    const key = match[1]!;
    const array = Boolean(match[2]);
    values = values.flatMap(parent => {
      if (key === "children") return descendants(parent);
      if (!isObject(parent) || !Object.hasOwn(parent, key)) return [];
      const child = parent[key];
      return array ? (Array.isArray(child) ? child : []) : [child];
    });
  }
  return values;
}

export function collectLimitReasons(value: unknown): string[] {
  if (Array.isArray(value)) return value.flatMap(collectLimitReasons);
  if (!isObject(value)) return [];
  const reasons: string[] = [];
  if (Array.isArray(value.limits)) {
    for (const limit of value.limits) {
      if (isObject(limit) && typeof limit.reason === "string") reasons.push(limit.reason);
    }
  }
  if (isObject(value.stop) && typeof value.stop.reason === "string") reasons.push(value.stop.reason);
  for (const [key, child] of Object.entries(value)) {
    if (key !== "limits" && key !== "stop") reasons.push(...collectLimitReasons(child));
  }
  return reasons;
}

export function matchAnswer(answer: unknown, expect: Expectation): Mismatch[] {
  const failures: Mismatch[] = [];
  for (const [rule, checks] of [["includes", expect.includes], ["excludes", expect.excludes]] as const) {
    for (const check of checks) {
      const actual = selectPath(answer, check.path);
      const found = actual.some(value => isObject(value) && value.file === check.file && value.line === check.line);
      if (found !== (rule === "includes")) failures.push({
        path: check.path, expected: { [rule]: { file: check.file, line: check.line } },
        actual, message: `${rule} location check failed`,
      });
    }
  }
  for (const check of expect.equals) {
    const selected = selectPath(answer, check.path);
    const actual = check.path.includes("[]") || check.path.split(".").includes("children") ? selected : selected[0];
    if (!isDeepStrictEqual(actual, check.value)) failures.push({
      path: check.path, expected: check.value, actual: actual === undefined ? { missing: true } : actual,
      message: "equals check failed",
    });
  }
  if (expect.ambiguous !== null) {
    const actual = isObject(answer) ? answer.ambiguous : undefined;
    if (actual !== expect.ambiguous) failures.push({ path: "ambiguous", expected: expect.ambiguous,
      actual: actual ?? { missing: true }, message: "ambiguous check failed" });
  }
  const reasons = collectLimitReasons(answer);
  for (const reason of expect.limitReasons) {
    if (!reasons.includes(reason)) failures.push({ path: "limits/stop", expected: reason, actual: reasons,
      message: "limit reason missing" });
  }
  return failures;
}
