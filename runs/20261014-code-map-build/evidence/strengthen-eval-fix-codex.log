+    "effect-inline/use.ts:4": 7, "effect-shadow/use.ts:3": 6,
+    "effect-twins/one.ts:2": 4, "effect-twins/two.ts:2": 4,
+    "route-depth/down.ts:1": 4, "route-depth/down-reversed.ts:1": 4,
