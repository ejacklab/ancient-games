export type NodeKind =
  | "function" | "method" | "arrow" | "effect-fn" | "property" | "class" | "variable" | "interface-member" | "other";

export type Loc = { file: string; line: number; endLine?: number };
export type Node = Loc & { name: string; kind: NodeKind };

export type LimitReason = "depth" | "dynamic" | "outside-repo" | "other-process" | "not-found" | "seen" | "other";
export type Limit = { at?: Loc; reason: LimitReason; text?: string; ref?: Loc };

export type Candidate = Node & { testFake: boolean };

export type Link = {
  from: Node;
  site: Loc;
  kind: "call" | "new" | "service-call";
  declaration?: Loc;
  resolution: "implementation" | "ambiguous" | "unresolved";
  to?: Node;
  candidates: Candidate[];
  via: "definition" | "implementation-lookup";
  reason?: string;
};

export type ChainStep = { level: number; link: Link; children: ChainStep[]; stop?: Limit };

export type TestCase = { file: string; line: number; name: string; path: Link[]; throughFake: boolean };
export type TestsAnswer = { label: "static-call-path"; count: number; tests: TestCase[]; undecided: TestCase[] };

export type StepKind = "call" | "if" | "else" | "loop" | "try" | "catch" | "return" | "yield*";
export type Step = { kind: StepKind; at: Loc; text: string; children?: Step[] };

export type Siblings = {
  members: string[];
  rows: { concern: string; status: "shared" | "varies" | "unclear"; cells: { member: string; text: string; at: Loc }[] }[];
};

export type ModuleMap = {
  definitions: Node[];
  links: Link[];
  entries: { fn: Node; steps: Step[] }[];
  siblings?: Siblings;
};

export type Answer = {
  command: string;
  query: string[];
  ambiguous?: boolean;
  matches?: Node[];
  links?: Link[];
  chain?: { up: ChainStep[]; down: ChainStep[] };
  tests?: TestsAnswer;
  map?: ModuleMap;
  limits: Limit[];
  empty?: "none found by static analysis";
};

export const emptyMarker = "none found by static analysis" as const;

export function isEmptyAnswer(answer: Answer): boolean {
  const collections: (Node[] | Link[] | ChainStep[] | TestCase[] | unknown[] | undefined)[] = [answer.matches, answer.links];
  if (answer.chain) collections.push(answer.chain.up, answer.chain.down);
  if (answer.tests) collections.push(answer.tests.tests, answer.tests.undecided);
  if (answer.map) collections.push(answer.map.definitions, answer.map.links, answer.map.entries);
  return collections.every(value => value === undefined || value.length === 0);
}

export function finish(answer: Answer): Answer {
  if (answer.empty === undefined && isEmptyAnswer(answer)) return { ...answer, empty: emptyMarker };
  return answer;
}

/** One limit per reason, at the first place it happened; each link keeps its own reason. */
export class LimitLog {
  private items: Limit[] = [];
  private keys = new Set<string>();

  add(limit: Limit): void {
    const key = limit.reason === "other" ? JSON.stringify(limit) : limit.reason;
    if (this.keys.has(key)) return;
    this.keys.add(key);
    this.items.push(limit);
  }

  addReason(reason: LimitReason, at?: Loc, text?: string): void {
    this.add(at ? { at, reason, ...(text ? { text } : {}) } : { reason, ...(text ? { text } : {}) });
  }

  get all(): Limit[] {
    return this.items;
  }
}import { writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import type { Answer } from "./answer.ts";
import { answerFor, type Options } from "./commands.ts";
import { renderText } from "./render.ts";

const commands = new Set(["where", "find", "callers", "callees", "chain", "tests", "map"]);

const valuedFlags = new Set(["--project", "--root", "--tests", "--siblings", "--up", "--down", "--fake-rule", "--file", "--out"]);

interface Parsed {
  options: Options;
  out?: string;
}

export function parseArguments(argv: string[]): Parsed {
  const project: string[] = [];
  const tests: string[] = [];
  const siblings: string[] = [];
  const query: string[] = [];
  let root = process.cwd();
  let json = false;
  let perFunction = false;
  let up: number | undefined;
  let down: number | undefined;
  let fakeRule: "count" | "exclude" | undefined;
  let file: string | undefined;
  let out: string | undefined;
  const command = argv[0];
  if (!command || !commands.has(command)) {
    throw new Error(`Usage: code-map <${[...commands].join("|")}> <query> --project <tsconfig.json> [--root <dir>] [--tests <glob>]... [--json]`);
  }
  for (let index = 1; index < argv.length; index++) {
    const flag = argv[index]!;
    if (flag === "--json") {
      json = true;
      continue;
    }
    if (flag === "--per-function") {
      perFunction = true;
      continue;
    }
    if (valuedFlags.has(flag)) {
      const value = argv[++index];
      if (value === undefined) throw new Error(`${flag} needs a value`);
      if (flag === "--project") project.push(value);
      else if (flag === "--tests") tests.push(value);
      else if (flag === "--siblings") siblings.push(value);
      else if (flag === "--root") root = value;
      else if (flag === "--out") out = value;
      else if (flag === "--file") file = value;
      else if (flag === "--up") up = positiveInteger(flag, value);
      else if (flag === "--down") down = positiveInteger(flag, value);
      else if (flag === "--fake-rule") {
        if (value !== "count" && value !== "exclude") throw new Error("--fake-rule needs count or exclude");
        fakeRule = value;
      }
      continue;
    }
    if (flag.startsWith("--")) throw new Error(`unknown option ${flag}`);
    query.push(flag);
  }
  if (!project.length) throw new Error("--project <tsconfig.json> is required");
  return {
    out,
    options: {
      command,
      query,
      project,
      root: resolve(root),
      tests,
      siblings,
      up,
      down,
      fakeRule,
      file,
      perFunction,
      json,
    },
  };
}

function positiveInteger(flag: string, value: string): number {
  const number = Number(value);
  if (!Number.isInteger(number) || number < 0) throw new Error(`${flag} needs a whole number of levels`);
  return number;
}

export async function run(argv: string[]): Promise<number> {
  let parsed: Parsed;
  try {
    parsed = parseArguments(argv);
  } catch (error) {
    console.error(String(error instanceof Error ? error.message : error));
    return 2;
  }
  const json = parsed.options.json;
  let answer: Answer;
  try {
    answer = answerFor(parsed.options);
  } catch (error) {
    console.error(String(error instanceof Error ? error.message : error));
    return 2;
  }
  const text = json ? JSON.stringify(answer) : renderText(answer);
  if (parsed.out) await writeFile(resolve(parsed.out), `${text}\n`);
  else console.log(text);
  return 0;
}

if (import.meta.main) process.exitCode = await run(Bun.argv.slice(2));import type { Answer, ChainStep, Limit, Link, Node, Step, TestCase } from "./answer.ts";

const place = (node: { file: string; line: number }) => `${node.file}:${node.line}`;

function nodeLine(node: Node): string {
  return `${node.name} (${node.kind}) ${place(node)}`;
}

function linkLine(link: Link): string {
  const target = link.to ? nodeLine(link.to) : `no implementation: ${link.reason ?? "unresolved"}`;
  const parts = [`${nodeLine(link.from)} ${link.kind} -> ${target}`, `at ${place(link.site)}`, link.resolution];
  if (link.declaration) parts.push(`declared at ${place(link.declaration)}`);
  if (link.via === "implementation-lookup") parts.push("via implementation lookup");
  for (const candidate of link.candidates) {
    parts.push(`candidate ${nodeLine(candidate)}${candidate.testFake ? " [test fake]" : ""}`);
  }
  return parts.join("; ");
}

function limitLine(limit: Limit): string {
  const where = limit.at ? ` at ${place(limit.at)}` : "";
  const text = limit.text ? `: ${limit.text}` : "";
  const ref = limit.ref ? ` (first shown at ${place(limit.ref)})` : "";
  return `limit ${limit.reason}${where}${ref}${text}`;
}

function chainLines(steps: ChainStep[], indent: string): string[] {
  const lines: string[] = [];
  for (const step of steps) {
    lines.push(`${indent}level ${step.level} ${linkLine(step.link)}${step.stop ? ` [stop ${limitLine(step.stop)}]` : ""}`);
    lines.push(...chainLines(step.children, `${indent}  `));
  }
  return lines;
}

function stepLines(step: Step, indent: string): string[] {
  const lines = [`${indent}${step.kind} ${place(step.at)}: ${step.text.split("\n")[0]}`];
  for (const child of step.children ?? []) lines.push(...stepLines(child, `${indent}  `));
  return lines;
}

function testLines(test: TestCase, indent: string): string[] {
  const lines = [`${indent}${test.name} (${place(test)}) through fake: ${test.throughFake}`];
  test.path.forEach((link, index) => lines.push(`${indent}  ${index + 1}. ${linkLine(link)}`));
  return lines;
}

export function renderText(answer: Answer): string {
  const lines: string[] = [`${answer.command} ${answer.query.join(" ")}`.trim()];
  if (answer.matches) {
    lines.push(answer.matches.length ? `${answer.matches.length} match(es):` : "no matches");
    for (const match of answer.matches) lines.push(`  ${nodeLine(match)}`);
    if (answer.ambiguous) lines.push("  ambiguous: more than one place matches; run chain on the one that fits and name the others");
  }
  for (const link of answer.links ?? []) lines.push(linkLine(link));
  if (answer.chain) {
    lines.push("up:");
    lines.push(...chainLines(answer.chain.up, "  "));
    lines.push("down:");
    lines.push(...chainLines(answer.chain.down, "  "));
  }
  if (answer.tests) {
    lines.push(`${answer.tests.label} (static links, not execution coverage): ${answer.tests.count} test(s)`);
    for (const test of answer.tests.tests) lines.push(...testLines(test, "  "));
    for (const test of answer.tests.undecided) lines.push(...testLines(test, "  undecided "));
  }
  if (answer.map) {
    lines.push(`definitions: ${answer.map.definitions.length}`);
    for (const definition of answer.map.definitions) lines.push(`  ${nodeLine(definition)}`);
    lines.push(`links: ${answer.map.links.length}`);
    for (const link of answer.map.links) lines.push(`  ${linkLine(link)}`);
    lines.push(`entries: ${answer.map.entries.length}`);
    for (const entry of answer.map.entries) {
      lines.push(`  ${nodeLine(entry.fn)}`);
      for (const step of entry.fn ? entry.steps : []) lines.push(...stepLines(step, "    "));
    }
    if (answer.map.siblings) {
      lines.push(`siblings: ${answer.map.siblings.members.join(", ")}`);
      for (const row of answer.map.siblings.rows) {
        lines.push(`  ${row.concern} [${row.status}]`);
        for (const cell of row.cells) lines.push(`    ${cell.member} ${place(cell.at)}: ${cell.text}`);
      }
    }
  }
  if (answer.empty) lines.push(`empty: ${answer.empty} (nothing was found by this analysis; this is not proof of absence)`);
  for (const limit of answer.limits) lines.push(limitLine(limit));
  return lines.join("\n");
}import ts from "typescript";
import { dirname, isAbsolute, relative, resolve, sep } from "node:path";

/** An object literal written where a service type is expected, and every type it stands for. */
export interface WrittenObject {
  literal: ts.ObjectLiteralExpression;
  owners: ts.Symbol[];
}

/** What one run has already worked out, so a question about the program is answered once, not once per call site. */
export interface AnalysisCache {
  readonly implementationsByMember: Map<ts.Symbol, Map<string, ts.Declaration[]>>;
  writtenObjects?: WrittenObject[];
}

export interface Project {
  readonly root: string;
  readonly program: ts.Program;
  readonly checker: ts.TypeChecker;
  readonly files: ts.SourceFile[];
  readonly cache: AnalysisCache;
  pathOf(node: ts.Node | ts.SourceFile | string): string | undefined;
  /** True when the declaration is repository source the map may claim, not a library or ambient file. */
  isSource(node: ts.Node | undefined): boolean;
  sourceOf(loc: { file: string }): ts.SourceFile | undefined;
}

function parseProjectConfig(projectPath: string): { options: ts.CompilerOptions; fileNames: string[] } {
  const absolute = resolve(projectPath);
  const config = ts.readConfigFile(absolute, ts.sys.readFile);
  if (config.error) throw new Error(ts.flattenDiagnosticMessageText(config.error.messageText, " "));
  const parsed = ts.parseJsonConfigFileContent(config.config, ts.sys, dirname(absolute), undefined, absolute);
  if (parsed.errors.length) {
    const first = parsed.errors[0]!;
    throw new Error(ts.flattenDiagnosticMessageText(first.messageText, " "));
  }
  return { options: parsed.options, fileNames: parsed.fileNames };
}

function toRelative(root: string, fileName: string): string | undefined {
  const absolute = resolve(fileName);
  const rel = relative(root, absolute);
  if (!rel || rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel)) return undefined;
  return rel.split(sep).join("/");
}

export function createProject(projectPaths: string[], root: string): Project {
  if (!projectPaths.length) throw new Error("at least one --project tsconfig.json is required");
  const parsed = projectPaths.map(parseProjectConfig);
  const options: ts.CompilerOptions = { ...parsed[0]!.options, noEmit: true };
  const fileNames = new Set<string>();
  for (const project of parsed) for (const fileName of project.fileNames) fileNames.add(fileName);
  const currentDirectory = dirname(resolve(projectPaths[0]!));

  const host: ts.LanguageServiceHost = {
    getScriptFileNames: () => [...fileNames],
    getScriptVersion: () => "1",
    getScriptSnapshot: fileName => {
      const text = ts.sys.readFile(fileName);
      return text === undefined ? undefined : ts.ScriptSnapshot.fromString(text);
    },
    getCurrentDirectory: () => currentDirectory,
    getCompilationSettings: () => options,
    getDefaultLibFileName: () => ts.getDefaultLibFilePath(options),
    fileExists: fileName => ts.sys.fileExists(fileName),
    readFile: fileName => ts.sys.readFile(fileName),
    readDirectory: (path, extensions, exclude, include, depth) =>
      ts.sys.readDirectory(path, extensions, exclude, include, depth),
    directoryExists: directory => ts.sys.directoryExists(directory),
    getDirectories: directory => ts.sys.getDirectories(directory),
  };

  const program = ts.createLanguageService(host, ts.createDocumentRegistry()).getProgram();
  if (!program) throw new Error("the TypeScript program could not be built from the given projects");

  const absoluteRoot = resolve(root);
  const pathOf = (node: ts.Node | ts.SourceFile | string): string | undefined => {
    const fileName = typeof node === "string" ? node : ts.isSourceFile(node) ? node.fileName : node.getSourceFile().fileName;
    return toRelative(absoluteRoot, fileName);
  };
  const sourceOf = (loc: { file: string }): ts.SourceFile | undefined =>
    program.getSourceFile(resolve(absoluteRoot, loc.file));

  const files = program.getSourceFiles()
    .filter(file => !file.isDeclarationFile && !file.fileName.includes("/node_modules/") && pathOf(file) !== undefined)
    .sort((left, right) => (pathOf(left)! < pathOf(right)! ? -1 : pathOf(left)! > pathOf(right)! ? 1 : 0));

  const sourceFiles = new Set(files.map(file => file.fileName));
  return {
    root: absoluteRoot,
    program,
    checker: program.getTypeChecker(),
    files,
    cache: { implementationsByMember: new Map() },
    pathOf,
    isSource: node => Boolean(node && sourceFiles.has(node.getSourceFile().fileName)),
    sourceOf,
  };
}import ts from "typescript";
import type { Loc, Step, StepKind } from "./answer.ts";
import { implementationBody, located } from "./nodes.ts";
import type { Project } from "./project.ts";

function at(project: Project, node: ts.Node): Loc {
  return located(project, node);
}

function isCatchClause(node: ts.Node): node is ts.CatchClause {
  return node.kind === ts.SyntaxKind.CatchClause;
}

function loopBodyOf(statement: ts.Statement): ts.Statement | undefined {
  if (ts.isForStatement(statement) || ts.isForOfStatement(statement) || ts.isForInStatement(statement) ||
      ts.isWhileStatement(statement) || ts.isDoStatement(statement)) {
    return (statement as ts.ForStatement).statement;
  }
  return undefined;
}

function stepKindOf(statement: ts.Statement): StepKind | undefined {
  if (ts.isIfStatement(statement)) return "if";
  if (ts.isForStatement(statement) || ts.isForOfStatement(statement) || ts.isForInStatement(statement) ||
      ts.isWhileStatement(statement) || ts.isDoStatement(statement)) return "loop";
  if (ts.isTryStatement(statement)) return "try";
  if (isCatchClause(statement)) return "catch";
  if (ts.isReturnStatement(statement)) return "return";
  if (ts.isExpressionStatement(statement)) {
    const expression = statement.expression;
    if (ts.isYieldExpression(expression)) return "yield*";
    return "call";
  }
  if (ts.isVariableStatement(statement)) return "call";
  if (ts.isBlock(statement)) return "call";
  return undefined;
}

function expressionSteps(project: Project, node: ts.Node): Step[] {
  const steps: Step[] = [];
  const visit = (child: ts.Node): void => {
    if (child !== node && (ts.isFunctionDeclaration(child) || ts.isFunctionExpression(child) || ts.isArrowFunction(child) ||
        ts.isMethodDeclaration(child) || ts.isClassDeclaration(child) || ts.isGetAccessorDeclaration(child) ||
        ts.isSetAccessorDeclaration(child))) {
      return;
    }
    if (ts.isCallExpression(child) || ts.isNewExpression(child)) {
      steps.push({ kind: "call", at: at(project, child), text: child.getText(child.getSourceFile()) });
    } else if (ts.isYieldExpression(child)) {
      steps.push({ kind: "yield*", at: at(project, child), text: child.getText(child.getSourceFile()) });
    }
    ts.forEachChild(child, visit);
  };
  ts.forEachChild(node, visit);
  return steps;
}

function statementStep(project: Project, statement: ts.Statement): Step[] {
  const kind = stepKindOf(statement);
  if (!kind) return [];
  const text = statement.getText(statement.getSourceFile());
  const location = at(project, statement);
  if (ts.isBlock(statement)) {
    return statement.statements.flatMap(child => statementStep(project, child));
  }
  if (ts.isIfStatement(statement)) {
    const children: Step[] = ts.isBlock(statement.thenStatement)
      ? statement.thenStatement.statements.flatMap(child => statementStep(project, child))
      : statementStep(project, statement.thenStatement);
    const branch = statement.elseStatement;
    if (branch) {
      const inner = ts.isBlock(branch)
        ? branch.statements.flatMap(child => statementStep(project, child))
        : statementStep(project, branch);
      children.push({ kind: "else", at: at(project, branch), text: branch.getText(branch.getSourceFile()), children: inner });
    }
    return [{ kind: "if", at: location, text, children }];
  }
  if (ts.isTryStatement(statement)) {
    const children = statement.tryBlock.statements.flatMap(child => statementStep(project, child));
    const clause = statement.catchClause;
    if (clause) {
      children.push({ kind: "catch", at: at(project, clause), text: clause.getText(clause.getSourceFile()),
        children: clause.block.statements.flatMap(child => statementStep(project, child)) });
    }
    if (statement.finallyBlock) {
      children.push(...statement.finallyBlock.statements.flatMap(child => statementStep(project, child)));
    }
    return [{ kind: "try", at: location, text, children }];
  }
  if (isCatchClause(statement)) {
    return [{ kind: "catch", at: location, text, children: statement.block.statements.flatMap(child => statementStep(project, child)) }];
