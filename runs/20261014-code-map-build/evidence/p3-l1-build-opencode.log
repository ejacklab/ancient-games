    76	    }
    77	    if (answer.map.siblings) {
    78	      lines.push(`siblings: ${answer.map.siblings.members.join(", ")}`);
    79	      for (const row of answer.map.siblings.rows) {
    80	        lines.push(`  ${row.concern} [${row.status}]`);
    81	        for (const cell of row.cells) lines.push(`    ${cell.member} ${place(cell.at)}: ${cell.text}`);
    82	      }
    83	    }
    84	  }
    85	  if (answer.empty) lines.push(`empty: ${answer.empty} (nothing was found by this analysis; this is not proof of absence)`);
