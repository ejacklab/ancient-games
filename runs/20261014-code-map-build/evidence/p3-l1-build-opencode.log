    11	  const parts = [`${nodeLine(link.from)} ${link.kind} -> ${target}`, `at ${place(link.site)}`, link.resolution];
    12	  if (link.declaration) parts.push(`declared at ${place(link.declaration)}`);
    13	  if (link.via === "implementation-lookup") parts.push("via implementation lookup");
