    86	  if (own.length === 0) return null;
    87	  const byStart = own.sort((a, b) => Date.parse(b.start) - Date.parse(a.start));
    88	  return byStart.find((d) => endOf(d) > now.getTime()) ?? byStart[0]!;
    89	}
