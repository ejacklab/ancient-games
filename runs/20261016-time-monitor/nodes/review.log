  onlyNewer.save(newer);
  expect(deadlineStatus(b.root, "s", b.env.now())).toEqual(deadlineStatus(onlyNewer.root, "s", b.env.now()));
  // At minute 11, the older long deadline is still active and the newer one is expired.
  b.at(11);
