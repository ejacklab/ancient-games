   130	export function workerLine(s: ProgressSummary): string {
   131	  const last = s.last === null ? "no line yet" : `last ${s.last.piece} ${s.last.state} ${s.ageMinutes} min ago`;
   132	  return `${s.node}: ${s.done}/${s.total} pieces, ${last}`;
   133	}
