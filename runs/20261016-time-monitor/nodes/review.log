   726	// Before the work starts, the session is asked once to write the criteria it will be scored on: not when it has already
   727	// touched a criteria file, and not again once asked (a `raised` record with id "criteria"). The prompt is never read.
   728	function handleUserPromptSubmit(payload: Record<string, unknown>, root: string, env: HookEnv): HookResult {
   729	  const session = sessionOf(payload);
   730	  const prompt: PromptRecord = { kind: "prompt", time: env.now().toISOString(), session };
   731	  appendRecord(root, prompt);
   732	  const records = readJournal(root).records.filter((record) => record.session === session);
   733	  const asked = (id: string) => records.some((record) => record.kind === "raised" && record.ids.includes(id));
   734	  const lines: string[] = [];
   735	  const ids: string[] = [];
   736	  if (!records.some((record) => record.kind === "touched" && isCriteriaFile(record.path)) && !asked("criteria")) {
   737	    ids.push("criteria");
   738	    lines.push(`harness-guard: before you start, write the criteria this request will be scored on — \`bun ${guardDirFor(root)}/src/cli.ts criteria new --out runs/<run>/criteria.yaml\` (or .harness-guard/criteria/<name>.yaml), one item per thing the result must get right; mark each met or not met with evidence at the end.`);
   739	  }
   740	  // Round 10, T6: the time is asked at the start of a task (method 3.8 item 14), once per session.
   741	  if (sessionDeadline(root, session, env.now()) === null && !asked("deadline-ask")) {
   742	    ids.push("deadline-ask");
   743	    lines.push(`harness-guard: ask the owner how much time you have to try (unless they said), then record it: \`bun ${guardDirFor(root)}/src/cli.ts deadline start --minutes N --run runs/<run>\`.`);
   744	  }
   745	  if (lines.length === 0) return quiet();
   746	  for (const id of ids) {
   747	    const record: RaisedRecord = { kind: "raised", time: env.now().toISOString(), session, ids: [id] };
   748	    appendRecord(root, record);
   749	  }
   750	  return context("UserPromptSubmit", lines.join("\n"));
   751	}
