   120	export function progressFiles(root: string, run: string | null): string[] {
   121	  if (run === null) return [];
   122	  const dir = path.join(root, run, "nodes");
   123	  try {
   124	    return fs.readdirSync(dir).filter((name) => name.endsWith(".progress.md")).sort().map((name) => path.join(dir, name));
   125	  } catch {
   126	    return [];
   127	  }
   128	}
