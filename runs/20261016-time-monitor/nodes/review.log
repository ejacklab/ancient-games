   166	// The highest mark passed and not yet announced (T5); null when none is due.
   167	export function dueMark(status: DeadlineStatus, announced: Set<string>): number | null {
   168	  const passed = status.deadline.marks.filter((mark) => status.percent >= mark || (mark === 100 && status.up));
   169	  const fresh = passed.filter((mark) => !announced.has(markId(status.deadline, mark)));
   170	  return fresh.length === 0 ? null : fresh[fresh.length - 1]!;
   171	}
   172	
   173	export function markId(deadline: Deadline, mark: number): string {
   174	  return `deadline:${deadline.id}:${mark}`;
   175	}
   176	
   177	export function deadlineEnd(deadline: Deadline): number {
   178	  return endOf(deadline);
   179	}
