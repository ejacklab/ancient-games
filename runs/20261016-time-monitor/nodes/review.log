   139	
   140	export interface DeadlineStatus {
   141	  deadline: Deadline;
   142	  usedMinutes: number;
   143	  leftMinutes: number;
   144	  percent: number;
   145	  up: boolean;
   146	  line: string;
   147	  workers: string[];
   148	}
   149	
   150	export function deadlineStatus(root: string, session: string | null, now: Date, withWorkers = true): DeadlineStatus | null {
   151	  const deadline = sessionDeadline(root, session, now);
   152	  if (deadline === null) return null;
   153	  const usedMs = now.getTime() - Date.parse(deadline.start);
   154	  const usedMinutes = Math.max(0, Math.round(usedMs / 60_000));
   155	  const percent = Math.max(0, Math.floor((usedMs / (deadline.minutes * 60_000)) * 100));
   156	  const up = now.getTime() >= endOf(deadline);
   157	  const leftMinutes = Math.max(0, Math.ceil((endOf(deadline) - now.getTime()) / 60_000));
   158	  const line = up
   159	    ? `time is up, ${Math.round((now.getTime() - endOf(deadline)) / 60_000)} min over (deadline ${clock(endOf(deadline))})`
   160	    : `used ${usedMinutes} of ${deadline.minutes} min (${percent}%), ${leftMinutes} left, deadline ${clock(endOf(deadline))}`;
   161	  // The workers' files are read only where they are shown — a mark block or status, not the every-call clock.
   162	  const workers = withWorkers ? progressFiles(root, deadline.run).map((file) => workerLine(progressSummary(file, now))) : [];
   163	  return { deadline, usedMinutes, leftMinutes, percent, up, line, workers };
   164	}
