   240	    allowed = re.sub(r"\s+", "", lst.read_text(encoding="utf-8") +
   241	                     (out / "seats" / f"{sid}-identity.md").read_text(encoding="utf-8"))
   242	    for c in sorted({int(x) for x in ITEM_CITE.findall(text)}):
   243	        if not 1 <= c <= n:
   244	            bad.append(f"{sid}: cites #{c}, but its list has items 1–{n}")
   245	    for run_ in CJK_RUN.findall(text):
