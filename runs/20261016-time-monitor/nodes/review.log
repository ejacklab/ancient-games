   754	
   755	// The call that ran `deadline start` claims its deadline; then, for the session's deadline, a passed mark is said once
   756	// and time-up after every call — added to the call's own context, never replacing it.
   757	function withTime(payload: Record<string, unknown>, root: string, env: HookEnv, result: HookResult): HookResult {
   758	  const session = sessionOf(payload);
   759	  if (payload.tool_name === "Bash" && /\bdeadline\s+start\b/.test(text(objectField(payload, "tool_input").command))) {
   760	    claimDeadlines(root, session);
   761	  }
   762	  const now = env.now();
   763	  const status = deadlineStatus(root, session, now, false);
   764	  if (status === null) return result;
   765	  let message: string | null = null;
   766	  if (status.up) {
   767	    const raisedUp = new Set(readJournal(root).records.flatMap((r) => (r.kind === "raised" && r.session === session ? r.ids : [])));
   768	    const unsaid = status.deadline.marks.map((m) => markId(status.deadline, m)).filter((id) => !raisedUp.has(id));
   769	    if (unsaid.length > 0) appendRecord(root, { kind: "raised", time: now.toISOString(), session, ids: unsaid } as RaisedRecord);
   770	    const over = Math.max(0, status.usedMinutes - status.deadline.minutes);
   771	    message = `harness-guard time is up (${over} min over): stop trying, finish the report, and put what is open to the owner.`;
   772	  } else {
   773	    // No mark passed yet: nothing can be due, so the journal is not read (the optimisation round of this run).
   774	    const passed = status.deadline.marks.some((m) => status.percent >= m);
   775	    const raised = passed ? new Set(readJournal(root).records.flatMap((r) => (r.kind === "raised" && r.session === session ? r.ids : []))) : new Set<string>();
   776	    const mark = passed ? dueMark(status, raised) : null;
   777	    if (mark !== null) {
   778	      const ids = status.deadline.marks.filter((m) => m <= mark).map((m) => markId(status.deadline, m)).filter((id) => !raised.has(id));
   779	      const record: RaisedRecord = { kind: "raised", time: now.toISOString(), session, ids };
   780	      appendRecord(root, record);
   781	      const end = new Date(Date.parse(status.deadline.start) + status.deadline.minutes * 60_000);
   782	      const hhmm = `${String(end.getHours()).padStart(2, "0")}:${String(end.getMinutes()).padStart(2, "0")}`;
   783	      const workers = deadlineStatus(root, session, now)?.workers ?? [];
   784	      message = [`harness-guard time: ${status.usedMinutes} of ${status.deadline.minutes} min used (${status.percent}%), ${status.leftMinutes} left — deadline ${hhmm}`,
   785	        ...workers.slice(0, 5).map((w) => `  ${w}`)].join("\n");
   786	    } else {
   787	      // Between marks, one short line every call: every tested design shows the budget at every step
   788	      // (runs/20261016-time-monitor/research/reminders.md F1, F3, F6; a budget given once fails, F5, F6, F8).
   789	      message = `harness-guard clock: ${status.usedMinutes}/${status.deadline.minutes} min (${status.percent}%), ${status.leftMinutes} left`;
   790	    }
   791	  }
   792	  if (message === null) return result;
   793	  let existing = "";
   794	  if (result.stdout.trim() !== "") {
   795	    try {
   796	      existing = String(JSON.parse(result.stdout).hookSpecificOutput?.additionalContext ?? "");
   797	    } catch {
   798	      return result;
   799	    }
   800	  }
   801	  const event = payload.hook_event_name === "PostToolUseFailure" ? "PostToolUseFailure" : "PostToolUse";
   802	  return context(event, existing === "" ? message : `${existing}\n${message}`);
   803	}
