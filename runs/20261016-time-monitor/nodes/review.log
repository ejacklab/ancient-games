   224	def nearest(run_: str, allowed: str) -> str:
   225	    """The closest same-length passage in the list, so a script change (趙/赵) reads differently from an invention."""
   226	    best, at = len(run_) + 1, -1
   227	    for i in range(len(allowed) - len(run_) + 1):
   228	        d = sum(a != b for a, b in zip(run_, allowed[i:i + len(run_)]))
   229	        if d < best:
   230	            best, at = d, i
   231	    if at < 0 or best > len(run_) // 3:
