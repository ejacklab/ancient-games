    93	export function progressSummary(file: string, now: Date): ProgressSummary {
    94	  const node = path.basename(file).replace(/\.progress\.md$/, "");
    95	  let text = "";
    96	  try {
    97	    text = fs.readFileSync(file, "utf8");
    98	  } catch {
    99	    return { node, done: 0, total: 0, last: null, ageMinutes: null, badLines: 0 };
   100	  }
   101	  const pieces = new Map<string, string>();
   102	  let last: ProgressSummary["last"] = null;
   103	  let badLines = 0;
   104	  for (const raw of text.split("\n")) {
   105	    const line = raw.trim();
   106	    if (line === "") continue;
   107	    const match = LINE.exec(line);
   108	    if (match === null || !Number.isFinite(Date.parse(match[1]!))) {
   109	      badLines++;
   110	      continue;
   111	    }
   112	    pieces.set(match[2]!, match[3]!);
   113	    last = { time: match[1]!, piece: match[2]!, state: match[3]! };
   114	  }
   115	  const done = [...pieces.values()].filter((state) => state === "done").length;
   116	  const ageMinutes = last === null ? null : Math.max(0, Math.round((now.getTime() - Date.parse(last.time)) / 60_000));
   117	  return { node, done, total: pieces.size, last, ageMinutes, badLines };
   118	}
