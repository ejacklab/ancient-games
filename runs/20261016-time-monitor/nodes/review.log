     1	#!/usr/bin/env python3
     2	"""four_experts.py — ask four experts and Dave (the control) one question, each on its own engine.
     3	
     4	    run   "<question>" [--question-file F] [--out DIR] [--needs-web] [--needs-shell] [--timeout S] [--only IDS]
     5	          [--claude-by-caller]   inside Claude Code: do not start `claude -p`; list Dave (and any 范蠡 fallback)
     6	                                 for the caller's subagents
     7	    check DIR [--sabotage]
     8	
     9	Experts and engines (EJ, 2026-10-13):
    10	    Linus Torvalds  codex  gpt-6.1-sol (read-only)
    11	    范蠡            agy    gemini-3.8-flash-medium — falls back to Claude Opus 5.5 when the task needs web or shell
    12	                           (agy headless cannot), or when agy returns nothing, an error, a timeout, or an answer
    13	                           without the required sections (e.g. a plan instead of the answer)
    14	    孫子            dsh    deepseek-flash (dsh headless)
    15	    老子            opencode  minimax-coding-plan/MiniMax-M3.1-Flash-Preview (plan mode)
    16	    Dave            claude Opus 5.5 — the control (EJ, 2026-10-13): experiments, data, nature-inspired solutions;
    17	                    his rules are EJ's, in assets/seats/. EJ chose a persona control over a plain no-persona answer.
    18	
    19	Each expert gets its own list from the four-seats run (copied into DIR/seats/, because opencode cannot read files
    20	outside the project) and a brief that makes it decide through its numbered rules. Prompts go in files; every engine
    21	call reads stdin from /dev/null. `check` verifies each expert cited only item numbers its list has and quoted Chinese
    22	only as its list writes it; `--sabotage` proves the check fails on an invented quote and a non-existent item.
    23	"""
    24	from __future__ import annotations
    25	
    26	import argparse
    27	import datetime as dt
    28	import json
    29	import os
    30	import re
    31	import shutil
    32	import subprocess
    33	import sys
    34	import time
    35	from pathlib import Path
    36	
    37	HERE = Path(__file__).resolve().parent.parent
    38	REPO = HERE.parent.parent.parent  # the skill lives in <repo>/.claude/skills/four-experts
    39	SEATS_ROOT = Path(os.environ.get("FOUR_EXPERTS_SEATS", REPO / "runs" / "20261013-four-seats")).expanduser()
    40	EXPERTS = [  # id, name, engine
    41	    ("linus", "Linus Torvalds", "codex"),
    42	    ("fan-li", "范蠡 (Fan Li)", "agy"),
    43	    ("sun-tzu", "孫子 (Sun Tzu)", "dsh"),
    44	    ("lao-tzu", "老子 (Laozi)", "opencode"),
    45	    ("dave", "Dave", "claude"),  # the control seat, EJ 2026-10-13: experiments, data, nature-inspired; rules in assets/seats
    46	]
    47	MODELS = {"codex": "gpt-6.1-sol", "agy": "gemini-3.8-flash-medium", "dsh": "deepseek-flash (dsh headless profile)",
    48	          "opencode": "minimax-coding-plan/MiniMax-M3.1-Flash-Preview", "claude": "claude-opus-5-5"}
    49	SECTIONS = ["## Answer", "## How I decided", "## What I need to know", "## Costs and risks",
    50	            "## How we would know I was right"]
    51	ITEM_START = re.compile(r"^(?:### (\d{1,2})\. |(\d{1,2})\. \*\*)", re.M)
    52	CJK_RUN = re.compile(r"[㐀-鿿]{4,}")
    53	ITEM_CITE = re.compile(r"(?<![\w#])#(\d{1,3})\b")
    54	
    55	
    56	def final_list(text: str) -> str:
    57	    m = re.search(r"^## Final list\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    58	    return m.group(1) if m else ""
    59	
    60	
    61	def n_items(list_file: Path) -> int:
    62	    nums = [int(a or b) for a, b in ITEM_START.findall(final_list(list_file.read_text(encoding="utf-8")))]
    63	    return max(nums) if nums else 0
    64	
    65	
    66	def seat_files(sid: str) -> tuple[Path, Path]:
    67	    if sid == "dave":
    68	        return HERE / "assets" / "seats" / "dave-list.md", HERE / "assets" / "seats" / "dave-identity.md"
    69	    return SEATS_ROOT / "final-opus" / f"{sid}.md", SEATS_ROOT / "identity" / f"{sid}.md"
    70	
    71	
    72	def slug(q: str) -> str:
    73	    words = re.findall(r"[a-z0-9]+", q.lower())[:5]
    74	    return "-".join(words) or "question"
    75	
    76	
    77	def command(engine: str, prompt: str, out_file: Path, timeout: int, web: bool, shell: bool) -> list[str]:
    78	    if engine == "codex":
    79	        return ["codex", "-m", MODELS["codex"], *(["--search"] if web else []), "exec", "-s", "read-only",
    80	                "--skip-git-repo-check", "-o", str(out_file), prompt]
    81	    if engine == "agy":
    82	        return ["agy", "-p", prompt, "--mode", "plan", "--model", MODELS["agy"], "--print-timeout",
    83	                f"{timeout - 60}s", "--output-format", "text"]
    84	    if engine == "dsh":
    85	        return ["dsh", "headless", prompt]
    86	    if engine == "opencode":
    87	        return ["opencode", "run", "-m", MODELS["opencode"], "--agent", "plan", prompt]
    88	    if engine == "claude":
    89	        tools = ["Read", "Grep", "Glob"] + (["WebSearch", "WebFetch"] if web else []) + (["Bash"] if shell else [])
    90	        # `--allowedTools` takes several values, so the bare form swallows the prompt that follows it (run
    91	        # 20261016-time-monitor: Dave got "Input must be provided"); `=` keeps the prompt an argument.
    92	        return ["claude", "-p", "--model", MODELS["claude"], "--output-format", "text",
    93	                f"--allowedTools={','.join(tools)}", prompt]
    94	    raise ValueError(engine)
    95	
    96	
    97	def start(engine: str, prompt: str, ans: Path, log: Path, timeout: int, web: bool, shell: bool, cwd: Path):
    98	    env = dict(os.environ)
    99	    if engine == "claude":
   100	        env.pop("ANTHROPIC_API_KEY", None)  # use the subscription login, not an API key
   101	    cmd = ["timeout", str(timeout), *command(engine, prompt, ans, timeout, web, shell)]
   102	    out = open(log if engine == "codex" else ans, "w")
   103	    err = open(log, "a" if engine == "codex" else "w")
   104	    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=err, cwd=cwd, env=env)
   105	    return p, time.time()
   106	
   107	
   108	def answer_ok(ans: Path) -> tuple[bool, str]:
   109	    text = ans.read_text(encoding="utf-8", errors="ignore") if ans.exists() else ""
   110	    if not text.strip():
   111	        return False, "empty answer"
   112	    missing = [s for s in SECTIONS if s not in text]
   113	    return (False, f"missing sections {missing}") if missing else (True, "")
   114	
   115	
   116	def progress(a, piece: str, state: str, note: str) -> None:
   117	    """One timestamped line per expert start and end (workflow-design method 3.8 item 14; guard Round 10 T4)."""
   118	    if not a.progress:
   119	        return
   120	    line = f"- {dt.datetime.now().astimezone().isoformat(timespec='seconds')} · {piece} · {state} · {note}\n"
   121	    with open(a.progress, "a", encoding="utf-8") as f:
   122	        f.write(line)
   123	
   124	
   125	def run(a) -> int:
   126	    question = Path(a.question_file).read_text(encoding="utf-8") if a.question_file else a.question
   127	    if not question or not question.strip():
   128	        sys.exit("no question given")
   129	    cwd = Path.cwd()
   130	    out = Path(a.out) if a.out else (cwd / ("runs" if (cwd / "runs").is_dir() else "four-experts")
   131	                                     / f"{dt.date.today():%Y%m%d}-four-experts-{slug(question)}")
   132	    out = out.resolve()
   133	    if not str(out).startswith(str(cwd.resolve())):
   134	        print(f"warning: {out} is outside {cwd}; opencode cannot read it", file=sys.stderr)
   135	    for d in ("seats", "briefs", "answers", "logs"):
   136	        (out / d).mkdir(parents=True, exist_ok=True)
   137	    (out / "question.md").write_text(question.strip() + "\n", encoding="utf-8")
   138	    brief_t = (HERE / "assets" / "brief.md").read_text(encoding="utf-8")
   139	    only = set(a.only.split(",")) if a.only else None
   140	    jobs = {}
   141	    for sid, name, engine in EXPERTS:
   142	        lst, ident = out / "seats" / f"{sid}-list.md", out / "seats" / f"{sid}-identity.md"
   143	        if only and sid not in only:
   144	            continue
   145	        src_list, src_ident = seat_files(sid)
   146	        shutil.copyfile(src_list, lst)
   147	        shutil.copyfile(src_ident, ident)
   148	        brief = out / "briefs" / f"{sid}.md"
   149	        brief.write_text(brief_t.format(name=name, list_path=lst, identity_path=ident, n_items=n_items(lst),
   150	                                        question=question.strip()), encoding="utf-8")
   151	        jobs[sid] = {"expert": name, "engine": engine, "brief": brief}
   152	    if (a.needs_web or a.needs_shell) and "fan-li" in jobs:
   153	        jobs["fan-li"].update(engine="claude", fallback_from="agy",
   154	                              fallback_reason="task needs " + " and ".join(
   155	                                  x for x, f in (("web", a.needs_web), ("shell", a.needs_shell)) if f))
   156	    old = out / "status.json"
   157	    status = json.loads(old.read_text(encoding="utf-8")) if only and old.exists() else {}
   158	
   159	    def prompt_for(sid, engine):
   160	        p = f"Read {jobs[sid]['brief']} and do what it says."
   161	        if engine == "agy":
   162	            p += " Do not run shell commands and do not fetch URLs. Write the answer itself as your final message, not a plan."
   163	        return p
   164	
   165	    def hand_to_caller(sid):
   166	        status[sid] = {"expert": jobs[sid]["expert"], "engine": "claude-subagent (caller)", "model": "caller's choice",
   167	                       "ok": None, "problem": "to run by the caller",
   168	                       "brief": str(jobs[sid]["brief"]), "answer": str(out / "answers" / f"{sid}.md"),
   169	                       **({k: jobs[sid][k] for k in ("fallback_from", "fallback_reason") if k in jobs[sid]})}
   170	        print(f"CALLER  {sid:8} run a Claude subagent: 'Read {jobs[sid]['brief']} and do what it says.' "
   171	              f"and save its final message to {out / 'answers' / (sid + '.md')}", flush=True)
   172	
   173	    procs = {}
   174	    for sid, j in jobs.items():
   175	        if j["engine"] == "claude" and a.claude_by_caller:
   176	            hand_to_caller(sid)
   177	            continue
   178	        ans, log = out / "answers" / f"{sid}.md", out / "logs" / f"{sid}.log"
   179	        procs[sid] = (*start(j["engine"], prompt_for(sid, j["engine"]), ans, log, a.timeout, a.needs_web,
   180	                             a.needs_shell, cwd), ans, log)
   181	        j["started"] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
   182	        progress(a, sid, "start", j["engine"])
   183	        print(f"started {sid:8} on {j['engine']}", flush=True)
   184	    while procs:
   185	        for sid, (p, t0, ans, log) in list(procs.items()):
   186	            if p.poll() is None:
   187	                continue
   188	            del procs[sid]
   189	            j = jobs[sid]
   190	            ok, why = answer_ok(ans)
   191	            if p.returncode == 124:
   192	                ok, why = False, f"timeout after {a.timeout} s"
   193	            elif p.returncode != 0 and ok:
   194	                ok, why = False, f"exit {p.returncode}"
   195	            progress(a, sid, "done" if ok else "fail", f"{j['engine']} exit {p.returncode}")
   196	            status[sid] = {"expert": j["expert"], "engine": j["engine"], "model": MODELS[j["engine"]],
   197	                           "started": j.get("started"),
   198	                           "finished": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
   199	                           "exit": p.returncode, "seconds": round(time.time() - t0, 1), "ok": ok, "problem": why,
   200	                           **({"fallback_from": j["fallback_from"], "fallback_reason": j["fallback_reason"]}
