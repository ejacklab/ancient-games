import yaml
d=yaml.safe_load(open('docs/memory-system/SOURCE_OF_TRUTH_REQUIREMENTS.yaml'))
recs=[]
for cat in d['categories']:
    for g in cat['groups']:
        for r in g['requirements']:
            recs.append(r)
print('total records', len(recs))
from collections import Counter
c=Counter()
for r in recs:
    for ch in [x.strip() for x in str(r['check']).split(';')]:
        c[ch]+=1
print(c)
tool=[r['id'] for r in recs if 'tool' in str(r['check'])]
git=[r['id'] for r in recs if 'git' in str(r['check'])]
rev=[r['id'] for r in recs if 'reviewer' in str(r['check'])]
none=[r['id'] for r in recs if 'none'==str(r['check']).strip()]
print('tool', len(tool), tool)
print('git', len(git), git)
print('reviewer-involved', len(rev))
print('none', len(none), none)
both=[r['id'] for r in recs if 'reviewer' in str(r['check']) and ('tool' in str(r['check']) or 'git' in str(r['check']))]
print('reviewer AND tool/git (C1 vs U4 conflict)', len(both), both)
print('tool-or-git', len(set(tool)|set(git)))
print('reviewer-only', len([r for r in recs if 'reviewer' in str(r['check']) and 'tool' not in str(r['check']) and 'git' not in str(r['check'])]))
