    40	  if (/^(empty id|duplicate id)/.test(problem)) return "W1.1b";
    41	  if (/^(no header|header is not closed)/.test(problem)) return "W1.2a";
    42	  if (/^(no \*\*Why:\*\* line|empty claim)/.test(problem)) return "W1.3a";
