+/** Every scanned file with the lines the scan covered, so a pass carries file and line evidence (C2). */
+function lineRangesOf(files: readonly string[]): string {
+  if (files.length === 0) return "them (none present)";
+  return files.map((file) => {
+    try {
+      const count = readFileSync(file, "utf8").split("\n").length;
+      return `${file}:1-${count}`;
