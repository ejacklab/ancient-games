    50	    });
    51	  }
    52	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null, notes: [`scanned: ${scanned.join(", ") || "nothing"}`] };
    53	  return {
    54	    breaks: [],
    55	    clean:
    56	      `${scanned.length} session-start file(s) scanned (${scanned.join(", ") || "none present"}): ` +
    57	      "no line opens a file under project-memory/.cache/. A hook outside the repository is not visible here.",
    58	    couldNotRun: null,
    59	  };
