    88	export function runChecks(options: CheckOptions): CheckRun {
    89	  const { root, home, since, guidelines } = options;
    90	  const snapshot = snapshotInfo(root, since);
    91	  const locations = findLocations(root, home);
    92	  const projectMemory = hasProjectMemory(root);
    93	  const cachePresent = locations.some((one) => one.name === "project-memory/.cache/" && one.present);
    94	  const staged = projectMemory ? stagedEntries(root) : [];
    95	  const indexTool = runMemoryIndex(root);
    96	  const notes: string[] = [];
    97	
    98	  const renames = checkRenames(snapshot);
    99	  const prefixes = checkEntryPrefixes(staged);
   100	  const onePerFile = checkOneEntryPerFile(staged);
   101	  const k41 = checkK41(staged, snapshot);
   102	  const k43 = checkK43(staged, snapshot);
   103	  for (const outcome of [renames.prefixes, renames.ids, prefixes, onePerFile, k41, k43]) {
   104	    for (const note of outcome.notes ?? []) notes.push(note);
   105	  }
   106	
   107	  const results: RequirementResult[] = [];
   108	
   109	  // --- the tool's own requirements (F1-F3) -------------------------------------------------------------------------
   110	
   111	  const missingAgentsMd = agentsMdMissing(root);
   112	  results.push({
   113	    id: "F1",
   114	    level: "MUST",
   115	    verdict: missingAgentsMd ? "fail" : "pass",
   116	    evidence: missingAgentsMd
   117	      ? `${root}/AGENTS.md does not exist: AGENTS.md is required (F1)`
   118	      : `${root}/AGENTS.md exists; ${locations.filter((one) => one.present).length} of ${locations.length} named locations present, ${locations.filter((one) => !one.present).length} absent`,
   119	    failsIf:
   120	      "a named location exists and is not found, one is reported that does not exist, or a missing AGENTS.md is not a failure",
   121	  });
   122	  results.push({
   123	    id: "F2",
   124	    level: "MUST",
   125	    verdict: "pass",
   126	    evidence: `project ${root} is the root of a git repository (git rev-parse --show-toplevel in it)`,
   127	    failsIf: "a given path is ignored, or a path that is not a git root is checked instead of being a usage error",
   128	  });
   129	  results.push({
   130	    id: "F3",
   131	    level: "MUST",
   132	    verdict: "pass",
   133	    evidence:
   134	      `this run created, changed and deleted nothing; it wrote ${options.out ? `only ${options.out}` : "nothing"}; ` +
   135	      "every git call ran with GIT_OPTIONAL_LOCKS=0",
   136	    failsIf: "a run changes, creates or deletes any file, ignored files included, other than the report",
   137	  });
   138	
   139	  // --- the records of SOURCE_OF_TRUTH_REQUIREMENTS.yaml -----------------------------------------------------------
   140	
   141	  const context: SotContext = { projectMemory, indexTool, prefixes, onePerFile, k41, k43, renames };
   142	  for (const record of guidelines.sot) {
   143	    results.push(sotResult(record, context));
   144	  }
   145	
   146	  // --- the Core requirements of CACHES.md --------------------------------------------------------------------------
   147	
   148	  for (const record of guidelines.caches) {
   149	    results.push(cachesResult(record.id, record.failsIf, cachePresent, root));
   150	  }
   151	
   152	  return {
   153	    root,
   154	    snapshot,
   155	    locations,
   156	    results,
   157	    indexTool,
   158	    notes,
   159	    guidelines,
   160	    exitCode: exitCodeOf(results),
   161	  };
   162	}
   163	
   164	/** R3: 0 when no MUST fails or could not run, 1 when one does. CACHES.md gives its requirements no level, so they
   165	 *  cannot gate the exit code; the report says so. */
   166	function exitCodeOf(results: readonly RequirementResult[]): number {
   167	  return results.some(
   168	    (result) => result.level === "MUST" && (result.verdict === "fail" || result.verdict === "could not run"),
   169	  )
   170	    ? 1
   171	    : 0;
   172	}
   173	
   174	interface SotContext {
   175	  readonly projectMemory: boolean;
   176	  readonly indexTool: IndexToolRun;
   177	  readonly prefixes: ClauseOutcome;
   178	  readonly onePerFile: ClauseOutcome;
   179	  readonly k41: ClauseOutcome;
   180	  readonly k43: ClauseOutcome;
   181	  readonly renames: { prefixes: ClauseOutcome; ids: ClauseOutcome };
   182	}
   183	
   184	function sotResult(record: SotRecord, context: SotContext): RequirementResult {
   185	  const level: Level = record.level;
   186	  const base = { id: `SoT:${record.id}`, level, failsIf: record.failsIf };
   187	  if (!context.projectMemory && !OUTSIDE_PROJECT_MEMORY.has(record.id)) {
   188	    return {
   189	      ...base,
   190	      verdict: "not applicable",
   191	      evidence: "project-memory/ is absent (F1 reports it absent), so the memory this record is about is absent (C4)",
   192	    };
   193	  }
   194	  if (level === "guidance") {
   195	    return { ...base, verdict: "not applicable", evidence: "guidance: nothing to check (check: none)" };
   196	  }
   197	  return decidedByTool(record, context) ?? {
   198	    ...base,
   199	    verdict: "needs a reviewer",
   200	    evidence: REVIEWER_REASON[record.id] ?? DEFAULT_REVIEWER_REASON,
   201	  };
   202	}
   203	
   204	/** The clauses the tool decides for a record, or null when it decides none of them. */
   205	function decidedByTool(record: SotRecord, context: SotContext): RequirementResult | null {
   206	  const base = { id: `SoT:${record.id}`, level: record.level as Level, failsIf: record.failsIf };
   207	  const run = context.indexTool;
   208	  const toolEvidence = `${run.command} → exit ${run.code}${outputOf(run)}`;
   209	
   210	  if (record.checks.includes("tool")) {
   211	    if (toolFailedToStart(run)) {
   212	      return { ...base, verdict: "could not run", evidence: `${run.command} could not be run: ${run.stderr.join(" ")}` };
   213	    }
   214	    // Rd3.1a's limit is checked by memory_index.py after it compared the index; when it stopped earlier that clause
   215	    // did not run. Its own size line is reported, not judged here a second way (C3).
   216	    if (record.id === "Rd3.1a" && run.mismatch && !run.overLimit && overLimitSize(run.sizeLine)) {
   217	      return {
   218	        ...base,
   219	        verdict: "could not run",
   220	        evidence:
   221	          `${toolEvidence} — memory_index.py printed ${run.sizeLine} and then stopped at the K6 index comparison, ` +
   222	          "before its limit check; nothing is judged here a second way (C3)",
   223	      };
   224	    }
   225	    const findings = run.findings.get(record.id) ?? [];
   226	    const mine = myClauseOf(record, context);
   227	    const breaks = [...findings, ...(mine?.breaks ?? [])];
   228	    if (breaks.length > 0) return { ...base, verdict: "fail", evidence: `${toolEvidence}; ${breaks.join("; ")}` };
   229	    if (mine?.couldNotRun) return { ...base, verdict: "could not run", evidence: `${toolEvidence}; ${mine.couldNotRun}` };
   230	    if (record.checks.includes("reviewer")) {
   231	      return {
   232	        ...base,
   233	        verdict: "needs a reviewer",
   234	        evidence: `${toolEvidence}; the tool found no break in the clause it checks — ${DEFAULT_REVIEWER_REASON}`,
   235	      };
   236	    }
   237	    return { ...base, verdict: "pass", evidence: `${toolEvidence}${mine ? `; ${mine.clean}` : ""}` };
   238	  }
   239	
   240	  switch (record.id) {
   241	    case "K4.1":
   242	      return fromOutcome(base, context.k41);
   243	    case "K4.3":
   244	      return fromOutcome(base, context.k43);
   245	    case "W6.1a":
   246	      if (context.onePerFile.breaks.length > 0) {
   247	        return { ...base, verdict: "fail", evidence: context.onePerFile.breaks.join("; ") };
   248	      }
   249	      if (context.onePerFile.couldNotRun) {
   250	        return { ...base, verdict: "could not run", evidence: context.onePerFile.couldNotRun };
   251	      }
   252	      return {
   253	        ...base,
   254	        verdict: "needs a reviewer",
   255	        evidence:
   256	          `${context.onePerFile.clean}; whether a commit adds an entry to an existing file is judged with the ` +
   257	          "project owner (C2: checked by the tool and by a reviewer)",
   258	      };
   259	    default:
   260	      return null;
   261	  }
   262	}
   263	
   264	/** The clause this tool judges itself for a record the tool also runs, or undefined when it judges none. */
   265	function myClauseOf(record: SotRecord, context: SotContext): ClauseOutcome | undefined {
   266	  switch (record.id) {
   267	    case "W1.1a":
   268	      return {
   269	        breaks: [...context.prefixes.breaks, ...context.renames.prefixes.breaks],
   270	        clean: `${context.prefixes.clean}; ${context.renames.prefixes.clean}`,
   271	        couldNotRun: context.renames.prefixes.couldNotRun,
   272	        notes: context.renames.prefixes.notes,
   273	      };
   274	    case "W1.1b":
   275	      return context.renames.ids;
   276	    case "K4.1":
   277	      return context.k41;
   278	    case "K4.3":
   279	      return context.k43;
   280	    case "W6.1a":
   281	      return context.onePerFile;
   282	    default:
   283	      return undefined;
   284	  }
   285	}
   286	
   287	function outputOf(run: IndexToolRun): string {
   288	  const all = [...run.stdout, ...run.stderr];
   289	  if (all.length === 0) return ", no output";
   290	  const shown = all.slice(0, 4).join(" | ");
   291	  const more = all.length > 4 ? ` … (${all.length - 4} more line(s) under Notes)` : "";
   292	  return `, output: ${shown}${more}`;
   293	}
   294	
   295	/** The size line's own numbers, against the limits memory_index.py prints them with. */
   296	function overLimitSize(sizeLine: string | null): boolean {
   297	  if (sizeLine === null) return false;
   298	  const match = /^INDEX\.md: (\d+)\/(\d+) lines, (\d+)\/(\d+) bytes$/.exec(sizeLine);
   299	  if (!match) return false;
   300	  return Number(match[1]) > Number(match[2]) || Number(match[3]) > Number(match[4]);
   301	}
   302	
   303	/** The clause of a CACHES requirement a result stands for, named in its evidence. */
   304	function named(base: { id: string; level: string; failsIf: string }, clause: string, result: RequirementResult): RequirementResult {
   305	  return { ...result, evidence: `clause ${clause}: ${result.evidence}` };
   306	}
   307	
   308	function fromOutcome(
   309	  base: { id: string; level: string; failsIf: string },
   310	  outcome: ClauseOutcome,
   311	): RequirementResult {
   312	  if (outcome.breaks.length > 0) {
   313	    return { ...base, verdict: "fail", evidence: outcome.breaks.join("; ") };
   314	  }
   315	  if (outcome.couldNotRun) return { ...base, verdict: "could not run", evidence: outcome.couldNotRun };
   316	  return { ...base, verdict: "pass", evidence: outcome.clean };
   317	}
   318	
   319	function cachesResult(id: string, failsIf: string, cachePresent: boolean, root: string): RequirementResult {
   320	  const base = { id: `CACHES:${id}`, level: "not stated in CACHES.md", failsIf };
   321	  // C6, v1: of the Core requirements only B2 (its clause B2.2) and Rd1 (its clause Rd1.1) are checked.
   322	  if (id === "B2") return named(base, "B2.2", fromOutcome(base, checkB22(root)));
   323	  if (id === "Rd1") return named(base, "Rd1.1", fromOutcome(base, checkRd1(root)));
   324	  if (!cachePresent) {
   325	    return {
   326	      ...base,
   327	      verdict: "not applicable",
   328	      evidence: "project-memory/.cache/ is absent (F1 reports it absent), so the cache requirements are not applicable (C4, C6)",
   329	    };
   330	  }
   331	  return {
   332	    ...base,
   333	    verdict: "needs a reviewer",
   334	    evidence:
   335	      "CACHES.md gives this requirement no level and no check field, and its check is the runtime behaviour of a " +
   336	      "cache tool; only B2.2 and Rd1 are checked in this version (C6, design-decisions.md 7)",
   337	  };
   338	}=========== gitrequirements.ts
     1	// The clauses the tool judges itself, from the staged snapshot or from git history: the entry-name prefix W1.1a
     2	// does not reach, one file per entry (W6.1a), an entry file is never deleted and says what replaced it (K4.1),
     3	// an entry's claim, `source`, `depends_on` and `covers` never change silently (K4.3), and the git half of W1.1a
     4	// and W1.1b (an entry file renamed to another prefix or another id). Every break carries its file and line, or the
     5	// command and its output (C2).
     6	import { nameParts, parseEntry, type Entry } from "./entry.ts";
     7	import { catFileBatch, entryDeletions, entryRenames, firstVersionOf, type SnapshotInfo, type StagedEntry } from "./gitchecks.ts";
     8	
     9	export interface ClauseOutcome {
    10	  /** One evidence line per break found. Empty when nothing broke. */
    11	  readonly breaks: readonly string[];
    12	  /** The evidence that says what was checked, when nothing broke. */
    13	  readonly clean: string;
    14	  /** Set when the check could not run: the reason. */
    15	  readonly couldNotRun: string | null;
    16	  /** Things a reader should know that are not breaks (a name not in the W1.1c form, for instance). */
    17	  readonly notes?: readonly string[];
    18	}
    19	
    20	const SHALLOW = "this is a shallow clone, so the history this clause needs is not here (C5)";
    21	
    22	function short(sha: string): string {
    23	  return sha.slice(0, 7);
    24	}
    25	
    26	function truncate(text: string, limit = 90): string {
    27	  const one = text.replace(/\s+/g, " ").trim();
    28	  return one.length <= limit ? one : `${one.slice(0, limit - 1)}…`;
    29	}
    30	
    31	function parsed(staged: readonly StagedEntry[]): { staged: StagedEntry; entry: Entry }[] {
    32	  return staged
    33	    .map((one) => ({ staged: one, entry: parseEntry(one.name, one.text) }))
    34	    .filter((one) => one.entry.headerEndLine > 0);
    35	}
    36	
    37	/** W1.1a's clause memory_index.py does not check: it only reads `^[DFLOH]-` names, so it never sees another name. */
    38	export function checkEntryPrefixes(staged: readonly StagedEntry[]): ClauseOutcome {
    39	  const breaks: string[] = [];
    40	  for (const one of staged) {
    41	    if (!one.name.endsWith(".md")) continue;
    42	    if (!/^[DFLOH]-/.test(one.name)) {
    43	      breaks.push(`${one.path}:1 — the prefix "${one.name.slice(0, 1)}" is not one of D F L O H`);
    44	    }
    45	  }
    46	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
    47	  return {
    48	    breaks: [],
    49	    clean: `${staged.length} staged file(s) under project-memory/entries/, every name's prefix is one of D F L O H`,
    50	    couldNotRun: null,
    51	  };
    52	}
    53	
    54	/** W6.1a's mechanical clause: one file holds one entry. */
    55	export function checkOneEntryPerFile(staged: readonly StagedEntry[]): ClauseOutcome {
    56	  const breaks: string[] = [];
    57	  for (const { staged: one, entry } of parsed(staged)) {
    58	    if (entry.idLines.length > 1) {
    59	      breaks.push(`${one.path}:${entry.idLines[1]} — a second id: line; one file holds one entry`);
    60	    } else if (entry.headerBlocks > 1) {
    61	      breaks.push(`${one.path}:${entry.headerEndLine} — a second --- header block; one file holds one entry`);
    62	    }
    63	  }
    64	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
    65	  return {
    66	    breaks: [],
    67	    clean: `${staged.length} staged entry file(s), each with one header block and one id:`,
    68	    couldNotRun: null,
    69	  };
    70	}
    71	
    72	/** K4.1: an entry file is never deleted; a superseded entry says what replaced it; a retired entry gives its reason. */
    73	export function checkK41(staged: readonly StagedEntry[], snapshot: SnapshotInfo): ClauseOutcome {
    74	  const breaks: string[] = [];
    75	  if (snapshot.shallow) {
    76	    for (const { staged: one, entry } of parsed(staged)) {
    77	      checkHeader(one.path, entry, breaks);
    78	    }
    79	    return {
    80	      breaks,
    81	      clean: "",
    82	      couldNotRun: breaks.length === 0 ? `${SHALLOW}; the superseded_by and retired checks on the snapshot still ran` : null,
    83	    };
    84	  }
    85	  for (const { staged: one, entry } of parsed(staged)) checkHeader(one.path, entry, breaks);
    86	  const deletions = entryDeletions(snapshot.root, snapshot.range);
    87	  for (const deletion of deletions) {
    88	    breaks.push(
    89	      `commit ${short(deletion.commit)} deleted ${deletion.path} — an entry file is never deleted ` +
    90	        "(git log --diff-filter=D --name-status -- project-memory/entries)",
    91	    );
    92	  }
    93	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
    94	  return {
    95	    breaks: [],
    96	    clean:
    97	      `${staged.length} staged entry file(s): no status: superseded without superseded_by, no status: retired ` +
    98	      `without a reason in its changed: line; git log --diff-filter=D --name-status -- project-memory/entries ` +
    99	      `(${snapshot.range}) deleted none`,
   100	    couldNotRun: null,
   101	  };
   102	}
   103	
   104	function checkHeader(path: string, entry: Entry, breaks: string[]): void {
   105	  const status = entry.fields.get("status");
   106	  const statusValue = status?.full ?? "";
   107	  if (statusValue === "superseded" && (entry.fields.get("superseded_by")?.full ?? "") === "") {
   108	    breaks.push(`${path}:${status?.line ?? 1} — status: superseded with no superseded_by link`);
   109	  }
   110	  if (statusValue === "retired") {
   111	    const changed = entry.fields.get("changed");
   112	    const items = (changed?.items ?? []).filter((item) => item.trim() !== "");
   113	    if (items.length === 0) {
   114	      breaks.push(`${path}:${status?.line ?? 1} — status: retired with no changed: line naming the reason`);
   115	    }
   116	  }
   117	}
   118	
   119	/** K4.3: after its first commit an entry only gains lines; its claim, `source` and `depends_on` never change. */
   120	export function checkK43(staged: readonly StagedEntry[], snapshot: SnapshotInfo): ClauseOutcome {
   121	  const withHeader = parsed(staged);
   122	  if (snapshot.shallow) {
   123	    return { breaks: [], clean: "", couldNotRun: SHALLOW };
   124	  }
   125	  const firstVersions = new Map<string, { sha: string; commit: string }>();
   126	  const shas: string[] = [];
   127	  for (const { staged: one } of withHeader) {
   128	    const first = firstVersionOf(snapshot.root, snapshot.range, one.path);
   129	    if (!first) continue;
   130	    firstVersions.set(one.path, first);
   131	    shas.push(first.sha);
   132	  }
   133	  const blobs = catFileBatch(snapshot.root, shas);
   134	  const breaks: string[] = [];
   135	  let compared = 0;
   136	  for (const { staged: one, entry } of withHeader) {
   137	    const first = firstVersions.get(one.path);
   138	    const text = first ? blobs.get(first.sha) : undefined;
   139	    if (!first || text === undefined) continue;
   140	    compared += 1;
   141	    const was = parseEntry(one.name, text);
   142	    if (entry.claim !== was.claim) {
   143	      breaks.push(
   144	        `${one.path}:${entry.claimLine} — the claim changed after commit ${short(first.commit)}: ` +
   145	          `"${truncate(was.claim)}" → "${truncate(entry.claim)}"`,
   146	      );
   147	    }
   148	    for (const key of ["source", "depends_on"] as const) {
   149	      const before = was.fields.get(key)?.full ?? "";
   150	      const after = entry.fields.get(key)?.full ?? "";
   151	      if (before !== after) {
   152	        const line = entry.fields.get(key)?.line ?? was.fields.get(key)?.line ?? 1;
   153	        breaks.push(`${one.path}:${line} — ${key} changed after commit ${short(first.commit)}: "${truncate(before)}" → "${truncate(after)}"`);
   154	      }
   155	    }
   156	    const coversBefore = was.fields.get("covers")?.full ?? "";
   157	    const coversAfter = entry.fields.get("covers")?.full ?? "";
   158	    const changedBefore = (was.fields.get("changed")?.items ?? []).length;
   159	    const changedAfter = (entry.fields.get("changed")?.items ?? []).length;
   160	    if (coversBefore !== coversAfter && changedAfter <= changedBefore) {
   161	      const line = entry.fields.get("covers")?.line ?? was.fields.get("covers")?.line ?? 1;
   162	      breaks.push(`${one.path}:${line} — covers changed after commit ${short(first.commit)} with no changed: line added`);
   163	    }
   164	  }
   165	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
   166	  return {
   167	    breaks: [],
   168	    clean:
   169	      `${compared} entry file(s) compared with their first version in ${snapshot.range}: claim, source, depends_on ` +
   170	      "unchanged, and every covers change has a changed: line",
   171	    couldNotRun: null,
   172	  };
