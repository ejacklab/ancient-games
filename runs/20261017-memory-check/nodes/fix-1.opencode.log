    39	  const fences = lines.map((line, index) => (line === "---" ? index : -1)).filter((index) => index >= 0);
    40	  const start = fences[0] ?? -1;
    41	  const end = fences[1] ?? -1;
    42	  const fields = new Map<string, Field>();
    43	  const idLines: number[] = [];
    44	  if (start === 0 && end > 0) {
    45	    let current: { key: string; value: string; parts: string[]; items: string[]; line: number } | null = null;
    46	    const close = (): void => {
    47	      if (current) {
    48	        fields.set(current.key, {
    49	          value: current.value,
    50	          full: squash(current.parts.join(" ")),
    51	          items: current.items,
    52	          line: current.line,
    53	        });
    54	      }
    55	      current = null;
    56	    };
    57	    for (let index = start + 1; index < end; index++) {
    58	      const line = lines[index] ?? "";
    59	      if (line.trim() === "") continue;
    60	      const indented = /^\s/.test(line);
    61	      if (indented || line.startsWith("- ")) {
    62	        if (current) {
    63	          current.parts.push(line.trim());
    64	          current.items.push(line.trim().replace(/^-\s*/, ""));
    65	        }
    66	        continue;
    67	      }
    68	      const colon = line.indexOf(":");
    69	      if (colon <= 0) continue;
    70	      close();
    71	      const key = line.slice(0, colon).trim();
    72	      const value = line.slice(colon + 1).trim();
    73	      current = { key, value, parts: value ? [value] : [], items: value ? [value] : [], line: index + 1 };
    74	      if (key === "id") idLines.push(index + 1);
    75	    }
    76	    close();
    77	  }
    78	  const body = lines.slice(end >= 0 ? end + 1 : 0);
    79	  let claim = "";
    80	  let claimLine = (end >= 0 ? end : 0) + 2;
    81	  for (const [offset, line] of body.entries()) {
    82	    if (line.startsWith(WHY)) break;
    83	    if (squash(line) !== "") {
