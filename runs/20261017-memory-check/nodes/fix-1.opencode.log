    79	export interface CheckOptions {
    80	  readonly root: string;
    81	  readonly home: string;
    82	  readonly since: string | null;
    83	  /** The report file this run will write, or null when it prints to stdout: F3's evidence. */
    84	  readonly out: string | null;
    85	  readonly guidelines: Guidelines;
    86	}
