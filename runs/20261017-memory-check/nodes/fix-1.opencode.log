    49	/** Why a record is "needs a reviewer". Every record that is not decided has its own reason, cited. */
    50	const REVIEWER_REASON: Record<string, string> = {
    51	  "W2.1b":
    52	    "check: git — whether a commit changed code under a new decision needs that diff read against the entries " +
    53	    "(design-decisions.md 6; research-q/compare.md, Where they agree)",
    54	  "W4.2":
    55	    "its fails_if ends \"with no written reason\", which no tool can see (research-q/compare.md, Where they agree)",
    56	  "W5.1":
    57	    "check: git; reviewer — whether a commit embodies a new decision, or a session writes what it learned, is " +
    58	    "judged (design-decisions.md 6)",
    59	  "W6.1b": "two agent sessions writing one journal file is not visible in git history (design-decisions.md 6)",
    60	  "W6.2": "an edit lost without a conflict cannot be shown by git (design-decisions.md 6)",
    61	  "K1.1":
    62	    "check: git; reviewer — whether a commit changed the behaviour an entry governs needs that entry read " +
    63	    "(design-decisions.md 6)",
    64	  "K5.1":
    65	    "its fails_if ends \"with no written reason\", and raw notes kept elsewhere are not in the repository " +
    66	    "(research-q/compare.md, Where they agree)",
    67	  "W6.3a":
    68	    "check: git; reviewer — whether a merge kept both sides is judged at the merge commit " +
    69	    "(who_decides: project owner)",
    70	  "W3.5a": "check: reviewer — whether the project holds user memory or agent memory is the owner's call (F1 reports the locations; it does not judge what is in them)",
    71	  "W3.5b": "check: reviewer — where user and agent memory live, and whether a reason is written, is the owner's",
    72	  "Rd1.1": "check: reviewer — user and agent memory live in the home folder, and whether that layout has a written reason is the owner's",
    73	};
    74	
    75	const DEFAULT_REVIEWER_REASON =
