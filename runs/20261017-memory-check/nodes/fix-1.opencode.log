    31	
    32	export function checkRd1(root: string): ClauseOutcome {
    33	  const files = sessionStartFiles(root).filter((file) => existsSync(file));
    34	  const scanned: string[] = [];
    35	  const breaks: string[] = [];
    36	  for (const file of files) {
    37	    let text = "";
    38	    try {
    39	      text = readFileSync(file, "utf8");
    40	    } catch {
    41	      scanned.push(`${file} (unreadable)`);
