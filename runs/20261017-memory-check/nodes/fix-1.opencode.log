      if (!CACHE_REFERENCE.test(line)) return;
      if (!OPENS.test(line)) return;
      if (NEGATED.test(line)) return; // an instruction not to read a cache is not an instruction to read it
      breaks.push(`${file}:${offset + 1} — "${line.trim()}"`);
