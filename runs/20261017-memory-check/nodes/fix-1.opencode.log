    13	export function checkB22(root: string): ClauseOutcome {
    14	  const result = cacheIsIgnored(root);
    15	  if (result.ignored) {
    16	    return {
    17	      breaks: [],
    18	      clean: `${result.command} → exit 0, ${result.output}`,
    19	      couldNotRun: null,
    20	    };
    21	  }
    22	  return {
    23	    breaks: [
    24	      `${result.command} → exit ${result.code}${result.output === "" ? ", no output" : `, ${result.output}`}: ` +
    25	        "no ignore rule reports project-memory/.cache",
    26	    ],
    27	    clean: "",
    28	    couldNotRun: null,
    29	  };
