   357	def cat_file_batch(repo: Path, shas: list[str]) -> dict[str, bytes]:
   358	    """Read every blob with one `git cat-file --batch` call. One call per file is about 20 times slower."""
   359	    if not shas:
   360	        return {}
   361	    raw = git(["cat-file", "--batch"], cwd=repo, stdin=("\n".join(shas) + "\n").encode("ascii"))
   362	    blobs: dict[str, bytes] = {}
   363	    position = 0
   364	    while position < len(raw):
   365	        newline = raw.index(b"\n", position)
   366	        header = raw[position:newline].split()
   367	        position = newline + 1
   368	        if len(header) < 3:  # "<sha> missing" — the blob is gone
   369	            continue
   370	        size = int(header[2])
   371	        blobs[header[0].decode("ascii")] = raw[position:position + size]
   372	        position += size + 1
   373	    return blobs
