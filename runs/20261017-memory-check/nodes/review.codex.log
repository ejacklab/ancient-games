   321	def working_tree_paths(repo: Path) -> tuple[list[str], list[str]]:
   322	    """The entry paths git knows about in the working tree, and the matching ones it does not know yet (B1.2)."""
   323	    tracked = set(split_nul(git(["ls-files", "-z", "--cached", "--", ENTRIES_DIR], cwd=repo)))
