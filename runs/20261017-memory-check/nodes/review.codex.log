   390	def working_tree_entries(repo: Path) -> list[Entry]:
   391	    """Read every entry file in the working tree: the ones git knows about, and the ones it does not yet.
   392	
   393	    Write mode reads the working tree, not the index: a tracked or newly staged entry always gets its current
   394	    content. A file git does not know yet is parsed like any other and is an error whatever its status (B1.2) —
   395	    it is named, with the `git add` that fixes it, and nothing is written.
   396	    """
   397	    tracked, untracked = working_tree_paths(repo)
   398	    entries: list[Entry] = []
   399	    for path in sorted(tracked):
   400	        name = entry_name(path)
   401	        try:
   402	            raw = (repo / path).read_bytes()
   403	        except OSError as error:
   404	            entry = Entry(name=name)
   405	            # Unreadable, or deleted without `git rm`: its status cannot be known, and an active entry must never
   406	            # be skipped (DESIGN, Must not 4), so this is an error like an unreadable untracked file.
   407	            entry.errors.append(f"cannot be read in the working tree: {error.strerror} (deleted? git rm it)")
   408	            entries.append(entry)
   409	            continue
   410	        entries.append(entry_from_bytes(name, raw))
   411	    for path in untracked:
   412	        try:
   413	            raw = (repo / path).read_bytes()
   414	        except OSError as error:
   415	            entry = Entry(name=entry_name(path), tracked=False)
   416	            entry.errors.append(f"cannot be read: {error.strerror}")
   417	            entries.append(entry)
   418	            continue
   419	        entries.append(entry_from_bytes(entry_name(path), raw, tracked=False))
   420	    return entries
