   330	def snapshot_paths(repo: Path, rev: str | None) -> dict[str, str]:
   331	    """Every path under `project-memory/` in the snapshot with its blob id — the staging area by default, or a
   332	    commit. NUL-separated, so names with spaces and non-ASCII characters survive (B1.3)."""
   333	    blobs: dict[str, str] = {}
   334	    if rev:
   335	        for meta, path in records(git(["ls-tree", "-r", "-z", rev, "--", MEMORY_DIR], cwd=repo)):
   336	            fields = meta.split()  # <mode> <type> <sha>
   337	            if len(fields) == 3 and is_object_id(fields[2]):
   338	                blobs[path] = fields[2]
   339	    else:
   340	        for meta, path in records(git(["ls-files", "-s", "-z", "--", MEMORY_DIR], cwd=repo)):
   341	            fields = meta.split()  # <mode> <sha> <stage>
   342	            # Stage 0 is what a commit would take, and the only stage a tree without conflicts has.
   343	            if len(fields) == 3 and fields[2] == "0" and is_object_id(fields[1]):
