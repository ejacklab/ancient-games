     1	// The guidelines the tool checks against: its own copy of the two kit files (C1), loaded and parsed here.
     2	// The copy under `guidelines/` is verbatim; the version printed in the report is its content hash, so a report
     3	// names the exact text its results came from.
     4	import { createHash } from "node:crypto";
     5	import { readFileSync } from "node:fs";
     6	import path from "node:path";
     7	
     8	export const FOLDER = path.resolve(import.meta.dirname, "..");
     9	export const GUIDELINES_DIR = path.join(FOLDER, "guidelines");
    10	export const SOT_YAML = path.join(GUIDELINES_DIR, "SOURCE_OF_TRUTH_REQUIREMENTS.yaml");
    11	export const CACHES_MD = path.join(GUIDELINES_DIR, "CACHES.md");
    12	export const MEMORY_INDEX_PY = path.resolve(import.meta.dirname, "../../tools/memory_index.py");
    13	
    14	export type Level = "MUST" | "SHOULD" | "guidance";
    15	
    16	export interface SotRecord {
    17	  readonly id: string;
    18	  readonly level: Level;
    19	  /** The `check` field, split: `tool`, `git`, `reviewer`, `secret scanner`, `none`. */
    20	  readonly checks: readonly string[];
    21	  readonly failsIf: string;
    22	  readonly text: string;
    23	  readonly category: string;
    24	}
    25	
    26	export interface CachesRecord {
    27	  readonly id: string;
    28	  readonly title: string;
    29	  readonly failsIf: string;
    30	}
    31	
    32	export interface Guidelines {
    33	  readonly sot: readonly SotRecord[];
    34	  readonly caches: readonly CachesRecord[];
    35	  /** Content hash of both kit files: the version the report prints. */
    36	  readonly version: string;
    37	}
    38	
    39	function readText(file: string): string {
    40	  return readFileSync(file, "utf8");
    41	}
    42	
    43	function squash(text: string): string {
    44	  return text.replace(/\s+/g, " ").trim();
    45	}
    46	
    47	function hashOf(file: string): string {
    48	  return createHash("sha256").update(readFileSync(file)).digest("hex").slice(0, 12);
    49	}
    50	
    51	/** `Bun.YAML.parse` needs no dependency; the records under `categories[].groups[].requirements[]` are one shape. */
    52	function loadSot(file: string): SotRecord[] {
    53	  const document = Bun.YAML.parse(readText(file)) as {
    54	    categories?: {
    55	      title?: string;
    56	      groups?: { requirements?: Record<string, unknown>[] }[];
    57	    }[];
    58	  };
    59	  const records: SotRecord[] = [];
    60	  for (const category of document.categories ?? []) {
    61	    for (const group of category.groups ?? []) {
    62	      for (const requirement of group.requirements ?? []) {
    63	        const id = String(requirement["id"] ?? "");
    64	        const level = String(requirement["level"] ?? "") as Level;
    65	        const check = String(requirement["check"] ?? "none");
    66	        if (!id) continue;
    67	        records.push({
    68	          id,
    69	          level,
    70	          checks: check.split(";").map((part) => part.trim()).filter(Boolean),
    71	          failsIf: squash(String(requirement["fails_if"] ?? "")),
    72	          text: squash(String(requirement["text"] ?? "")),
    73	          category: String(category.title ?? ""),
    74	        });
    75	      }
    76	    }
    77	  }
    78	  return records;
    79	}
    80	
    81	const HEADING = /^\*\*((?:B|K|Rd)\d+) — (.+?)\*\*.*$/;
    82	const FAILS_IF = /^\s*-?\s*\*+Fails if\*+\s*(.+)$/;
    83	
    84	/**
    85	 * `CACHES.md` § Core requirements: each requirement is a bold heading, with its Fails-if line inside it. The
    86	 * requirement is the heading, so the sub-bullets (B1.1, K1.2, ...) are not ids of their own.
    87	 */
    88	function loadCaches(file: string): CachesRecord[] {
    89	  const records: CachesRecord[] = [];
    90	  let current: { id: string; title: string; failsIf: string } | null = null;
    91	  let heading = false;
    92	  for (const line of readText(file).split("\n")) {
    93	    if (/^## /.test(line)) {
    94	      if (current) records.push(current);
    95	      current = null;
    96	      heading = false;
    97	    }
    98	    const match = HEADING.exec(line);
    99	    if (match) {
   100	      if (current) records.push(current);
   101	      current = { id: match[1]!, title: squash(match[2]!), failsIf: "" };
   102	      heading = true;
   103	      continue;
   104	    }
   105	    if (!heading || !current) continue;
   106	    const fails = FAILS_IF.exec(line);
   107	    if (fails) current.failsIf = `${current.failsIf} ${squash(fails[1]!)}`.trim();
   108	  }
   109	  if (current) records.push(current);
   110	  return records;
   111	}
   112	
   113	export function loadGuidelines(): Guidelines {
   114	  return {
   115	    sot: loadSot(SOT_YAML),
   116	    caches: loadCaches(CACHES_MD),
   117	    version: `SOURCE_OF_TRUTH_REQUIREMENTS.yaml ${hashOf(SOT_YAML)}, CACHES.md ${hashOf(CACHES_MD)}`,
   118	  };
