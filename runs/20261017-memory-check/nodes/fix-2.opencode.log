   138	  // --- the records of SOURCE_OF_TRUTH_REQUIREMENTS.yaml ----------------------------------------------------------
   139	
   140	  const context: SotContext = { projectMemory, indexTool, prefixes, onePerFile, k41, k43, merges, renames };
   141	  for (const record of guidelines.sot) {
   142	    results.push(sotResult(record, context));
   143	  }
   144	
   145	  // --- the Core requirements of CACHES.md --------------------------------------------------------------------------
