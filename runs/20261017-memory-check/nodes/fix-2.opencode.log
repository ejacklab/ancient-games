     1	// The command itself: `bun src/cli.ts [--project <repo root>] [--home <dir>] [--since <rev>] [--out <file>]
     2	// [--warn]` — `cli.ts` launches it, `command.ts` is it.
     3	// R3: exit 0 when no MUST fails or could not run, 1 when one does, 2 on a usage error. Nothing is written but
     4	// `--out`'s file (F3, U5).
     5	import { existsSync, statSync, writeFileSync } from "node:fs";
     6	import { homedir } from "node:os";
     7	import path from "node:path";
     8	import { runChecks } from "./checks.ts";
     9	import { loadGuidelines } from "./guidelines.ts";
    10	import { gitOut } from "./git.ts";
    11	import { renderReport } from "./report.ts";
    12	import { renderWarning } from "./warn.ts";
    13	
    14	const USAGE = `memory-check — check a project's memory against docs/memory-system's two guidelines
    15	
    16	Usage: memory-check [options]
    17	  --project <path>   the git repository root to check (default: the current folder)
    18	  --home <dir>       the home folder that holds .claude/agent-memory/<name>/ (default: the user's home)
    19	  --since <rev>      check history from this commit instead of the first that touches project-memory/
    20	  --out <file>       write the report here instead of printing it
    21	  --warn             print the session-start warning only (failing MUSTs and a missing AGENTS.md)
    22	  --help             this text`;
    23	
    24	interface Options {
    25	  readonly project: string | null;
    26	  readonly home: string | null;
    27	  readonly since: string | null;
    28	  readonly out: string | null;
    29	  readonly warn: boolean;
    30	}
    31	
    32	class UsageError extends Error {}
    33	
    34	function parseArgs(argv: readonly string[]): Options {
    35	  let project: string | null = null;
    36	  let home: string | null = null;
    37	  let since: string | null = null;
    38	  let out: string | null = null;
    39	  let warn = false;
    40	  for (let index = 0; index < argv.length; index++) {
    41	    const flag = argv[index]!;
    42	    const value = (): string => {
    43	      const next = argv[index + 1];
    44	      if (next === undefined || next.startsWith("--")) throw new UsageError(`${flag} needs a value`);
    45	      index += 1;
    46	      return next;
    47	    };
    48	    switch (flag) {
    49	      case "--project":
    50	        project = value();
    51	        break;
    52	      case "--home":
    53	        home = value();
    54	        break;
    55	      case "--since":
    56	        since = value();
    57	        break;
    58	      case "--out":
    59	        out = value();
    60	        break;
    61	      case "--warn":
    62	        warn = true;
    63	        break;
    64	      case "--help":
    65	      case "-h":
    66	        process.stdout.write(`${USAGE}\n`);
    67	        process.exit(0);
    68	        break;
    69	      default:
    70	        throw new UsageError(`unknown option ${flag}`);
    71	    }
    72	  }
    73	  return { project, home, since, out, warn };
    74	}
    75	
    76	/** F2: the project must be given, exist, and be the root of a git repository — else a usage error. */
    77	function projectRootOf(given: string | null): string {
    78	  const root = path.resolve(given ?? process.cwd());
    79	  if (!existsSync(root) || !statSync(root).isDirectory()) {
    80	    throw new UsageError(`${root} does not exist`);
    81	  }
    82	  const top = gitOut(root, ["rev-parse", "--show-toplevel"]);
    83	  if (top === "") throw new UsageError(`${root} is not inside a git repository`);
    84	  if (path.resolve(top) !== root) throw new UsageError(`${root} is not the root of its git repository (${top} is)`);
    85	  return root;
    86	}
    87	
    88	export function main(argv: readonly string[]): number {
    89	  let options: Options;
    90	  let root: string;
    91	  let home: string;
    92	  try {
    93	    options = parseArgs(argv);
    94	    root = projectRootOf(options.project);
    95	    home = path.resolve(options.home ?? homedir());
    96	    if (!existsSync(home)) throw new UsageError(`${home} does not exist`);
    97	    if (options.since !== null && gitOut(root, ["rev-parse", "--verify", "--quiet", `${options.since}^{commit}`]) === "") {
    98	      throw new UsageError(`--since ${options.since} names no commit in ${root}`);
    99	    }
   100	  } catch (error) {
   101	    const message = error instanceof UsageError ? error.message : String(error);
   102	    process.stderr.write(`memory-check: ${message}\n${USAGE}\n`);
   103	    return 2;
   104	  }
   105	
   106	  const run = runChecks({
   107	    root,
   108	    home,
   109	    since: options.since,
   110	    out: options.out ? path.resolve(options.out) : null,
   111	    guidelines: loadGuidelines(),
   112	  });
   113	
   114	  if (options.warn) {
   115	    const warning = renderWarning(run);
   116	    if (warning !== "") process.stdout.write(`${warning}\n`);
   117	  } else if (options.out !== null) {
   118	    writeFileSync(path.resolve(options.out), renderReport(run, path.resolve(options.out)));
   119	    process.stdout.write(`${path.resolve(options.out)}\n`);
   120	  } else {
   121	    process.stdout.write(`${renderReport(run, null)}\n`);
   122	  }
   123	  return run.exitCode;
   124	}
===== memory_check/src/cli.ts
     1	// The command's launcher: `bun src/cli.ts [options]`.
     2	//
     3	// F3, U5: a run must write nothing but its own report, and that covers what the runtime writes too. Bun caches the
     4	// transpiled form of every source file of 4 KB or more in `$BUN_RUNTIME_TRANSPILER_CACHE_PATH`, which by default is
     5	// `$HOME/.bun/install/cache/@t@` — the home folder of the project being checked, when `--home` points at it. That
     6	// variable is read before any JavaScript runs, so nothing written in this repository can redirect it. This file is
     7	// therefore only a launcher: no static imports and far under 4 KB, so nothing in it is ever cached. It re-runs the
     8	// same command through the same bun binary with the transpiler cache switched off, forwarding the arguments, the
     9	// standard streams and the exit code; that second run reads every module with the cache off and writes none either.
    10	// A caller who has already chosen a cache directory keeps it — the launcher runs once, and only when the variable is
    11	// unset.
    12	const CACHE_PATH_VAR = "BUN_RUNTIME_TRANSPILER_CACHE_PATH";
    13	
    14	const args = Bun.argv.slice(2);
    15	
    16	if (process.env[CACHE_PATH_VAR] === undefined) {
    17	  const child = Bun.spawnSync({
    18	    cmd: [process.execPath, import.meta.path, ...args],
    19	    env: { ...process.env, [CACHE_PATH_VAR]: "0" },
    20	    stdin: "inherit",
    21	    stdout: "inherit",
    22	    stderr: "inherit",
    23	  });
    24	  process.exit(child.exitCode);
    25	}
    26	
    27	const { main } = await import("./command.ts");
    28	process.exit(main(args));===== memory_check/src/warn.ts
     1	// R2: the warning — one line per failing MUST and for a missing AGENTS.md, with ids and file names, never entry
     2	// text; nothing else; empty when there are none. `--warn` prints it; the session-start hook that also prints it is
     3	// a harness change R2 leaves to the owner (R12.3), and no file under project-memory/.cache/ is ever opened here
     4	// (Rd1): nothing in the run reads a cache file, only whether the folder is there.
     5	import type { CheckRun, RequirementResult } from "./checks.ts";
     6	
     7	const TOOL_COMMAND = /^python3 .*--check\s+\(in .*\) → exit -?\d+(, output: [^;]*)?;?/;
     8	/** The file names in an evidence line, and nothing else of the entry: no claim, no body, no text. */
     9	const FILE_NAME = /(project-memory\/entries\/[\w.\-]+|project-memory\/INDEX\.md|AGENTS\.md)/g;
    10	
    11	function filesIn(evidence: string): string {
    12	  return [...new Set([...evidence.matchAll(FILE_NAME)].map((match) => match[1]!))].join(", ");
    13	}
    14	
    15	/** The one break of the evidence, without the command and output memory_index.py's own. */
    16	function firstBreak(evidence: string): string {
    17	  const withoutCommand = evidence.replace(TOOL_COMMAND, "");
    18	  const first = withoutCommand.split(";")[0] ?? withoutCommand;
    19	  const trimmed = first.trim();
    20	  return trimmed.length <= 200 ? trimmed : `${trimmed.slice(0, 199)}…`;
    21	}
    22	
    23	function warningFor(result: RequirementResult): string {
    24	  const files = filesIn(result.evidence);
    25	  const where = files === "" ? "" : ` — files: ${files}`;
    26	  return `memory-check: ${result.id} fails: ${firstBreak(result.evidence)}${where}`;
    27	}
    28	
    29	export function renderWarning(run: CheckRun): string {
    30	  // F1 failing is the missing AGENTS.md, which has its own line below: one line per thing, not two.
    31	  const lines = run.results
    32	    .filter((result) => result.id !== "F1" && result.level === "MUST" && result.verdict === "fail")
    33	    .map(warningFor);
    34	  const missingAgents = run.results.find((result) => result.id === "F1" && result.verdict === "fail");
    35	  if (missingAgents) {
    36	    lines.push(`memory-check: AGENTS.md is missing — file: ${run.root}/AGENTS.md (it is required, F1)`);
    37	  }
    38	  return lines.join("\n");
    39	}
