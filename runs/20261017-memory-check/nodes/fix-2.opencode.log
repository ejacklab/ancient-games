    98	function notes(run: CheckRun): string[] {
    99	  const lines: string[] = ["## Notes from tools/memory_index.py", ""];
   100	  const all = [...run.indexTool.stdout, ...run.indexTool.stderr];
   101	  if (all.length === 0) lines.push("- it printed nothing");
   102	  for (const one of all) lines.push(`- \`${one}\``);
   103	  if (run.notes.length > 0) {
   104	    lines.push("", "## Notes from this tool", "");
   105	    for (const one of run.notes) lines.push(`- ${one}`);
   106	  }
   107	  lines.push("");
