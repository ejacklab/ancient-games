   100	/** One `git cat-file --batch` for many blobs; missing blobs come back absent, not as an error. */
   101	export function catFileBatch(root: string, shas: readonly string[]): Map<string, string> {
   102	  const blobs = new Map<string, string>();
   103	  const wanted = [...new Set(shas.filter((sha) => sha !== ""))];
   104	  if (wanted.length === 0) return blobs;
   105	  const result = spawnSync("git", ["cat-file", "--batch"], {
   106	    cwd: root,
   107	    encoding: "buffer",
   108	    input: Buffer.from(`${wanted.join("\n")}\n`, "ascii"),
   109	    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
   110	  });
   111	  const buffer = result.stdout ?? Buffer.alloc(0);
   112	  let position = 0;
   113	  while (position < buffer.length) {
   114	    const newline = buffer.indexOf(0x0a, position);
   115	    if (newline < 0) break;
   116	    const header = buffer.subarray(position, newline).toString("ascii").split(" ");
   117	    position = newline + 1;
   118	    if (header.length < 3) continue; // "<sha> missing"
   119	    const size = Number(header[2]);
   120	    blobs.set(header[0] ?? "", buffer.subarray(position, position + size).toString("utf8"));
   121	    position += size + 1;
   122	  }
   123	  return blobs;
   124	}
