     1	// F1: the memory locations the guidelines name, each reported present or absent. No file inside a location is
     2	// read to decide it: the tool asks the file system whether it is there, and nothing else.
     3	import { existsSync, readdirSync, statSync } from "node:fs";
     4	import path from "node:path";
     5	
     6	export interface Location {
     7	  /** The name the guideline uses for it: `AGENTS.md`, `project-memory/entries/`, `agent memory`. */
     8	  readonly name: string;
     9	  /** Absolute path, as given to the file system. */
    10	  readonly path: string;
    11	  readonly present: boolean;
    12	  /** For a folder: how many direct children it holds (a name is never read). */
    13	  readonly children: number | null;
    14	}
    15	
    16	export const AGENTS_MD = "AGENTS.md";
    17	
    18	const IN_PROJECT: readonly { name: string; path: string }[] = [
    19	  { name: "AGENTS.md", path: "AGENTS.md" },
    20	  { name: "CLAUDE.md", path: "CLAUDE.md" },
    21	  { name: "project-memory/INDEX.md", path: "project-memory/INDEX.md" },
    22	  { name: "project-memory/entries/", path: "project-memory/entries" },
    23	  { name: "project-memory/work/", path: "project-memory/work" },
    24	  { name: "project-memory/journal/", path: "project-memory/journal" },
    25	  { name: "project-memory/.cache/", path: "project-memory/.cache" },
    26	];
    27	
    28	export const PROJECT_LOCATIONS = IN_PROJECT;
    29	
    30	function isFolder(full: string): boolean {
    31	  try {
    32	    return statSync(full).isDirectory();
    33	  } catch {
    34	    return false;
    35	  }
    36	}
    37	
    38	function childrenCount(full: string): number | null {
    39	  if (!isFolder(full)) return null;
    40	  try {
    41	    return readdirSync(full).length;
    42	  } catch {
    43	    return null;
    44	  }
    45	}
    46	
    47	/**
    48	 * The agent memory the design places in the home folder (`docs/memory-system/SOURCE_OF_TRUTH.md`, What it is
    49	 * for): one folder per agent name. The tool cannot know which agents work on the project, so it reports the
    50	 * names it finds, and absent when there is no such folder.
    51	 */
    52	function agentMemory(home: string): Location[] {
    53	  const folder = path.join(home, ".claude", "agent-memory");
    54	  const absent: Location = {
    55	    name: "agent memory (<home>/.claude/agent-memory/<name>/)",
    56	    path: folder,
    57	    present: false,
    58	    children: null,
    59	  };
    60	  if (!isFolder(folder)) return [absent];
    61	  let names: string[] = [];
    62	  try {
    63	    names = readdirSync(folder).sort();
    64	  } catch {
    65	    return [absent];
    66	  }
    67	  if (names.length === 0) return [absent];
    68	  return names.map((name) => {
    69	    const full = path.join(folder, name);
    70	    return { name: `agent memory ${name}/`, path: full, present: existsSync(full), children: childrenCount(full) };
    71	  });
    72	}
    73	
    74	export function findLocations(root: string, home: string): Location[] {
    75	  const inProject: Location[] = IN_PROJECT.map((location) => {
    76	    const full = path.join(root, location.path);
    77	    return { name: location.name, path: full, present: existsSync(full), children: childrenCount(full) };
    78	  });
    79	  return [...inProject, ...agentMemory(home)];
    80	}
    81	
    82	export function hasProjectMemory(root: string): boolean {
    83	  return existsSync(path.join(root, "project-memory"));
    84	}
    85	
    86	export function agentsMdMissing(root: string): boolean {
    87	  return !existsSync(path.join(root, AGENTS_MD));
