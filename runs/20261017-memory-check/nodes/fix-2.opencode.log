   106	
   107	    Line 1 must be `---` and the header ends at the next line that is exactly `---`. Indented lines are nested
   108	    fields, not top-level ones. Returns the fields, the index of the closing line, and the first problem.
   109	    """
   110	    if not lines or lines[0] != "---":
   111	        return {}, None, "no header"
   112	    try:
   113	        end = lines.index("---", 1)
   114	    except ValueError:
   115	        return {}, None, "header is not closed"
