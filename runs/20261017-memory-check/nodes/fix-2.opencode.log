   210	  if (record.checks.includes("tool")) {
   211	    if (toolFailedToStart(run)) {
   212	      return { ...base, verdict: "could not run", evidence: `${run.command} could not be run: ${run.stderr.join(" ")}` };
   213	    }
   214	    // Rd3.1a's limit is checked by memory_index.py after it compared the index; when it stopped earlier that clause
   215	    // did not run. Its own size line is reported, not judged here a second way (C3).
   216	    if (record.id === "Rd3.1a" && run.mismatch && !run.overLimit && overLimitSize(run.sizeLine)) {
   217	      return {
   218	        ...base,
   219	        verdict: "could not run",
   220	        evidence:
   221	          `${toolEvidence} — memory_index.py printed ${run.sizeLine} and then stopped at the K6 index comparison, ` +
   222	          "before its limit check; nothing is judged here a second way (C3)",
   223	      };
   224	    }
   225	    const findings = run.findings.get(record.id) ?? [];
   226	    const mine = myClauseOf(record, context);
   227	    const breaks = [...findings, ...(mine?.breaks ?? [])];
   228	    if (breaks.length > 0) return { ...base, verdict: "fail", evidence: `${toolEvidence}; ${breaks.join("; ")}` };
   229	    if (mine?.couldNotRun) return { ...base, verdict: "could not run", evidence: `${toolEvidence}; ${mine.couldNotRun}` };
