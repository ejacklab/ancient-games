   287	    prefixBreaks.length > 0
   288	      ? { breaks: prefixBreaks, clean: "", couldNotRun: null, notes: skipped }
   289	      : { breaks: [], clean: how, couldNotRun: null, notes: skipped };
   290	  const ids: ClauseOutcome =
   291	    idBreaks.length > 0
   292	      ? { breaks: idBreaks, clean: "", couldNotRun: null, notes: skipped }
   293	      : { breaks: [], clean: `${how}; no id changed in a rename`, couldNotRun: null, notes: skipped };
   294	  return { prefixes, ids };
