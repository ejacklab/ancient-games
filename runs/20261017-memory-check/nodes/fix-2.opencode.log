    84	function needsReviewer(results: readonly RequirementResult[]): string[] {
    85	  const list = results.filter((result) => result.verdict === "needs a reviewer");
    86	  if (list.length === 0) return ["## Needs a reviewer", "", "- none", ""];
    87	  return [
    88	    "## Needs a reviewer",
    89	    "",
    90	    ...list.map(
    91	      (result) =>
    92	        `- **${result.id}** (${result.level}) — fails if: ${result.failsIf || "(guidance)"} — why not the tool: ${result.evidence}`,
    93	    ),
    94	    "",
    95	  ];
    96	}
