    41	export function checkB22(root: string): ClauseOutcome {
    42	  const result = cacheIsIgnored(root);
    43	  const rules = `ignore rules git reads here: ${ignoreRuleFiles(root).join(", ") || "none (no .gitignore, no .git/info/exclude)"}`;
    44	  if (result.ignored) {
    45	    return {
    46	      breaks: [],
    47	      clean: `${result.command} → exit 0, ${result.output}; ${rules}`,
    48	      couldNotRun: null,
    49	    };
    50	  }
    51	  return {
    52	    breaks: [
    53	      `${result.command} → exit ${result.code}${result.output === "" ? ", no output" : `, ${result.output}`}: ` +
    54	        `no ignore rule reports project-memory/.cache; ${rules}`,
