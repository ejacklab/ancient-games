    10	const CACHE_REFERENCE = /(?:\bproject-memory\/)?\.cache\/[^\s`"')]*/;
    11	const OPENS = /\b(read|open|load|cat|head|tail|less|more|sqlite3|query|search|grep|rg|glob|import|attach|select|list)\b/i;
    12	const NEGATED = /\b(never|no|not|avoid|without|don'?t|do not|nothing)\b/i;
    13	
    14	/**
    15	 * The ignore files git reads for this repository: every `.gitignore` in the working tree and the repository's own
    16	 * exclude file. Named, never opened — `git check-ignore` decides, and its evidence says where it looked (C2). The
    17	 * walk steps over `.git` and over any `.cache` folder, so nothing under `project-memory/.cache/` is opened (Rd1, R2).
    18	 */
    19	function ignoreRuleFiles(root: string): string[] {
    20	  const files: string[] = [];
    21	  const walk = (folder: string): void => {
    22	    for (const one of listingOf(folder)) {
    23	      if (one.name === ".gitignore") files.push(path.join(folder, one.name));
    24	      else if (one.isDirectory()) walk(path.join(folder, one.name));
    25	    }
    26	  };
    27	  walk(root);
    28	  const exclude = path.join(root, ".git", "info", "exclude");
    29	  if (existsSync(exclude)) files.push(exclude);
    30	  return files;
    31	}
    32	
    33	function listingOf(folder: string): Dirent[] {
    34	  try {
    35	    return readdirSync(folder, { withFileTypes: true }).filter((one) => (one.isDirectory() ? one.name !== ".git" && one.name !== ".cache" : one.isFile()));
    36	  } catch {
    37	    return [];
    38	  }
    39	}
