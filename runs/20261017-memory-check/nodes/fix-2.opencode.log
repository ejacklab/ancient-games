+  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null, notes: scannedNote };
+  if (unresolved.length > 0) {
+    return {
+      breaks: [],
+      clean: "",
+      couldNotRun: null,
+      unresolved,
+      notes: scannedNote,
+    };
+  }
+  return {
