     1	// C3: the index and entry-format checks are `tools/memory_index.py --check`, run from the checked project's root
     2	// and parsed. This file never judges those clauses itself — it maps each of the tool's own messages to the
     3	// requirement id the message belongs to, and every result it gives carries the command and its output as evidence.
     4	import { spawnSync } from "node:child_process";
     5	import { MEMORY_INDEX_PY } from "./guidelines.ts";
     6	
     7	export interface IndexToolRun {
     8	  /** The command as it was run, for evidence. */
     9	  readonly command: string;
    10	  readonly code: number;
    11	  readonly stdout: readonly string[];
    12	  readonly stderr: readonly string[];
    13	  /** Requirement id (SoT id, no prefix) -> the lines of the tool that found the break. */
    14	  readonly findings: ReadonlyMap<string, readonly string[]>;
    15	  /** `INDEX.md: 12/200 lines, 900/24000 bytes`, when the tool printed it. */
    16	  readonly sizeLine: string | null;
    17	  /** The tool's own over-limit failure (it prints this only after the index matched). */
    18	  readonly overLimit: boolean;
    19	  /** `INDEX.md ... does not match what these entries build`. */
    20	  readonly mismatch: boolean;
    21	  /** `nothing to check: no project-memory/ in ...`. */
    22	  readonly noMemory: boolean;
    23	  /** `nothing to check: HEAD names no commit yet ...`. */
    24	  readonly unbornHead: boolean;
    25	  readonly upToDate: boolean;
    26	  /** Tool messages that name no requirement id: reported as notes, never dropped. */
    27	  readonly notes: readonly string[];
    28	}
    29	
    30	const SIZE_LINE = /^INDEX\.md: (\d+)\/(\d+) lines, (\d+)\/(\d+) bytes/;
    31	
    32	/** A per-file problem as memory_index.py prints it: `<file name>: <problem>` (`tools/memory_index.py:385`). */
    33	const PER_FILE = /^([^:]+): (.+)$/;
    34	
    35	/** Which requirement each of memory_index.py's own problems belongs to. Order matters: longer patterns first. */
    36	function idOfProblem(problem: string): string | null {
    37	  if (/^kind .* is not one of/.test(problem)) return "W1.1a";
    38	  if (/^kind .* does not match the/.test(problem)) return "W1.1a";
    39	  if (/^id .* is not in the form/.test(problem)) return "W1.1b";
    40	  if (/^(empty id|duplicate id)/.test(problem)) return "W1.1b";
    41	  if (/^(no header|header is not closed)/.test(problem)) return "W1.2a";
    42	  if (/^(no \*\*Why:\*\* line|empty claim)/.test(problem)) return "W1.3a";
    43	  if (/^status .* is not one of/.test(problem)) return "W4.1b";
    44	  if (/^unresolved conflict marker/.test(problem)) return "K6.3a";
    45	  return null;
    46	}
    47	
    48	export function runMemoryIndex(root: string): IndexToolRun {
    49	  const args = ["--check"];
    50	  const result = spawnSync("python3", [MEMORY_INDEX_PY, ...args], {
    51	    cwd: root,
    52	    encoding: "utf8",
    53	    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
    54	  });
    55	  const code = result.status ?? -1;
    56	  const stdout = (result.stdout ?? "").split("\n").filter((line) => line.trim() !== "");
    57	  const stderr = (result.stderr ?? "").split("\n").filter((line) => line.trim() !== "");
    58	  const command = `python3 ${MEMORY_INDEX_PY} --check   (in ${root})`;
    59	
    60	  const findings = new Map<string, string[]>();
    61	  const notes: string[] = [];
    62	  let sizeLine: string | null = null;
    63	  let overLimit = false;
    64	  let mismatch = false;
    65	  let noMemory = false;
    66	  let unbornHead = false;
    67	  let upToDate = false;
    68	
    69	  const add = (id: string, line: string): void => {
    70	    const bucket = findings.get(id) ?? [];
    71	    bucket.push(line);
    72	    findings.set(id, bucket);
    73	  };
    74	
    75	  for (const line of [...stdout, ...stderr]) {
    76	    const message = line.trim();
    77	    if (SIZE_LINE.test(message)) {
    78	      sizeLine = message;
    79	      continue;
    80	    }
    81	    if (/^nothing to check: no project-memory\//.test(message)) {
    82	      noMemory = true;
    83	      continue;
    84	    }
    85	    if (/^nothing to check: HEAD names no commit/.test(message)) {
    86	      unbornHead = true;
    87	      continue;
    88	    }
    89	    if (/^INDEX\.md in .* is up to date$/.test(message)) {
    90	      upToDate = true;
    91	      continue;
    92	    }
    93	    if (/^INDEX\.md in .* does not match/.test(message)) {
    94	      mismatch = true;
    95	    }
    96	    if (/INDEX\.md in .* is over the limit/.test(message)) {
    97	      // The index's own size limit: the clause memory_index.py judges (Rd3.1a), reported as its own failure.
    98	      overLimit = true;
    99	      add("Rd3.1a", message);
   100	      continue;
   101	    }
   102	    // The two index clauses share memory_index.py's one comparison: K6.1a and K6.2 are reported together (C3).
   103	    if (/INDEX\.md in .* does not match what these entries build/.test(message)) {
   104	      add("K6.1a", message);
   105	      add("K6.2", message);
   106	      continue;
   107	    }
   108	    const perFile = PER_FILE.exec(message);
   109	    const problem = perFile ? perFile[2]! : message;
   110	    const id = idOfProblem(problem);
   111	    if (id && !/\(warning\)$/.test(message)) {
   112	      // memory_index.py calls a content problem in an inactive entry a warning, and exits 0 on it: a clause it
   113	      // only warns about is not a break here either (C3: never report a pass the tool fails).
   114	      for (const one of id.split(",")) add(one, message);
   115	      continue;
   116	    }
   117	    // Everything else the tool printed: a per-file warning, a diff line, a fix hint. Not a finding of a
   118	    // requirement id, but never dropped.
   119	    notes.push(message);
   120	  }
   121	
