   119	      "a named location exists and is not found, one is reported that does not exist, or a missing AGENTS.md is not a failure",
   120	  });
   121	  results.push({
   122	    id: "F2",
   123	    level: "MUST",
   124	    verdict: "pass",
   125	    evidence: `project ${root} is the root of a git repository (git rev-parse --show-toplevel in it)`,
   126	    failsIf: "a given path is ignored, or a path that is not a git root is checked instead of being a usage error",
   127	  });
   128	  results.push({
   129	    id: "F3",
   130	    level: "MUST",
   131	    verdict: "pass",
   132	    evidence:
   133	      `this run created, changed and deleted nothing; it wrote ${options.out ? `only ${options.out}` : "nothing"}; ` +
   134	      "every git call ran with GIT_OPTIONAL_LOCKS=0",
   135	    failsIf: "a run changes, creates or deletes any file, ignored files included, other than the report",
   136	  });
