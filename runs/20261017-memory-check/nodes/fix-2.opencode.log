     1	// R1: one Markdown report per run — the snapshot in the first line (C5), the locations (F1), then every
     2	// requirement with its id, level, result and evidence, MUSTs first, and a list of what needs a reviewer.
     3	import type { CheckRun, RequirementResult, Verdict } from "./checks.ts";
     4	
     5	const LEVEL_ORDER: Record<string, number> = { MUST: 0, SHOULD: 1, guidance: 2, "not stated in CACHES.md": 3 };
     6	
     7	function byLevelThenId(a: RequirementResult, b: RequirementResult): number {
     8	  const levels = (LEVEL_ORDER[a.level] ?? 9) - (LEVEL_ORDER[b.level] ?? 9);
     9	  return levels !== 0 ? levels : a.id.localeCompare(b.id);
    10	}
    11	
    12	function verdictOf(result: RequirementResult): string {
    13	  return result.verdict;
    14	}
    15	
    16	/** One result line, with its evidence on the same line so a diff of two reports shows the change. */
    17	function line(result: RequirementResult): string {
    18	  return `- **${result.id}** (${result.level}) — ${verdictOf(result)} — ${result.evidence}`;
    19	}
    20	
    21	function count(results: readonly RequirementResult[], verdict: Verdict): number {
    22	  return results.filter((one) => one.verdict === verdict).length;
    23	}
