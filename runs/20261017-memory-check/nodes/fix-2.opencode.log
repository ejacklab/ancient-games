   194	/** The header fields and the log line a merge must keep from both sides (W6.3a). */
   195	const KEPT_ON_BOTH_SIDES = ["covers", "supersedes", "superseded_by", "depends_on", "changed"] as const;
   196	
   197	/** The items of one header field, with the empty list forms read as no items. */
