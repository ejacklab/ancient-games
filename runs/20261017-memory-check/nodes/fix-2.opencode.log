   249	      }
   250	      if (context.merges.couldNotRun) {
   251	        return { ...base, verdict: "could not run", evidence: context.merges.couldNotRun };
   252	      }
   253	      return {
   254	        ...base,
   255	        verdict: "needs a reviewer",
   256	        evidence:
   257	          `${context.merges.clean}; whether the two entries that supersede one go unreported (the other half of ` +
   258	          "W6.3a) is judged with the project owner (C2: checked by the tool and by a reviewer)",
