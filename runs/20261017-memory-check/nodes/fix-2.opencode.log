   203	/**
   204	 * W6.3a's git half: a merge keeps both sides. For every merge in the range and every parent, each `covers` path,
   205	 * link and `changed:` line the parent holds must be in the merge result. A file the merge does not hold is left to
   206	 * K4.1's deletion clause, so one break is reported once.
   207	 */
   208	export function checkMerges(snapshot: SnapshotInfo): ClauseOutcome {
   209	  const root = snapshot.root;
   210	  if (snapshot.shallow) return { breaks: [], clean: "", couldNotRun: SHALLOW };
   211	  const merges = mergeCommits(root, snapshot.range);
   212	  const breaks: string[] = [];
   213	  const comparedAt: string[] = [];
   214	  let compared = 0;
   215	  for (const merge of merges) {
   216	    const merged = new Set(entryFilesAt(root, merge.commit));
   217	    for (const parent of merge.parents) {
   218	      const paths = entryFilesAt(root, parent).filter((path) => merged.has(path));
   219	      const mergedShas = paths.map((path) => blobIdAt(root, merge.commit, path));
   220	      const parentShas = paths.map((path) => blobIdAt(root, parent, path));
   221	      const blobs = catFileBatch(root, [...mergedShas, ...parentShas]);
   222	      for (const [offset, path] of paths.entries()) {
   223	        const after = blobs.get(mergedShas[offset] ?? "");
   224	        const before = blobs.get(parentShas[offset] ?? "");
   225	        if (after === undefined || before === undefined || after === before) continue;
   226	        compared += 1;
   227	        const result = parseEntry(path, after);
   228	        const side = parseEntry(path, before);
   229	        const line = (result.fields.get("changed")?.line ?? 1);
   230	        comparedAt.push(`${path}:${line}`);
   231	        for (const key of KEPT_ON_BOTH_SIDES) {
   232	          const kept = itemsOf(result, key);
   233	          for (const item of itemsOf(side, key)) {
   234	            if (kept.includes(item)) continue;
   235	            breaks.push(
   236	              `${path}:${result.fields.get(key)?.line ?? line} — merge ${short(merge.commit)} holds no ${key} ` +
   237	                `"${truncate(item)}" that parent ${short(parent)} holds (git show ${merge.commit}:${path})`,
   238	            );
   239	          }
   240	        }
   241	      }
   242	    }
   243	  }
   244	  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
   245	  return {
   246	    breaks: [],
   247	    clean:
   248	      `${merges.length} merge commit(s) in ${snapshot.range} (git log --format=%H %P), ${compared} parent(s) of an ` +
   249	      `entry file compared with the merge result${compared === 0 ? "" : ` (${comparedAt.join(", ")})`}: every ` +
   250	      "covers path, link and changed: line either side holds is in the merge result",
   251	    couldNotRun: null,
   252	  };
   253	}
