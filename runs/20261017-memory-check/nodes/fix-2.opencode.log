    25	export function renderReport(run: CheckRun, outFile: string | null): string {
    26	  const { snapshot, results, locations } = run;
    27	  const own = results.filter((result) => !result.id.includes(":"));
    28	  const sot = results.filter((result) => result.id.startsWith("SoT:"));
    29	  const caches = results.filter((result) => result.id.startsWith("CACHES:"));
    30	
    31	  const first =
    32	    `# memory-check — snapshot: files: ${snapshot.filesView}; history: ${snapshot.historyView} — project: ${run.root}`;
    33	  const head = [
    34	    first,
    35	    "",
    36	    `Guidelines this report is checked against (the tool's own copy, C1): ${run.guidelines.version}`,
    37	    `Records: ${sot.length} from SOURCE_OF_TRUTH_REQUIREMENTS.yaml (SoT:), ${caches.length} Core requirements from CACHES.md (CACHES:).`,
    38	    "",
    39	  ];
    40	
    41	  const locationLines = [
    42	    "## Memory locations (F1, F2)",
    43	    "",
    44	    "| location | path | state |",
    45	    "|---|---|---|",
    46	    ...locations.map(
    47	      (one) =>
    48	        `| ${one.name} | \`${one.path}\` | ${one.present ? "present" : "absent"}${
    49	          one.present && one.children !== null ? ` (${one.children} item(s))` : ""
    50	        } |`,
    51	    ),
    52	    "",
    53	  ];
    54	
    55	  const section = (title: string, list: readonly RequirementResult[]): string[] =>
    56	    list.length === 0 ? [] : [`## ${title}`, "", ...list.map(line), ""];
    57	
    58	  const body = [
    59	    ...head,
    60	    ...locationLines,
    61	    "## The tool's own requirements",
    62	    "",
    63	    ...own.map(line),
    64	    "",
    65	    ...section("Results — MUST", sot.filter((one) => one.level === "MUST").sort(byLevelThenId)),
    66	    ...section("Results — SHOULD", sot.filter((one) => one.level === "SHOULD").sort(byLevelThenId)),
    67	    ...section("Results — guidance", sot.filter((one) => one.level === "guidance").sort(byLevelThenId)),
    68	    ...section("Results — CACHES.md Core requirements (no level in CACHES.md)", caches.sort(byLevelThenId)),
    69	    ...needsReviewer(results),
    70	    ...notes(run),
    71	    "## This run",
    72	    "",
    73	    `- Report ${outFile ? `written to ${outFile}` : "printed to stdout (no --out)"}`,
    74	    "- Read only: nothing was created, changed or deleted except the report; every git call used GIT_OPTIONAL_LOCKS=0 (F3)",
    75	    "- The session-start hook is not installed: R2 leaves that harness change to the owner (R12.3)",
    76	    "- Not calibrated on a real project: no project has been named to calibrate against (design-decisions.md 15)",
    77	    `- Counts: ${count(results, "fail")} fail, ${count(results, "pass")} pass, ${count(results, "needs a reviewer")} needs a reviewer, ${count(results, "not applicable")} not applicable, ${count(results, "could not run")} could not run`,
    78	    "- CACHES.md gives its requirements no level, so none of them gates the exit code (R3 counts MUSTs only)",
    79	    "",
    80	  ];
    81	  return body.join("\n");
    82	}
