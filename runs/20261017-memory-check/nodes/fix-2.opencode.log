   118	        if not line or line[0].isspace():
   119	            continue
   120	        key, separator, value = line.partition(":")
   121	        name = key.strip()
   122	        if separator and name in ("id", "kind", "status"):
   123	            fields[name] = unquote(value)
   124	    return fields, end, None
