   127	function nameStatus(root: string, range: string | null): { renames: Rename[]; deletions: Deletion[] } {
   128	  const args = ["log", ...(range ? [range] : []), "--format=%x01%H", "-M", "--name-status", "--", ENTRIES];
   129	  const renames: Rename[] = [];
