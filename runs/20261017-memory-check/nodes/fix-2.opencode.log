   255	/** The git half of W1.1a and W1.1b: an entry file renamed to another prefix, or to another id. */
   256	export function checkRenames(
   257	  snapshot: SnapshotInfo,
   258	): { prefixes: ClauseOutcome; ids: ClauseOutcome } {
   259	  if (snapshot.shallow) {
   260	    const couldNotRun = SHALLOW;
   261	    return {
   262	      prefixes: { breaks: [], clean: "", couldNotRun },
   263	      ids: { breaks: [], clean: "", couldNotRun },
   264	    };
   265	  }
   266	  const renames = entryRenames(snapshot.root, snapshot.range);
   267	  const prefixBreaks: string[] = [];
   268	  const idBreaks: string[] = [];
   269	  const skipped: string[] = [];
   270	  for (const rename of renames) {
   271	    const from = nameParts(rename.from.slice(rename.from.lastIndexOf("/") + 1));
   272	    const to = nameParts(rename.to.slice(rename.to.lastIndexOf("/") + 1));
   273	    const commit = `commit ${short(rename.commit)} renamed ${rename.from} → ${rename.to}`;
   274	    if (from.prefix !== to.prefix) {
   275	      prefixBreaks.push(`${commit} — the prefix changed from ${from.prefix} to ${to.prefix}; an entry's kind never changes`);
   276	    }
   277	    if (from.id === null || to.id === null) {
   278	      skipped.push(`${commit} — the name is not <prefix>-<id>-<slug>.md, so no id was compared (W1.1c is a reviewer's)`);
   279	      continue;
   280	    }
   281	    if (from.id !== to.id) {
   282	      idBreaks.push(`${commit} — the id changed from ${from.id} to ${to.id}; an id never changes`);
   283	    }
   284	  }
   285	  const how = `git log -M --name-status -- project-memory/entries (${snapshot.range}): ${renames.length} rename(s)`;
