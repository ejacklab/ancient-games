   288	        Check("Open unknowns", "codex/agy/qwen execute a task", UNKNOWN,
   289	              "canary required (spends quota; needs the person's go-ahead)",
   290	              "docs/EXECUTOR_KINDS.md canary piece"),
   291	    ]
   292	
   293	
   294	def gather(args: argparse.Namespace) -> list[Check]:
   295	    home, cwd = Path.home(), Path.cwd()
   296	    binaries = list(dict.fromkeys(DEFAULT_BINARIES + list(args.require or [])))
   297	    with ThreadPoolExecutor(max_workers=max(1, min(8, len(binaries)))) as ex:
   298	        checks: list[Check] = list(ex.map(check_binary, binaries))
   299	    checks.append(check_codex_cache())
   300	    checks.append(check_agy_login(args.net))
   301	    checks.append(check_qwen_config(home))
   302	    for label, p in [("claude skills (user)", home / ".claude" / "skills"),
   303	                     ("agents skills (cross-tool)", home / ".agents" / "skills"),
   304	                     ("codex skills (user)", home / ".codex" / "skills"),
   305	                     ("qwen skills (user)", home / ".qwen" / "skills"),
   306	                     ("project skills", cwd / ".claude" / "skills")]:
   307	        checks.append(check_dir_listing("Skills and workflows", label, p))
   308	    checks.append(check_dir_listing("Skills and workflows", "workflow scripts",
   309	                                    Path(args.workflows) if args.workflows else cwd / ".claude" / "workflows"))
   310	    if args.blueprint:
   311	        checks.append(check_blueprint(Path(args.blueprint)))
   312	    checks.append(check_instruction_files(cwd))
   313	    checks.append(check_qwen_memory(home))
   314	    checks.append(check_claude_history(home))
   315	    checks.extend(check_mcp(home, cwd))
   316	    checks.append(check_machine(cwd))
   317	    checks.extend(open_unknowns())
   318	    checks.sort(key=lambda c: GROUPS.index(c.group))
   319	    return checks
   320	
   321	
   322	def exit_code(checks: list[Check], requires: list[str]) -> int:
   323	    missing = {c.item for c in checks if c.status == MISSING}
   324	    known = {c.item for c in checks}
   325	    for r in requires:
   326	        if r in missing or r not in known:
   327	            return 1
   328	    for c in checks:  # an explicitly named --blueprint dir that is not there is a hard fail
   329	        if c.item.startswith("blueprint (") and c.status == MISSING:
   330	            return 1
   331	    return 0
   332	
   333	
   334	def cell(text: str) -> str:
   335	    return text.replace("|", "\\|")
   336	
   337	
   338	def to_markdown(checks: list[Check]) -> str:
   339	    lines = [f"# Readiness tools check — {date.today().isoformat()} — {socket.gethostname()}", "",
   340	             "Installed and logged in only; no canary was run, no quota spent.", ""]
   341	    current = None
   342	    for c in checks:
   343	        if c.group != current:
   344	            if current is not None:
   345	                lines.append("")
   346	            current = c.group
   347	            lines += [f"## {current}", "", "| Item | Status | Detail | Proof |", "|---|---|---|---|"]
   348	        lines.append(f"| {cell(c.item)} | {c.status} | {cell(c.detail)} | {cell(c.proof)} |")
   349	    return "\n".join(lines) + "\n"
   350	
   351	
   352	def self_test() -> int:
   353	    fake = "readiness-selftest-fake-tool"
   354	    c = check_binary(fake)
   355	    code = exit_code([c], [fake])
   356	    if c.status == MISSING and code == 1:
   357	        print(f"self-test PASS: `{fake}` reported MISSING and --require on it exits 1 — the check can fail.")
   358	        return 0
   359	    print(f"self-test FAIL: status={c.status}, exit code={code} (expected MISSING, 1)")
   360	    return 1
   361	
   362	
   363	def main(argv: list[str] | None = None) -> int:
   364	    ap = argparse.ArgumentParser(description="Method 3.1 readiness inventory (no quota spent).")
   365	    ap.add_argument("--net", action="store_true",
   366	                    help="also run network checks (`agy models`); off by default")
   367	    ap.add_argument("--json", action="store_true", help="JSON instead of markdown")
   368	    ap.add_argument("--require", action="append", default=[],
   369	                    help="tool that must be verified present; exit 1 if MISSING (repeatable)")
   370	    ap.add_argument("--blueprint", metavar="DIR", help="a product's blueprint directory to include")
   371	    ap.add_argument("--workflows", metavar="DIR", help="workflow scripts directory (default .claude/workflows)")
   372	    ap.add_argument("--self-test", action="store_true", help="prove the check can fail, then exit")
   373	    args = ap.parse_args(argv)
   374	    if args.self_test:
   375	        return self_test()
   376	    checks = gather(args)
   377	    if args.json:
   378	        print(json.dumps({"date": date.today().isoformat(), "host": socket.gethostname(),
   379	                          "checks": [asdict(c) for c in checks]}, indent=1))
   380	    else:
   381	        print(to_markdown(checks), end="")
   382	    return exit_code(checks, args.require)
   383	
   384	
   385	if __name__ == "__main__":
   386	    sys.exit(main())

