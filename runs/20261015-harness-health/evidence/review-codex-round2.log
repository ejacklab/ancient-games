   183	def apply_help(box, help_: dict):
   184	    """Apply a snippet exactly as its help text says: merge JSON into the file; a TOML top-level line above the
   185	    first [table], replacing that key's line if there is one."""
   186	    path = resolve(box, help_["file"])
   187	    if help_["lang"] == "json":
   188	        old = json.loads(path.read_text()) if path.exists() else {}
   189	        write(path, json.dumps(merge(old, json.loads(help_["snippet"]))))
   190	    else:
   191	        key = help_["snippet"].split("=")[0].strip()
   192	        lines = [l for l in (path.read_text().splitlines() if path.exists() else [])
   193	                 if not re.match(rf"\s*{key}\s*=", l)]
   194	        first_table = next((i for i, l in enumerate(lines) if l.lstrip().startswith("[")), len(lines))
   195	        write(path, "\n".join(lines[:first_table] + [help_["snippet"]] + lines[first_table:]) + "\n")
