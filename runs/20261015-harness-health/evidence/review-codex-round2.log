   150	def context_lines(w: Where) -> list[Finding]:
   151	    out = []
   152	    project = [w.cwd / n for n in ("CLAUDE.md", "AGENTS.md", "QWEN.md", "GEMINI.md")]
   153	    found = [p.name for p in project if p.is_file()]
   154	    if found:
   155	        out.append(Finding(1, "-", "project instruction file", VERIFIED, "present", ", ".join(found), "."))
   156	    else:
   157	        f = Finding(1, "-", "project instruction file", VERIFIED, "absent",
   158	                    "none of CLAUDE.md, AGENTS.md, QWEN.md, GEMINI.md in the project", ".")
   159	        f.help = Help("./AGENTS.md", "gives every harness one short, durable entry point; the bootstrap skill writes "
   160	                      "one from the project's blueprint")
   161	        out.append(f)
   162	    for p in project + [w.claude / "CLAUDE.md", w.codex / "AGENTS.md"]:
   163	        if p.is_file():
   164	            try:
   165	                text = p.read_text(errors="replace")
   166	            except OSError as e:
   167	                out.append(Finding(1, "-", w.show(p), UNKNOWN, "unknown", f"unreadable: {type(e).__name__}", w.show(p)))
   168	                continue
   169	            out.append(Finding(1, "-", w.show(p), VERIFIED, "measured",
   170	                               f"{len(text.splitlines())} lines, {len(text.encode())} bytes", w.show(p)))
   171	    return out
