   359	
   360	def unverified_lines(installed: set[str]) -> list[Finding]:
   361	    return [Finding(6, h, "permissions and sandbox", UNKNOWN, "unknown",
   362	                    "config format not verified for this harness; prove key names on the installed version first",
   363	                    "harness_health.py docstring") for h in ("agy", "qwen", "dsh", "opencode") if h in installed]
   364	
   365	
   366	# --- gather, render ---------------------------------------------------------------------------------------------
   367	
   368	def gather(home: Path, cwd: Path, env: dict, scripts: Path = SCRIPTS) -> list[Finding]:
   369	    installed = {h for h in HARNESSES if shutil.which(h, path=env.get("PATH"))}
   370	    w = Where(home, cwd, env)
   371	    lines = [Finding(0, h, "installed", VERIFIED if h in installed else MISSING, "-",
   372	                     "on PATH" if h in installed else "not on PATH", f"`command -v {h}`") for h in HARNESSES]
   373	    lines += context_lines(w)
   374	    lines += covered_lines(scripts)
   375	    lines += memory_and_log_lines(w, installed)
   376	    lines.append(engine_kind_line(installed))
   377	    if "claude" in installed:
   378	        lines += claude_lines(w)
   379	    if "codex" in installed:
   380	        lines += codex_lines(w)
   381	    lines += unverified_lines(installed)
   382	    return sorted(lines, key=lambda f: f.req)
   383	
   384	
   385	def select(lines: list[Finding], harnesses: list[str]) -> list[Finding]:
   386	    return [f for f in lines if not harnesses or f.harness in ("-", *harnesses)]
   387	
   388	
   389	def to_markdown(lines: list[Finding]) -> str:
   390	    out = [f"# Harness health — {date.today().isoformat()} — {socket.gethostname()}", "",
   391	           "Configured is not enforced: each line reads what a config file says; none proves the harness enforces "
   392	           "it. Nothing was changed; no quota spent.", "", "## Ten requirements", "",
   393	           "| # | Requirement | " + " | ".join(FINDINGS) + " |", "|---|---|" + "---|" * len(FINDINGS)]
   394	    for n, name in REQUIREMENTS.items():
   395	        counts = [sum(1 for f in lines if f.req == n and f.finding == k) for k in FINDINGS]
   396	        out.append(f"| R{n} | {name} | " + " | ".join(str(c) for c in counts) + " |")
   397	    out += ["", "## Lines", "", "| # | Harness | Item | Status | Finding | Detail | Proof |",
   398	            "|---|---|---|---|---|---|---|"]
   399	    for f in lines:
   400	        out.append(f"| {'R' + str(f.req) if f.req else '—'} | {f.harness} | {cell(f.item)} | {f.status} | "
   401	                   f"{f.finding} | {cell(f.detail)} | {cell(f.proof)} |")
   402	    helps = [f for f in lines if f.help]
   403	    out += ["", "## Help", ""]
   404	    if not helps:
   405	        out.append("Nothing absent.")
   406	    for f in helps:
   407	        out += [f"### R{f.req} · {f.harness} · {f.item}", "", f"- File: `{f.help.file}`",
   408	                f"- What it changes: {f.help.changes}"]
   409	        if f.help.snippet:
   410	            out += [f"- How: {f.help.how}", "", f"```{f.help.lang}", f.help.snippet, "```"]
   411	        out.append("")
   412	    out.append("You apply any change; this script changed nothing.")
   413	    return "\n".join(out) + "\n"
   414	
   415	
   416	def self_test() -> int:
   417	    """A settings file with no deny list must come out `absent` — the check can fail."""
   418	    with tempfile.TemporaryDirectory() as td:
   419	        home, cwd = Path(td) / "home", Path(td) / "proj"
   420	        (home / ".claude").mkdir(parents=True)
   421	        cwd.mkdir()
   422	        w = Where(home, cwd, {})
   423	        (home / ".claude" / "settings.json").write_text('{"permissions": {"allow": ["Bash(ls:*)"]}}')
   424	        bad = [f.finding for f in claude_lines(w) if f.item == "deny rules"]
   425	        (home / ".claude" / "settings.json").write_text('{"permissions": {"deny": ["Read(./.env)"]}}')
   426	        good = [f.finding for f in claude_lines(w) if f.item == "deny rules"]
   427	    if bad == ["absent"] and good == ["present"]:
   428	        print("self-test PASS: no deny list → absent, a deny list → present — the check can fail.")
   429	        return 0
   430	    print(f"self-test FAIL: bad={bad} good={good}")
   431	    return 1
   432	
   433	
   434	def main(argv: list[str] | None = None) -> int:
   435	    ap = argparse.ArgumentParser(description="Harness health for method 3.1 (no quota spent; a run only reads).")
   436	    ap.add_argument("--harness", action="append", default=[], choices=HARNESSES,
   437	                    help="narrow the lines and help to this harness (repeatable); exit 1 if it is not installed")
   438	    ap.add_argument("--json", action="store_true", help="JSON instead of markdown")
   439	    ap.add_argument("--self-test", action="store_true", help="prove the check can fail, then exit")
   440	    args = ap.parse_args(argv)
   441	    if args.self_test:
   442	        return self_test()
   443	    lines = select(gather(Path.home(), Path.cwd(), dict(os.environ)), args.harness)
   444	    if args.json:
   445	        print(json.dumps({"date": date.today().isoformat(), "host": socket.gethostname(),
   446	                          "findings": [asdict(f) for f in lines]}, indent=1))
   447	    else:
   448	        print(to_markdown(lines), end="")
   449	    missing = [f for f in lines if f.item == "installed" and f.harness in args.harness and f.status == MISSING]
   450	    return 1 if missing else 0
   451	
   452	
   453	if __name__ == "__main__":
   454	    sys.exit(main())

