   321	# --- Codex -----------------------------------------------------------------------------------------------------
   322	
   323	def codex_lines(w: Where) -> list[Finding]:
   324	    p = w.codex / "config.toml"
   325	    rc, out = run_cmd(["codex", "--version"])
   326	    version = out.split()[-1] if rc == 0 and out else "?"
   327	    status = VERIFIED if version == CODEX_VERIFIED_ON else REPORTED
   328	    basis = f"key names verified on {CODEX_VERIFIED_ON}" + ("" if status == VERIFIED else f"; installed {version}")
   329	    where = w.show(p)
   330	    if p.exists():
   331	        try:
   332	            d = tomllib.loads(p.read_text())
   333	        except (OSError, ValueError) as e:  # TOMLDecodeError and UnicodeDecodeError are ValueErrors
   334	            return [Finding(6, "codex", "config", UNKNOWN, "unknown", f"{where} unreadable: {type(e).__name__}", where)]
   335	    else:
   336	        d = {}
   337	    note = "; profiles and -c flags may override (not read)" if "profiles" in d else ""
   338	    how = f"a top-level line in {where}, above the first [table]; replace the line if the key is already set"
   339	    lines = []
   340	    for req, key, allowed, bad, fix, changes in [
   341	            (6, "sandbox_mode", CODEX_SANDBOX, "danger-full-access", "workspace-write",
   342	             "commands run in Codex's sandbox: writes limited to the workspace"),
   343	            (8, "approval_policy", CODEX_APPROVAL, "never", "on-request",
   344	             "Codex asks the person before commands it may not run on its own")]:
   345	        v = d.get(key)
   346	        help_ = Help(where, changes, f'{key} = "{fix}"', "toml", how)
   347	        if v is None:
   348	            lines.append(Finding(req, "codex", key, status, "absent",
   349	                                 f"not set: Codex's built-in default applies (not checked); {basis}{note}", where, help_))
   350	        elif not isinstance(v, str) or v not in allowed:
   351	            lines.append(Finding(req, "codex", key, status, "unknown",
   352	                                 f"not a value Codex accepts (not shown); {basis}{note}", where))
   353	        elif v == bad:
   354	            lines.append(Finding(req, "codex", key, status, "absent", f"{v}; {basis}{note}", where, help_))
   355	        else:
   356	            lines.append(Finding(req, "codex", key, status, "present", f"{v}; {basis}{note}", where))
   357	    return lines
