    78	
    79	def first_line(out: str) -> str:
    80	    return out.splitlines()[0][:100] if out else "(no output)"
    81	
    82	
    83	def probe_binary(name: str) -> Probe:
    84	    """The version of the binary **on PATH**.
    85	
    86	    That is NOT necessarily the binary that will make a call: a provider can bundle its own, older copy of an
    87	    engine, and the two do not accept the same model names (docs/EXECUTOR_KINDS.md, "The bundled-runtime trap").
    88	    This line is the most likely thing in the inventory to be misread as proof for a provider call, so the canary
    89	    records the version of the binary that actually ran.
    90	    """
    91	    rc, out = run_cmd([name, "--version"])
    92	    proof = f"`{name} --version`"
    93	    if rc is None:
    94	        return Probe("Tools", name, MISSING, "not on PATH", f"`command -v {name}`")
    95	    if rc == "timeout":
    96	        return Probe("Tools", name, UNKNOWN, out, proof)
    97	    if rc == 0:
    98	        return Probe("Tools", name, VERIFIED, first_line(out), proof)
    99	    return Probe("Tools", name, UNKNOWN, f"exit {rc}: {first_line(out)}", proof)
