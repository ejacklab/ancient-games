   132	def probe_agy_login(net: bool) -> Probe:
   133	    item = "agy login (model list)"
   134	    proof = "`agy models` (network)"
   135	    if not net:
   136	        return Probe("Models and logins", item, UNKNOWN,
   137	                     "offline run: not provable without `agy models`; rerun with --net", proof)
   138	    rc, out = run_cmd(["agy", "models"], timeout=NET_TIMEOUT)
   139	    if rc is None:
   140	        return Probe("Models and logins", item, MISSING, "agy not on PATH", "`agy --version`")
   141	    if rc == "timeout":
   142	        return Probe("Models and logins", item, UNKNOWN, out, proof)
   143	    ids = [l.split()[0] for l in out.splitlines()
   144	           if l.split() and not l.lower().startswith("fetching")
   145	           and not l.split()[0].endswith(":")]  # a label line ("Fetching…", "error: …") is not a model id
   146	    if rc == 0 and ids:
   147	        return Probe("Models and logins", item, VERIFIED,
   148	                     f"{len(ids)} models: {', '.join(ids[:4])} …", proof)
   149	    return Probe("Models and logins", item, UNKNOWN, f"exit {rc}: {first_line(out)}", proof)
