    90	def markdown_checks(text):
    91	    checks = []
    92	    group = None
    93	    for line in text.splitlines():
    94	        if line.startswith("## "):
    95	            group = line[3:]
    96	        elif line.startswith("| ") and not line.startswith("| Item |"):
    97	            cells = [cell.strip() for cell in re.split(r"(?<!\\)\|", line)[1:-1]]
    98	            assert len(cells) == 4, line
    99	            checks.append(dict(zip(("group", "item", "status", "detail", "proof"),
   100	                                   [group, *cells])))
   101	    return checks
