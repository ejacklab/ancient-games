    56	@dataclass
    57	class Probe:
    58	    group: str
    59	    item: str
    60	    status: str
    61	    detail: str
    62	    proof: str
    63	
    64	
    65	def run_cmd(cmd: list[str], timeout: int = CMD_TIMEOUT) -> tuple:
    66	    """(returncode, stripped output). rc is None if the binary does not exist,
    67	    'timeout' if it did not answer in time."""
    68	    try:
    69	        p = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout)
    70	    except FileNotFoundError:
    71	        return None, "not on PATH"
    72	    except subprocess.TimeoutExpired:
    73	        return "timeout", f"no answer within {timeout}s"
    74	    except OSError as e:
    75	        return None, str(e)
    76	    return p.returncode, ((p.stdout or "").strip() or (p.stderr or "").strip())
