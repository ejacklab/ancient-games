   208	
   209	# --- Claude Code -----------------------------------------------------------------------------------------------
   210	
   211	def claude_lines(w: Where) -> list[Finding]:
   212	    scopes = [("user", w.claude / "settings.json"), ("project", w.cwd / ".claude" / "settings.json"),
   213	              ("local", w.cwd / ".claude" / "settings.local.json")]
   214	    rc, out = run_cmd(["claude", "--version"])
   215	    version = out.split()[0] if rc == 0 and out else "?"
   216	    basis = f"key names from the {CLAUDE_KEYS_FROM} binary; installed {version}"
   217	    proof = ", ".join(w.show(p) for _, p in scopes)
   218	    project_file = w.show(scopes[1][1])
   219	    loaded = []
   220	    for scope, p in scopes:
   221	        d, why = load_json(p)
   222	        if d is None:
   223	            return [Finding(6, "claude", "settings", UNKNOWN, "unknown", f"{w.show(p)} {why}", w.show(p))]
   224	        loaded.append((scope, p, d))
   225	
   226	    def at(d, key_path):
   227	        for k in key_path:
   228	            d = d.get(k) if isinstance(d, dict) else None
   229	        return d
   230	
   231	    def effective(key_path):
   232	        """(value, scope, shown path) from the most specific scope that sets it: local > project > user."""
   233	        for scope, p, d in reversed(loaded):
   234	            v = at(d, key_path)
   235	            if v is not None:
   236	                return v, scope, w.show(p)
   237	        return None, None, project_file
   238	
   239	    def line(req, item, finding, detail, help_=None):
   240	        return Finding(req, "claude", item, REPORTED, finding, f"{detail}; {basis}", proof, help_)
   241	
   242	    lines = []
   243	    # R6 deny rules add up across scopes; only non-empty strings are rules
   244	    deny = []
   245	    for s, _, d in loaded:
   246	        rules = at(d, ("permissions", "deny"))
   247	        n = sum(1 for r in rules if isinstance(r, str) and r.strip()) if isinstance(rules, list) else 0
   248	        if n:
   249	            deny.append((s, n))
   250	    if deny:
   251	        lines.append(line(6, "deny rules", "present", ", ".join(f"{n} in {s}" for s, n in deny)))
   252	    else:
   253	        lines.append(line(6, "deny rules", "absent", "no deny rule in any scope", Help(
   254	            project_file, "blocks the listed tools/paths outright, whatever is allowed elsewhere. The two rules are "
   255	            "examples from Claude Code's settings docs — replace them with what this project must never touch",
   256	            json.dumps({"permissions": {"deny": ["Read(./.env)", "Read(./secrets/**)"]}}, indent=2), "json",
   257	            JSON_HOW)))
   258	
   259	    # R6 sandbox
   260	    v, scope, where = effective(("sandbox", "enabled"))
   261	    if v is True:
   262	        lines.append(line(6, "sandbox", "present", f"sandbox.enabled true ({scope})"))
   263	    elif v is None or v is False:
   264	        lines.append(line(6, "sandbox", "absent", f"sandbox.enabled {'false (' + scope + ')' if v is False else 'not set'}",
   265	                          Help(where, "runs Bash commands inside Claude Code's OS sandbox (filesystem and network "
   266	                               "limits)", json.dumps({"sandbox": {"enabled": True}}, indent=2), "json", JSON_HOW)))
   267	    else:
   268	        lines.append(line(6, "sandbox", "unknown", f"sandbox.enabled is not true/false ({scope})"))
   269	
   270	    # R8 permission mode — does a person approve what no rule allows?
   271	    v, scope, where = effective(("permissions", "defaultMode"))
   272	    if v is None:
   273	        lines.append(line(8, "permission mode", "present", "defaultMode not set (default: a person is asked)"))
   274	    elif isinstance(v, str) and v in CLAUDE_ASKS:
   275	        lines.append(line(8, "permission mode", "present", f"defaultMode {v} ({scope}): a person is asked"))
   276	    elif isinstance(v, str) and v in CLAUDE_NO_PERSON:
   277	        lines.append(line(8, "permission mode", "absent", f"defaultMode {v} ({scope}): {CLAUDE_NO_PERSON[v]}", Help(
   278	            where, "a person is asked before any action no rule allows",
   279	            json.dumps({"permissions": {"defaultMode": "default"}}, indent=2), "json", JSON_HOW)))
   280	    else:
   281	        lines.append(line(8, "permission mode", "unknown", f"defaultMode not a recognised mode (not shown) ({scope})"))
   282	
   283	    # R8 the prompt before entering bypass mode
   284	    v, scope, where = effective(("skipDangerousModePermissionPrompt",))
   285	    if v is True:
   286	        lines.append(line(8, "bypass-mode prompt", "absent", f"skipDangerousModePermissionPrompt true ({scope})", Help(
   287	            where, "asks the person before a session enters bypass-permissions mode",
   288	            json.dumps({"skipDangerousModePermissionPrompt": False}, indent=2), "json", JSON_HOW)))
   289	    elif v is None or v is False:
   290	        lines.append(line(8, "bypass-mode prompt", "present", "not skipped"))
   291	    else:
   292	        lines.append(line(8, "bypass-mode prompt", "unknown", f"skipDangerousModePermissionPrompt not true/false ({scope})"))
   293	
   294	    # R10 hooks: an event counts when it holds at least one hook with a command; names shown only if recognised
   295	    def has_command(groups):
   296	        return isinstance(groups, list) and any(
   297	            isinstance(g, dict) and isinstance(g.get("hooks"), list) and any(
   298	                isinstance(h, dict) and isinstance(h.get("command"), str) and h["command"].strip()
   299	                for h in g["hooks"]) for g in groups)
   300	
   301	    disabled, scope, where = effective(("disableAllHooks",))
   302	    events = {e for _, _, d in loaded if isinstance(d.get("hooks"), dict)
   303	              for e, groups in d["hooks"].items() if has_command(groups)}
   304	    named = sorted(e for e in events if e in CLAUDE_HOOK_EVENTS)
   305	    others = len(events) - len(named)
   306	    if disabled is True:
   307	        lines.append(line(10, "hooks", "absent", f"disableAllHooks true ({scope}): no hook runs", Help(
   308	            where, "lets the configured hooks run again", json.dumps({"disableAllHooks": False}, indent=2), "json",
   309	            JSON_HOW)))
   310	    elif named:
   311	        lines.append(line(10, "hooks", "present",
   312	                          f"events: {', '.join(named)}" + (f"; {others} unrecognised (not shown)" if others else "")))
   313	    else:
   314	        lines.append(line(10, "hooks", "absent", "no hook with a command for a recognised event" +
   315	                          (f"; {others} unrecognised (not shown)" if others else ""), Help(
   316	            project_file, "a hook is how a recorded mistake becomes a check that runs every time (e.g. a "
   317	            "UserPromptSubmit or Stop hook); the command is the project's to write")))
   318	    return lines
   319	
