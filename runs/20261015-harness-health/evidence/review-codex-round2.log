   195	
   196	def engine_kind_line(installed: set[str]) -> Finding:
   197	    kinds = sorted(installed)
   198	    if len(kinds) >= 2:  # two is what "a reviewer that is not the builder" means, not a chosen threshold
   199	        return Finding(5, "-", "engine kinds on PATH", VERIFIED, "present",
   200	                       f"{len(kinds)}: {', '.join(kinds)} (installed, not canary-proved)", "`command -v`")
   201	    f = Finding(5, "-", "engine kinds on PATH", VERIFIED, "absent",
   202	                f"{len(kinds)}: {', '.join(kinds) or 'none'} — a builder's work cannot get a different-kind reviewer",
   203	                "`command -v`")
   204	    f.help = Help("-", "install and canary-prove a second engine kind (docs: executor-kinds), or plan every "
   205	                       "building node's review as a script check")
   206	    return f
