   127	# --- per-run requirements: covered by the method's own scripts -------------------------------------------------
   128	
   129	COVERED = [(2, "engine adapters with pinned flags", "engines.py"), (2, "dispatcher", "dispatch.py"),
   130	           (3, "design gate", "design_gate.py"), (4, "run state template", "../assets/templates/state.md"),
   131	           (5, "build gate (tests, scope, tamper)", "feature_gate.py"), (7, "timers and bounded repair", "dispatch.py"),
   132	           (9, "run event log", "runlog.py"), (9, "token harvest", "harvest_run.py")]
   133	
   134	
   135	def covered_lines(scripts: Path) -> list[Finding]:
   136	    """The script exists — not that the gate it names works; that is the gate's own tests' job."""
   137	    out = []
   138	    for req, what, rel in COVERED:
   139	        p = (scripts / rel).resolve()
   140	        name = Path(rel).name
   141	        if p.is_file():
   142	            out.append(Finding(req, "-", what, VERIFIED, "covered", f"per run, by {name}", name))
   143	        else:
   144	            out.append(Finding(req, "-", what, MISSING, "unknown", f"{name} not found beside this script", name))
   145	    return out
