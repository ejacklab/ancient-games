   178	        mem = proj / "memory"
   179	        n = len(list(mem.glob("*.md"))) if mem.is_dir() else 0
   180	        out.append(Finding(4, "claude", "project memory", REPORTED, "measured",
   181	                           f"{n} memory files" if mem.is_dir() else "no memory folder for this project", w.show(mem)))
   182	        n = len(list(proj.glob("*.jsonl"))) if proj.is_dir() else 0
   183	        out.append(Finding(9, "claude", "session transcripts", REPORTED, "measured",
   184	                           f"{n} session logs for this project", w.show(proj)))
   185	    if "codex" in installed:
   186	        p = w.codex / "sessions"
   187	        out.append(Finding(9, "codex", "session rollouts", VERIFIED, "measured",
   188	                           "folder present" if p.is_dir() else "no sessions folder", w.show(p)))
   189	    if "dsh" in installed:
   190	        p = w.home / ".dsh" / "sessions"
   191	        out.append(Finding(9, "dsh", "sessions", VERIFIED, "measured",
   192	                           "folder present" if p.is_dir() else "no sessions folder", w.show(p)))
