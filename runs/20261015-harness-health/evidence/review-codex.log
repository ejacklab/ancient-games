     1	#!/usr/bin/env python3
     2	"""readiness.py — the standard tool inventory for method 3.1 (readiness).
     3	
     4	Proves what is installed and logged in on this machine. It never spends quota:
     5	no canary is run, so "executes a task" stays unknown here and remains an
     6	explicit, separately approved step (docs/EXECUTOR_KINDS.md in the Ancient Games
     7	repo). Every line carries a status and the command or path that proved it:
     8	
     9	  verified  a command run just now proved it
    10	  reported  a local file claims it (may be stale)
    11	  unknown   not provable on this machine
    12	  MISSING   expected and not there
    13	
    14	Generic by design (the skill is global): nothing hardcodes a project. Project
    15	extras come in through flags (--blueprint, --workflows).
    16	
    17	Usage:
    18	  readiness.py [--net] [--json] [--require TOOL ...] [--blueprint DIR]
    19	               [--workflows DIR] [--self-test]
    20	
    21	Exit codes: 0 ok · 1 a --require'd tool that is not verified, or an explicit --blueprint dir that is
    22	MISSING · 2 usage error.
    23	"""
    24	from __future__ import annotations
    25	
    26	import argparse
    27	import json
    28	import os
    29	import shutil
    30	import socket
    31	import subprocess
    32	import sys
    33	from concurrent.futures import ThreadPoolExecutor
    34	from dataclasses import asdict, dataclass
    35	from datetime import date, datetime, timezone
    36	from pathlib import Path
    37	
    38	CMD_TIMEOUT = 10   # seconds per local command
    39	NET_TIMEOUT = 30   # seconds for --net commands (agy models talks to the network)
    40	DEFAULT_BINARIES = ["claude", "codex", "agy", "qwen", "dsh", "opencode", "node", "python3", "git"]
    41	
    42	VERIFIED = "verified"
    43	REPORTED = "reported"
    44	UNKNOWN = "unknown"
    45	MISSING = "MISSING"
    46	
    47	GROUPS = ["Tools", "Models and logins", "Skills and workflows", "Memory", "MCP",
    48	          "Machine", "Open unknowns"]
    49	
    50	# The blueprint's own section files (docs/workflow-templates/blueprint.md); a .md that is not one of these
    51	# is not a section, and a mapless directory is MISSING rather than verified.
    52	SECTION_FILES = {"01-vision.md", "02-requirements.md", "03-domain-model.md", "04-business-logic.md",
    53	                 "05-architecture.md", "06-data-model.md", "07-ui-ux.md", "08-non-functional.md"}
    54	
    55	
    56	@dataclass
    57	class Probe:
    58	    group: str
    59	    item: str
    60	    status: str
    61	    detail: str
    62	    proof: str
    63	
    64	
    65	def run_cmd(cmd: list[str], timeout: int = CMD_TIMEOUT) -> tuple:
    66	    """(returncode, stripped output). rc is None if the binary does not exist,
    67	    'timeout' if it did not answer in time."""
    68	    try:
    69	        p = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout)
    70	    except FileNotFoundError:
    71	        return None, "not on PATH"
    72	    except subprocess.TimeoutExpired:
    73	        return "timeout", f"no answer within {timeout}s"
    74	    except OSError as e:
    75	        return None, str(e)
    76	    return p.returncode, ((p.stdout or "").strip() or (p.stderr or "").strip())
    77	
    78	
    79	def first_line(out: str) -> str:
    80	    return out.splitlines()[0][:100] if out else "(no output)"
    81	
    82	
    83	def probe_binary(name: str) -> Probe:
    84	    """The version of the binary **on PATH**.
    85	
    86	    That is NOT necessarily the binary that will make a call: a provider can bundle its own, older copy of an
    87	    engine, and the two do not accept the same model names (docs/EXECUTOR_KINDS.md, "The bundled-runtime trap").
    88	    This line is the most likely thing in the inventory to be misread as proof for a provider call, so the canary
    89	    records the version of the binary that actually ran.
    90	    """
    91	    rc, out = run_cmd([name, "--version"])
    92	    proof = f"`{name} --version`"
    93	    if rc is None:
    94	        return Probe("Tools", name, MISSING, "not on PATH", f"`command -v {name}`")
    95	    if rc == "timeout":
    96	        return Probe("Tools", name, UNKNOWN, out, proof)
    97	    if rc == 0:
    98	        return Probe("Tools", name, VERIFIED, first_line(out), proof)
    99	    return Probe("Tools", name, UNKNOWN, f"exit {rc}: {first_line(out)}", proof)
   100	
   101	
   102	def probe_codex_cache() -> Probe:
   103	    item = "codex model cache"
   104	    p = Path.home() / ".codex" / "models_cache.json"
   105	    if not p.exists():
   106	        return Probe("Models and logins", item, UNKNOWN, f"no {p}", str(p))
   107	    try:
   108	        d = json.loads(p.read_text())
   109	    except (OSError, ValueError) as e:
   110	        return Probe("Models and logins", item, UNKNOWN, f"unreadable: {e}", str(p))
   111	    if not isinstance(d, dict):
   112	        return Probe("Models and logins", item, UNKNOWN, "unreadable: top level is not a JSON object", str(p))
   113	    models = d.get("models")
   114	    ids: list[str] = []
   115	    if isinstance(models, list):
   116	        for m in models:
   117	            ids.append(str(m.get("id") or m.get("slug") or m.get("name") or "?")
   118	                       if isinstance(m, dict) else str(m))
   119	    elif isinstance(models, dict):
   120	        ids = list(models)
