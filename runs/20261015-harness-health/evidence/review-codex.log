   328	def gather(home: Path, cwd: Path, env: dict, scripts: Path = SCRIPTS) -> list[Finding]:
   329	    installed = {h for h in HARNESSES if shutil.which(h, path=env.get("PATH"))}
   330	    claude_dir = Path(env["CLAUDE_CONFIG_DIR"]) if env.get("CLAUDE_CONFIG_DIR") else home / ".claude"
   331	    codex_dir = Path(env["CODEX_HOME"]) if env.get("CODEX_HOME") else home / ".codex"
   332	    lines = [Finding(0, h, "installed", VERIFIED if h in installed else MISSING, "-",
   333	                     "on PATH" if h in installed else "not on PATH", f"`command -v {h}`") for h in HARNESSES]
   334	    lines += context_lines(home, cwd, claude_dir, codex_dir)
   335	    lines += covered_lines(scripts)
   336	    lines += memory_and_log_lines(home, cwd, claude_dir, codex_dir, installed)
