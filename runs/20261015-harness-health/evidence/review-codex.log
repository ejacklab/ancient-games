   205	    return Probe(group, item, VERIFIED, f"{len(names)}: {shown}", str(p))
   206	
   207	
   208	def probe_blueprint(p: Path) -> Probe:
   209	    item = f"blueprint ({p})"
   210	    if not p.is_dir():
   211	        return Probe("Skills and workflows", item, MISSING, "directory not found", str(p))
   212	    sections = sorted(e.name for e in p.iterdir() if e.is_file() and e.name in SECTION_FILES)
   213	    if not (p / "README.md").is_file():
   214	        return Probe("Skills and workflows", item, MISSING,
   215	                     f"map MISSING, {len(sections)} sections: {', '.join(sections) or 'none'}", str(p))
   216	    if not sections:
   217	        return Probe("Skills and workflows", item, MISSING, "map present, 0 sections", str(p))
   218	    return Probe("Skills and workflows", item, VERIFIED,
   219	                 f"{len(sections)} sections, map present: {', '.join(sections)}", str(p))
   220	
   221	
   222	def probe_instruction_files(cwd: Path) -> Probe:
   223	    names = ["CLAUDE.md", "AGENTS.md", "QWEN.md", "GEMINI.md"]
   224	    present = [n for n in names if (cwd / n).exists()]
   225	    absent = [n for n in names if n not in present]
   226	    detail = (f"present: {', '.join(present) or 'none'}"
   227	              + (f"; absent: {', '.join(absent)}" if absent else ""))
   228	    return Probe("Memory", "project instruction files", VERIFIED, detail, str(cwd))
   229	
   230	
   231	def probe_qwen_memory(home: Path) -> Probe:
   232	    p = home / ".qwen" / "memories"
   233	    idx = p / "MEMORY.md"
   234	    if not p.is_dir():
   235	        return Probe("Memory", "qwen auto-memory (user)", VERIFIED, f"absent ({p})", str(p))
   236	    try:
   237	        n = len(idx.read_text(errors="replace").splitlines()) if idx.exists() else 0
   238	    except OSError as e:
   239	        return Probe("Memory", "qwen auto-memory (user)", UNKNOWN, f"MEMORY.md unreadable: {e}", str(p))
   240	    return Probe("Memory", "qwen auto-memory (user)", VERIFIED,
   241	                 f"{n} index lines in MEMORY.md; project dirs under ~/.qwen/projects/", str(p))
   242	
   243	
   244	def probe_claude_history(home: Path) -> Probe:
   245	    p = home / ".claude" / "projects"
   246	    if not p.is_dir():
   247	        return Probe("Memory", "claude session history", VERIFIED, f"absent ({p})", str(p))
   248	    try:
   249	        n = sum(1 for e in p.iterdir() if e.is_dir())
   250	    except OSError as e:
   251	        return Probe("Memory", "claude session history", UNKNOWN, f"unreadable: {e}", str(p))
   252	    return Probe("Memory", "claude session history", VERIFIED, f"{n} project histories", str(p))
   253	
   254	
   255	def probe_mcp(home: Path, cwd: Path) -> list[Probe]:
   256	    out = []
   257	    sources = [("~/.claude/settings.json", home / ".claude" / "settings.json"),
   258	               ("~/.claude.json", home / ".claude.json"),
   259	               ("~/.qwen/settings.json", home / ".qwen" / "settings.json"),
   260	               (".mcp.json (project)", cwd / ".mcp.json")]
   261	    for label, p in sources:
   262	        if not p.exists():
   263	            out.append(Probe("MCP", label, VERIFIED, "file absent → no servers from it", str(p)))
   264	            continue
   265	        try:
   266	            d = json.loads(p.read_text())
   267	        except (OSError, ValueError) as e:
   268	            out.append(Probe("MCP", label, UNKNOWN, f"unreadable: {e}", str(p)))
   269	            continue
   270	        servers = d.get("mcpServers") if isinstance(d, dict) else None
   271	        if servers:
   272	            out.append(Probe("MCP", label, VERIFIED,
   273	                             f"{len(servers)} servers: {', '.join(list(servers)[:6])}", str(p)))
   274	        else:
   275	            out.append(Probe("MCP", label, VERIFIED,
   276	                             "no mcpServers key" if servers is None else "mcpServers present but empty", str(p)))
   277	    return out
   278	
   279	
   280	def probe_machine(cwd: Path) -> Probe:
   281	    cores = os.cpu_count() or "?"
   282	    mem_gib = "?"
   283	    try:
   284	        for line in Path("/proc/meminfo").read_text().splitlines():
   285	            if line.startswith("MemAvailable:"):
   286	                mem_gib = f"{int(line.split()[1]) / 1048576:.1f} GiB"
   287	                break
   288	    except OSError:
   289	        pass
   290	    du = shutil.disk_usage(cwd)
   291	    return Probe("Machine", "this machine", VERIFIED,
   292	                 f"{cores} cores; {mem_gib} RAM available; {du.free / 2**30:.0f} G free on {cwd}",
   293	                 "`os.cpu_count`, `/proc/meminfo`, `shutil.disk_usage`")
   294	
   295	
   296	def open_unknowns() -> list[Probe]:
   297	    return [
   298	        Probe("Open unknowns", "subagent concurrency limit", UNKNOWN,
   299	              "runtime policy, not provable from outside. Claude Code docs report 20 concurrent, nesting depth 3 "
   300	              "(v2.1.217+, env overrides; reported, not measured here); codex/agy: no figure",
   301	              "docs/EXECUTOR_KINDS.md, Concurrency row"),
   302	        Probe("Open unknowns", "codex/agy/qwen execute a task", UNKNOWN,
   303	              "canary required (spends quota; needs the person's go-ahead)",
   304	              "docs/EXECUTOR_KINDS.md canary piece"),
   305	    ]
   306	
   307	
   308	def gather(args: argparse.Namespace) -> list[Probe]:
   309	    home, cwd = Path.home(), Path.cwd()
   310	    binaries = list(dict.fromkeys(DEFAULT_BINARIES + list(args.require or [])))
   311	    with ThreadPoolExecutor(max_workers=max(1, min(8, len(binaries)))) as ex:
   312	        checks: list[Probe] = list(ex.map(probe_binary, binaries))
   313	    checks.append(probe_codex_cache())
   314	    checks.append(probe_agy_login(args.net))
   315	    checks.append(probe_qwen_config(home))
   316	    for label, p in [("claude skills (user)", home / ".claude" / "skills"),
   317	                     ("agents skills (cross-tool)", home / ".agents" / "skills"),
   318	                     ("codex skills (user)", home / ".codex" / "skills"),
   319	                     ("qwen skills (user)", home / ".qwen" / "skills"),
   320	                     ("project skills", cwd / ".claude" / "skills")]:
   321	        checks.append(probe_dir_listing("Skills and workflows", label, p))
   322	    checks.append(probe_dir_listing("Skills and workflows", "workflow scripts",
   323	                                    Path(args.workflows) if args.workflows else cwd / ".claude" / "workflows"))
   324	    if args.blueprint:
   325	        checks.append(probe_blueprint(Path(args.blueprint)))
   326	    checks.append(probe_instruction_files(cwd))
   327	    checks.append(probe_qwen_memory(home))
   328	    checks.append(probe_claude_history(home))
   329	    checks.extend(probe_mcp(home, cwd))
   330	    checks.append(probe_machine(cwd))
   331	    checks.extend(open_unknowns())
   332	    checks.sort(key=lambda c: GROUPS.index(c.group))
   333	    return checks
   334	
   335	
   336	def exit_code(checks: list[Probe], requires: list[str]) -> int:
   337	    for r in requires:  # a --require'd tool must be VERIFIED: present-but-unproven is not enough
   338	        if not any(c.item == r and c.status == VERIFIED for c in checks):
   339	            return 1
   340	    for c in checks:  # an explicitly named --blueprint dir that is not there is a hard fail
   341	        if c.item.startswith("blueprint (") and c.status == MISSING:
   342	            return 1
   343	    return 0
   344	
   345	
   346	def cell(text: str) -> str:
   347	    return text.replace("|", "\\|")
   348	
   349	
   350	def to_markdown(checks: list[Probe]) -> str:
   351	    lines = [f"# Readiness tools check — {date.today().isoformat()} — {socket.gethostname()}", "",
   352	             "Installed and logged in only; no canary was run, no quota spent.", ""]
   353	    current = None
   354	    for c in checks:
   355	        if c.group != current:
   356	            if current is not None:
   357	                lines.append("")
   358	            current = c.group
   359	            lines += [f"## {current}", "", "| Item | Status | Detail | Proof |", "|---|---|---|---|"]
   360	        lines.append(f"| {cell(c.item)} | {c.status} | {cell(c.detail)} | {cell(c.proof)} |")
   361	    return "\n".join(lines) + "\n"
   362	
   363	
   364	def self_test() -> int:
   365	    fake = "readiness-selftest-fake-tool"
   366	    c = probe_binary(fake)
   367	    code = exit_code([c], [fake])
   368	    if c.status == MISSING and code == 1:
   369	        print(f"self-test PASS: `{fake}` reported MISSING and --require on it exits 1 — the check can fail.")
   370	        return 0
   371	    print(f"self-test FAIL: status={c.status}, exit code={code} (expected MISSING, 1)")
   372	    return 1
   373	
   374	
   375	def main(argv: list[str] | None = None) -> int:
   376	    ap = argparse.ArgumentParser(description="Method 3.1 readiness inventory (no quota spent).")
   377	    ap.add_argument("--net", action="store_true",
   378	                    help="also run network checks (`agy models`); off by default")
   379	    ap.add_argument("--json", action="store_true", help="JSON instead of markdown")
   380	    ap.add_argument("--require", action="append", default=[],
   381	                    help="tool that must be verified present; exit 1 if not verified (repeatable)")
   382	    ap.add_argument("--blueprint", metavar="DIR", help="a product's blueprint directory to include")
   383	    ap.add_argument("--workflows", metavar="DIR", help="workflow scripts directory (default .claude/workflows)")
   384	    ap.add_argument("--self-test", action="store_true", help="prove the check can fail, then exit")
   385	    args = ap.parse_args(argv)
   386	    if args.self_test:
   387	        return self_test()
   388	    checks = gather(args)
   389	    if args.json:
   390	        print(json.dumps({"date": date.today().isoformat(), "host": socket.gethostname(),
   391	                          "checks": [asdict(c) for c in checks]}, indent=1))
   392	    else:
   393	        print(to_markdown(checks), end="")
   394	    return exit_code(checks, args.require)
   395	
   396	
   397	if __name__ == "__main__":
   398	    sys.exit(main())
