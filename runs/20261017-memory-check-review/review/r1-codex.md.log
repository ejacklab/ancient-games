  const added = (after.entry.fields.get("changed")?.items ?? []).filter(
    (item) => item.trim() !== "" && !(before.fields.get("changed")?.items ?? []).includes(item),
  );
  if (added.length === 0) {
    const line = after.entry.fields.get("covers")?.line ?? before.fields.get("covers")?.line ?? 1;
