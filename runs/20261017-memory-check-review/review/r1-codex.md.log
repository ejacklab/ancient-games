 succeeded in 0ms:
// Reading one entry file's header and body: the few fields the tool's own git checks compare (K4.1, K4.3,
// W1.1a, W1.1b, W6.1a). The format clauses W1.1a, W1.1b, W1.2a, W1.3a, W4.1b and K6.3a are not judged here — they
// are `tools/memory_index.py --check`'s, and the tool runs it instead of checking them a second way (C3).

export interface Field {
  /** The value on the `key:` line, whitespace collapsed. */
  readonly value: string;
  /** The value plus every indented or `- ` continuation line under it, as one text. */
  readonly full: string;
  /** The continuation lines under the `key:` (`- ` items, or wrapped values), one per line. */
  readonly items: readonly string[];
  /** The 1-based line the `key:` is on, for evidence. */
  readonly line: number;
}

export interface Entry {
  readonly name: string;
  readonly text: string;
  readonly fields: ReadonlyMap<string, Field>;
  /** The body up to `**Why:**`, whitespace collapsed: the claim. */
  readonly claim: string;
  readonly claimLine: number;
  /** The `id:` lines at top level: more than one means more than one entry in the file (W6.1a). */
  readonly idLines: number[];
  /** The lines that are exactly `---`: more than two means more than one header block (W6.1a). */
  readonly headerBlocks: number;
  readonly headerStartLine: number;
  readonly headerEndLine: number;
}

const WHY = "**Why:**";

function squash(text: string): string {
  return text.replace(/\s+/g, " ").trim();
}

/** One pair of surrounding quotes, as memory_index.py's `unquote` strips (tools/memory_index.py:127): a header
 *  scalar written `status: "superseded"` is the status `superseded`, and comparing it unquoted is comparing what
 *  the index checker reads. */
function unquote(value: string): string {
  const first = value[0];
  return value.length >= 2 && first === value[value.length - 1] && (first === '"' || first === "'")
    ? value.slice(1, -1)
    : value;
}

const FENCE = /^\s{0,3}(`{3,}|~{3,})/;

/**
 * The lines that are exactly `---`, as line numbers. A line inside a fenced code block is the entry's own content —
 * a Markdown example of a header is not a second header (W6.1a), so fences are stepped over.
 */
function headerDelimiters(lines: readonly string[]): number[] {
  const found: number[] = [];
  let fence = "";
  for (const [index, line] of lines.entries()) {
    const marker = FENCE.exec(line);
    if (marker) {
      const token = marker[1]!;
      if (fence === "") fence = token[0]!;
      else if (token.startsWith(fence)) fence = "";
      continue;
    }
    if (fence !== "") continue;
    if (line === "---") found.push(index);
  }
  return found;
}

export function parseEntry(name: string, text: string): Entry {
  const lines = text.replace(/\r\n/g, "\n").split("\n");
  const fences = headerDelimiters(lines);
  const start = fences[0] ?? -1;
  const end = fences[1] ?? -1;
  const fields = new Map<string, Field>();
  const idLines: number[] = [];
  if (start === 0 && end > 0) {
    let current: { key: string; value: string; parts: string[]; items: string[]; line: number } | null = null;
    const close = (): void => {
      if (current) {
        fields.set(current.key, {
          value: current.value,
          full: squash(current.parts.join(" ")),
          items: current.items,
          line: current.line,
        });
      }
      current = null;
    };
    for (let index = start + 1; index < end; index++) {
      const line = lines[index] ?? "";
      if (line.trim() === "") continue;
      const indented = /^\s/.test(line);
      if (indented || line.startsWith("- ")) {
        if (current) {
          current.parts.push(line.trim());
          current.items.push(line.trim().replace(/^-\s*/, ""));
        }
        continue;
      }
      const colon = line.indexOf(":");
      if (colon <= 0) continue;
      close();
      const key = line.slice(0, colon).trim();
      const value = unquote(line.slice(colon + 1).trim());
      current = { key, value, parts: value ? [value] : [], items: value ? [value] : [], line: index + 1 };
      if (key === "id") idLines.push(index + 1);
    }
    close();
  }
  const body = lines.slice(end >= 0 ? end + 1 : 0);
  let claim = "";
  let claimLine = (end >= 0 ? end : 0) + 2;
  for (const [offset, line] of body.entries()) {
    if (line.startsWith(WHY)) break;
    if (squash(line) !== "") {
      if (claim === "") claimLine = (end >= 0 ? end : 0) + 2 + offset;
      claim = claim === "" ? squash(line) : `${claim} ${squash(line)}`;
    }
  }
  return {
    name,
    text,
    fields,
    claim,
    claimLine,
    idLines,
    headerBlocks: Math.max(0, Math.floor(fences.length / 2)),
    headerStartLine: start + 1,
    headerEndLine: end + 1,
  };
}

export function fieldValue(entry: Entry, key: string): string {
  return entry.fields.get(key)?.full ?? "";
}

/** The id form of W1.1b, the same one tools/memory_index.py checks (`ID_FORM`, tools/memory_index.py:57). */
const ID_FORM = /\d{2}-\d{2}-[0-9a-z]{6}-\d{4}/;

/** `<prefix>-<id>-<slug>.md` (W1.1c): the prefix is the first letter, the id the W1.1b form in the name. A name
 *  with no id in it has none to compare, and that is W1.1c's (a reviewer's) to say. */
export function nameParts(name: string): { prefix: string; id: string | null } {
  return { prefix: name.slice(0, 1), id: ID_FORM.exec(name)?.[0] ?? null };
}// C5: what the tool looked at. Files are read from the staged state (git index, stage 0) — the view
// `tools/memory_index.py --check` reads — and history from the commits since the first one that touches
// `project-memory/` (`--since` overrides), with the range named in the report. A shallow clone makes every
// history check "could not run", and so does a git command that fails: its empty output is never read as "nothing
// there" (C2). Every call here is read-only, with GIT_OPTIONAL_LOCKS=0.
import { spawnSync } from "node:child_process";
import { git, gitOut, lines } from "./git.ts";

const ENTRIES = "project-memory/entries";
const MEMORY = "project-memory";
const CACHE = "project-memory/.cache";
const COMMIT_MARK = "\u0001";

/** The reasons the git calls one check made failed: what "could not run" answers with (C2). */
export type GitErrors = string[];

/**
 * One read-only git call, and the reason it failed when it did. An empty string with a message in `errors` is never
 * read as "nothing there": a clause that needed the answer and could not get it is "could not run", where the empty
 * output of a failed command used to be taken for a clean result. An `optional` call is one whose question has
 * "nothing there" as an answer — `git rev-parse --verify --quiet`, which exits 1 on a revision that is not there.
 */
function gitRead(root: string, args: readonly string[], errors: GitErrors, optional = false): string {
  const result = git(root, args);
  if (result.code !== 0) {
    const detail = (result.stderr || result.stdout).trim();
    if (!(optional && detail === "")) {
      errors.push(`git ${args.join(" ")} failed: ${detail || `exit ${result.code}`}`);
    }
    return "";
  }
  return result.stdout;
}

export interface SnapshotInfo {
  readonly root: string;
  readonly shallow: boolean;
  /** What the report's first line names for files. */
  readonly filesView: string;
  /** What the report's first line names for history, with the range. Empty when it could not be read. */
  readonly historyView: string;
  readonly range: string | null;
  readonly firstTouching: string | null;
  readonly commitsInRange: number;
  /** The git calls that failed while the snapshot itself was read. */
  readonly errors: readonly string[];
}

export interface StagedEntry {
  readonly name: string;
  readonly path: string;
  readonly sha: string;
  readonly text: string;
}

export interface Rename {
  /** The commit the rename happened in, or null when it is staged and in no commit yet. */
  readonly commit: string | null;
  readonly from: string;
  readonly to: string;
}

export interface Deletion {
  /** The commit the deletion happened in, or null when it is staged and in no commit yet. */
  readonly commit: string | null;
  readonly path: string;
}

/** How a change is named in evidence: a commit of its own, or the staged state. */
export function whereOf(commit: string | null): string {
  return commit === null ? "the staged state" : `commit ${commit.slice(0, 7)}`;
}

/** The first commit that touches `project-memory/`, oldest first. */
function firstTouchingCommit(root: string, errors: GitErrors): string | null {
  const output = gitRead(root, ["log", "--reverse", "--format=%H", "--", MEMORY], errors);
  return lines(output)[0] ?? null;
}

export function snapshotInfo(root: string, since: string | null): SnapshotInfo {
  const errors: GitErrors = [];
  const shallow = gitRead(root, ["rev-parse", "--is-shallow-repository"], errors).trim() === "true";
  const filesView = "the staged state (git index, stage 0), the view `tools/memory_index.py --check` reads";
  const first = since ?? firstTouchingCommit(root, errors);
  if (!first) {
    return {
      root,
      shallow,
      filesView,
      historyView: shallow
        ? `could not run: this is a shallow clone, so the first commit touching ${MEMORY}/ is not here`
        : `no commits touch ${MEMORY}/: no history range to check`,
      range: null,
      firstTouching: null,
      commitsInRange: 0,
      errors,
    };
  }
  // The first commit that touches project-memory/ is inside the range: an entry's first version is its evidence.
  const parent = gitRead(root, ["rev-parse", "--verify", "--quiet", `${first}^`], errors, true).trim();
  const range = parent === "" ? "HEAD" : `${first}^..HEAD`;
  const count = Number(gitRead(root, ["rev-list", "--count", range], errors).trim() || "0");
  const short = gitRead(root, ["rev-parse", "--short", first], errors).trim() || first.slice(0, 7);
  return {
    root,
    shallow,
    filesView,
    historyView: shallow
      ? `${short}..HEAD (${count} commit${count === 1 ? "" : "s"} in a shallow clone: history checks could not run)`
      : `${short}..HEAD (${count} commit${count === 1 ? "" : "s"})`,
    range,
    firstTouching: first,
    commitsInRange: count,
    errors,
  };
}

/**
 * R1: the files under `project-memory/` that the working tree changed and the staged snapshot does not hold — modified,
 * deleted or untracked there — read with `git status --porcelain -uall`, read-only. They are not checked, because every
 * check reads the staged state (C5), so the report names how many there are. A change the index already holds is not
 * one of them: the first column of the porcelain status is the index, the second the working tree, and only the second
 * says the staged snapshot lacks the change. `-uall` lists every untracked file by name instead of collapsing a folder
 * of new files into one line, so the count is a count of files.
 */
export interface UnstagedMemory {
  readonly count: number;
  readonly files: readonly string[];
  readonly error: string | null;
}

export function unstagedMemoryFiles(root: string): UnstagedMemory {
  const result = git(root, ["status", "--porcelain", "-uall", "--", MEMORY]);
  if (result.code !== 0) {
    const detail = (result.stderr || result.stdout).trim();
    return { count: 0, files: [], error: `git status --porcelain -uall -- ${MEMORY} failed: ${detail || `exit ${result.code}`}` };
  }
  const files = lines(result.stdout)
    .filter((line) => isUnstaged(line.slice(0, 2)))
    .map((line) => line.slice(3).trim());
  return { count: files.length, files, error: null };
}

/** "??" is untracked; a modified, deleted or type-changed working tree is a letter in the second column. */
function isUnstaged(code: string): boolean {
  if (code === "??") return true;
  return code.length === 2 && "MDT".includes(code[1]!);
}

/** Every path under `project-memory/` in the staged state: the snapshot itself (C5). */
export function stagedMemoryPaths(root: string, errors: GitErrors): string[] {
  const raw = gitRead(root, ["ls-files", "-z", "--cached", "--", MEMORY], errors);
  return raw.split("\0").filter((record) => record !== "");
}

/** The staged entry files and their staged bytes: `git ls-files -s`, then one `cat-file --batch`. */
export function stagedEntries(root: string, errors: GitErrors): StagedEntry[] {
  const raw = gitRead(root, ["ls-files", "-s", "-z", "--", ENTRIES], errors);
  const wanted: { name: string; path: string; sha: string }[] = [];
  for (const record of raw.split("\0")) {
    if (record === "") continue;
    const [meta, path] = record.split("\t");
    if (!meta || !path) continue;
    const fields = meta.trim().split(/\s+/);
    if (fields.length < 3 || fields[2] !== "0") continue; // not stage 0: a tree without conflicts has no other
    wanted.push({ name: path.slice(ENTRIES.length + 1), path, sha: fields[1] ?? "" });
  }
  const blobs = catFileBatch(root, wanted.map((entry) => entry.sha), errors);
  return wanted.map((entry) => ({ ...entry, text: blobs.get(entry.sha) ?? "" }));
}

/** One `git cat-file --batch` for many blobs; missing blobs come back absent, not as an error. */
export function catFileBatch(root: string, shas: readonly string[], errors: GitErrors): Map<string, string> {
  const blobs = new Map<string, string>();
  const wanted = [...new Set(shas.filter((sha) => sha !== ""))];
  if (wanted.length === 0) return blobs;
  const result = spawnSync("git", ["cat-file", "--batch"], {
    cwd: root,
    encoding: "buffer",
    input: Buffer.from(`${wanted.join("\n")}\n`, "ascii"),
    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
  });
  if (result.status !== 0) {
    errors.push(`git cat-file --batch failed: ${result.stderr?.toString().trim() || `exit ${result.status}`}`);
    return blobs;
  }
  const buffer = result.stdout ?? Buffer.alloc(0);
  let position = 0;
  while (position < buffer.length) {
    const newline = buffer.indexOf(0x0a, position);
    if (newline < 0) break;
    const header = buffer.subarray(position, newline).toString("ascii").split(" ");
    position = newline + 1;
    if (header.length < 3) continue; // "<sha> missing"
    const size = Number(header[2]);
    blobs.set(header[0] ?? "", buffer.subarray(position, position + size).toString("utf8"));
    position += size + 1;
  }
  return blobs;
}

function readNameStatus(raw: string): { renames: Rename[]; deletions: Deletion[] } {
  const renames: Rename[] = [];
  const deletions: Deletion[] = [];
  let commit: string | null = null;
  for (const line of lines(raw)) {
    if (line.startsWith(COMMIT_MARK)) {
      commit = line.slice(1);
      continue;
    }
    const fields = line.split("\t");
    if (fields[0]?.startsWith("R") && fields.length === 3) {
      renames.push({ commit, from: fields[1] ?? "", to: fields[2] ?? "" });
    } else if (fields[0]?.startsWith("D") && fields.length === 2) {
      deletions.push({ commit, path: fields[1] ?? "" });
    }
  }
  return { renames, deletions };
}

/** The renames and deletions of the entry files in a range of commits (`git log -M --name-status`). */
function committedNameStatus(root: string, range: string | null, errors: GitErrors): { renames: Rename[]; deletions: Deletion[] } {
  const args = ["log", ...(range ? [range] : []), "--format=%x01%H", "-M", "--name-status", "--", ENTRIES];
  return readNameStatus(gitRead(root, args, errors));
}

/**
 * The renames and deletions of the entry files in the staged diff (`git diff --cached -M --name-status`): a
 * deletion or rename that is staged is in no commit yet, and history alone would never show it (K4.1, W1.1).
 */
function stagedNameStatus(root: string, errors: GitErrors): { renames: Rename[]; deletions: Deletion[] } {
  if (gitRead(root, ["rev-parse", "--verify", "--quiet", "HEAD"], errors, true).trim() === "") {
    return { renames: [], deletions: [] }; // nothing is staged against: no commit names a previous state
  }
  return readNameStatus(gitRead(root, ["diff", "--cached", "-M", "--name-status", "--", ENTRIES], errors));
}

/** Every rename of an entry file, committed or staged. */
export function entryRenames(root: string, range: string | null, errors: GitErrors): Rename[] {
  return [...committedNameStatus(root, range, errors).renames, ...stagedNameStatus(root, errors).renames];
}

/** Every deletion of an entry file, committed or staged. */
export function entryDeletions(root: string, range: string | null, errors: GitErrors): Deletion[] {
  return [...committedNameStatus(root, range, errors).deletions, ...stagedNameStatus(root, errors).deletions];
}

/** The merge commits in the range with their parents: `git log --format=%H %P`, the commits with two parents or more. */
export function mergeCommits(root: string, range: string | null, errors: GitErrors): { commit: string; parents: string[] }[] {
  const args = ["log", ...(range ? [range] : []), "--format=%H %P"];
  const merges: { commit: string; parents: string[] }[] = [];
  for (const line of lines(gitRead(root, args, errors))) {
    const parts = line.split(" ").filter((one) => one !== "");
    if (parts.length > 2) merges.push({ commit: parts[0] ?? "", parents: parts.slice(1) });
  }
  return merges;
}

/** The entry files a revision holds: `git ls-tree -r --name-only <rev> -- project-memory/entries`. */
export function entryFilesAt(root: string, rev: string, errors: GitErrors): string[] {
  return lines(gitRead(root, ["ls-tree", "-r", "--name-only", rev, "--", ENTRIES], errors));
}

/** The blob id a revision holds for a path, or an empty string when it holds none. */
export function blobIdAt(root: string, rev: string, path: string, errors: GitErrors): string {
  return gitRead(root, ["rev-parse", "--verify", "--quiet", `${rev}:${path}`], errors, true).trim();
}

/** Whether a revision has a parent commit: a root commit has none, and nothing was there before it. */
export function hasParent(root: string, rev: string, errors: GitErrors): boolean {
  return gitRead(root, ["rev-parse", "--verify", "--quiet", `${rev}^`], errors, true).trim() !== "";
}

/** The commits in the range that changed a path, oldest first: `git log --format=%H -- <path>`, reversed. */
export function commitsOf(root: string, range: string | null, path: string, errors: GitErrors): string[] {
  const args = ["log", ...(range ? [range] : []), "--format=%H", "--", path];
  return lines(gitRead(root, args, errors)).reverse();
}

/** The text a revision holds for a path, or null when it holds none. */
export function textAt(root: string, rev: string, path: string, errors: GitErrors): string | null {
  const sha = blobIdAt(root, rev, path, errors);
  if (sha === "") return null;
  return catFileBatch(root, [sha], errors).get(sha) ?? null;
}

/**
 * The entry files a merge holds that one of its parents held and it does not: the whole entry a side added, lost in
 * the merge result. `git log --diff-filter=D` never shows it, because a merge has no diff of its own against one
 * parent by default, so every parent is compared with the result here (K4.1).
 */
export function entriesDroppedByMerges(
  root: string,
  range: string | null,
  errors: GitErrors,
): { merge: string; parent: string; path: string }[] {
  const dropped: { merge: string; parent: string; path: string }[] = [];
  for (const merge of mergeCommits(root, range, errors)) {
    const merged = new Set(entryFilesAt(root, merge.commit, errors));
    for (const parent of merge.parents) {
      for (const path of entryFilesAt(root, parent, errors)) {
        if (!merged.has(path)) dropped.push({ merge: merge.commit, parent, path });
      }
    }
  }
  return dropped;
}

/** B2.2: `git check-ignore` on the cache folder, and the output as evidence either way. */
export function cacheIsIgnored(root: string): { ignored: boolean; command: string; code: number; output: string } {
  const result = git(root, ["check-ignore", "-v", CACHE]);
  const output = (result.stdout + result.stderr).trim();
  return {
    ignored: result.code === 0,
    command: `git check-ignore -v project-memory/.cache   (in ${root})`,
    code: result.code,
    output,
  };
}

/**
 * Rd1: the session-start surface a hook or an instruction can live in — the harness settings' hooks, the git
 * hooks the repository uses, and the instruction files. Each file that exists is read; nothing under
 * `project-memory/.cache/` is ever opened (R2, Rd1).
 */
export function sessionStartFiles(root: string): string[] {
  const candidates = [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/CLAUDE.md",
    ".codex/AGENTS.md",
    ".gemini/GEMINI.md",
    ".github/copilot-instructions.md",
  ];
  const files = candidates.map((candidate) => `${root}/${candidate}`);
  const hooksPath = gitOut(root, ["config", "--get", "core.hooksPath"]);
  const hookDir = hooksPath !== "" ? `${root}/${hooksPath}` : `${root}/.git/hooks`;
  for (const hook of ["pre-commit", "prepare-commit-msg", "post-commit", "post-checkout", "commit-msg", "pre-push"]) {
    files.push(`${hookDir}/${hook}`);
  }
  return files;
}// The clauses the tool judges itself, from the staged snapshot or from git history: the entry-name prefix W1.1a
// does not reach, one file per entry (W6.1a), an entry file is never deleted and says what replaced it (K4.1),
// an entry's claim, `source`, `depends_on` and `covers` never change silently (K4.3), a merge keeps what both sides
// wrote (W6.3a), and the git half of W1.1a and W1.1b (an entry file renamed to another prefix or another id). Every
// break carries its file and line, or the command and its output (C2).
import { nameParts, parseEntry, type Entry } from "./entry.ts";
import {
  blobIdAt,
  catFileBatch,
  commitsOf,
  entryDeletions,
  entryFilesAt,
  entryRenames,
  entriesDroppedByMerges,
  hasParent,
  mergeCommits,
  textAt,
  type GitErrors,
  type SnapshotInfo,
  type StagedEntry,
  whereOf,
} from "./gitchecks.ts";

export interface ClauseOutcome {
  /** One evidence line per break found. Empty when nothing broke. */
  readonly breaks: readonly string[];
  /** The evidence that says what was checked, when nothing broke. */
  readonly clean: string;
  /** Set when the check could not run: the reason. */
  readonly couldNotRun: string | null;
  /** Things the scan could not decide either way: a reviewer's, never a pass and never a fail (C2). */
  readonly unresolved?: readonly string[];
  /** Things a reader should know that are not breaks (a name not in the W1.1c form, for instance). */
  readonly notes?: readonly string[];
}

const SHALLOW = "this is a shallow clone, so the history this clause needs is not here (C5)";

function short(sha: string): string {
  return sha.slice(0, 7);
}

function truncate(text: string, limit = 90): string {
  const one = text.replace(/\s+/g, " ").trim();
  return one.length <= limit ? one : `${one.slice(0, limit - 1)}…`;
}

function parsed(staged: readonly StagedEntry[]): { staged: StagedEntry; entry: Entry }[] {
  return staged
    .map((one) => ({ staged: one, entry: parseEntry(one.name, one.text) }))
    .filter((one) => one.entry.headerEndLine > 0);
}

/** A git call of the snapshot itself failed: every history clause that needed it could not run. */
function snapshotErrors(snapshot: SnapshotInfo, errors: GitErrors): string[] {
  return [...snapshot.errors, ...errors];
}

/** W1.1a's clause memory_index.py does not check: it only reads `^[DFLOH]-` names, so it never sees another name. */
export function checkEntryPrefixes(staged: readonly StagedEntry[]): ClauseOutcome {
  const breaks: string[] = [];
  for (const one of staged) {
    if (!one.name.endsWith(".md")) continue;
    if (!/^[DFLOH]-/.test(one.name)) {
      breaks.push(`${one.path}:1 — the prefix "${one.name.slice(0, 1)}" is not one of D F L O H`);
    }
  }
  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
  return {
    breaks: [],
    clean: `${staged.length} staged file(s) under project-memory/entries/, every name's prefix is one of D F L O H`,
    couldNotRun: null,
  };
}

/** W6.1a's mechanical clause: one file holds one entry. */
export function checkOneEntryPerFile(staged: readonly StagedEntry[]): ClauseOutcome {
  const breaks: string[] = [];
  for (const { staged: one, entry } of parsed(staged)) {
    if (entry.idLines.length > 1) {
      breaks.push(`${one.path}:${entry.idLines[1]} — a second id: line; one file holds one entry`);
    } else if (entry.headerBlocks > 1) {
      breaks.push(`${one.path}:${entry.headerEndLine} — a second --- header block; one file holds one entry`);
    }
  }
  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
  return {
    breaks: [],
    clean: `${staged.length} staged entry file(s), each with one header block and one id:`,
    couldNotRun: null,
  };
}

/** K4.1: an entry file is never deleted; a superseded entry says what replaced it; a retired entry gives its reason. */
export function checkK41(staged: readonly StagedEntry[], snapshot: SnapshotInfo): ClauseOutcome {
  const breaks: string[] = [];
  for (const { staged: one, entry } of parsed(staged)) {
    checkHeader(one.path, entry, breaks);
  }
  const errors: GitErrors = [];
  if (!snapshot.shallow) {
    for (const deletion of entryDeletions(snapshot.root, snapshot.range, errors)) {
      breaks.push(
        `${whereOf(deletion.commit)} deleted ${deletion.path} — an entry file is never deleted ` +
          "(git log --diff-filter=D --name-status -- project-memory/entries, and git diff --cached --name-status)",
      );
    }
    // A merge holds no diff of its own against one parent by default: every parent is compared with its result, so
    // the whole entry one side added cannot vanish in a merge without a name here (K4.1).
    for (const dropped of entriesDroppedByMerges(snapshot.root, snapshot.range, errors)) {
      breaks.push(
        `commit ${short(dropped.merge)} holds ${dropped.path}, which parent ${short(dropped.parent)} held and the ` +
          `merge result does not — an entry file is never deleted (git ls-tree -r ${dropped.parent} vs ` +
          `${short(dropped.merge)} -- project-memory/entries)`,
      );
    }
  }
  const couldNotRun = [...snapshotErrors(snapshot, errors)];
  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
  if (couldNotRun.length > 0) return { breaks: [], clean: "", couldNotRun: reasons(couldNotRun) };
  if (snapshot.shallow) {
    return {
      breaks: [],
      clean: "",
      couldNotRun: `${SHALLOW}; the superseded_by and retired checks on the staged state still ran`,
    };
  }
  return {
    breaks: [],
    clean:
      `${staged.length} staged entry file(s): no status: superseded without superseded_by, no status: retired ` +
      `without a reason in its changed: line; git log --diff-filter=D --name-status and git diff --cached ` +
      `--name-status -- project-memory/entries (${snapshot.range}) deleted none, and no merge dropped an entry`,
    couldNotRun: null,
  };
}

/** What "could not run" says: the git calls that failed, named (C2). */
function reasons(errors: readonly string[]): string {
  const first = errors[0] ?? "";
  const more = errors.length > 1 ? ` … (${errors.length - 1} more failed call(s))` : "";
  return `a git command failed, so this clause could not run (C2): ${first}${more}`;
}

/** A field that says "nothing here": an empty value, or the empty list the format's own examples use. */
function linksNothing(value: string | undefined): boolean {
  const one = (value ?? "").replace(/\s+/g, " ").trim().toLowerCase();
  return one === "" || one === "[]" || one === "- none" || one === "none" || one === "(none)";
}

function checkHeader(path: string, entry: Entry, breaks: string[]): void {
  const status = entry.fields.get("status");
  const statusValue = status?.full ?? "";
  if (statusValue === "superseded" && linksNothing(entry.fields.get("superseded_by")?.full)) {
    breaks.push(`${path}:${status?.line ?? 1} — status: superseded with no superseded_by link`);
  }
  if (statusValue === "retired") {
    const changed = entry.fields.get("changed");
    const items = (changed?.items ?? []).filter((item) => item.trim() !== "");
    if (items.length === 0) {
      breaks.push(`${path}:${status?.line ?? 1} — status: retired with no changed: line naming the reason`);
    }
  }
}

/** One version of an entry: a revision that holds it, or the staged state. */
interface Version {
  readonly where: string;
  readonly text: string;
  readonly entry: Entry;
}

/**
 * K4.3: after its first commit an entry only gains lines; its claim, `source` and `depends_on` never change, and
 * every change to `covers` has a `changed:` line of its own. Every transition inside the range is compared, not
 * only the two ends: a claim rewritten and then restored is a break like any other, and one `changed:` line from
 * long ago does not excuse a later `covers` edit.
 */
export function checkK43(staged: readonly StagedEntry[], snapshot: SnapshotInfo): ClauseOutcome {
  const withHeader = parsed(staged);
  if (snapshot.shallow) {
    return { breaks: [], clean: "", couldNotRun: SHALLOW };
  }
  const errors: GitErrors = [];
  const breaks: string[] = [];
  const comparedAt: string[] = [];
  let transitions = 0;

  for (const { staged: one } of withHeader) {
    const { baseline, versions } = versionsOf(snapshot, one, errors);
    for (const [index, version] of versions.entries()) {
      const before = index === 0 ? baseline : versions[index - 1]!.text;
      if (before === null) continue; // the entry did not exist: its first version is not a change of a claim
      transitions += 1;
      comparedAt.push(`${one.path}:${version.entry.claimLine}`);
      for (const breakLine of transitionBreaks(one.path, parseEntry(one.name, before), version)) breaks.push(breakLine);
    }
  }
  const couldNotRun = snapshotErrors(snapshot, errors);
  if (breaks.length > 0) return { breaks, clean: "", couldNotRun: null };
  if (couldNotRun.length > 0) return { breaks: [], clean: "", couldNotRun: reasons(couldNotRun) };
  return {
    breaks: [],
    clean:
      `${withHeader.length} staged entry file(s) compared over ${transitions} transition(s) in ` +
      `${snapshot.range}, each from the version before it (git log --format=%H -- <entry file>): claim at ` +
      `${comparedAt.join(", ") || "no transition"}, source and depends_on unchanged, and every covers change has a ` +
      "changed: line of its own",
    couldNotRun: null,
  };
