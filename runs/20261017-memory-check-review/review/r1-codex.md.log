  const renames = checkRenames(snapshot);
  const prefixes = checkEntryPrefixes(staged);
  const onePerFile = checkOneEntryPerFile(staged);
  const k41 = checkK41(staged, snapshot);
  const k43 = checkK43(staged, snapshot);
  const merges = checkMerges(snapshot);
  for (const outcome of [renames.prefixes, renames.ids, prefixes, onePerFile, k41, k43, merges]) {
    for (const note of outcome.notes ?? []) notes.push(note);
  }

  const results: RequirementResult[] = [];

  // --- the tool's own requirements (F1-F3) -------------------------------------------------------------------------

  const missingAgentsMd = agentsMdMissing(root);
  results.push({
    id: "F1",
    level: "MUST",
    verdict: missingAgentsMd ? "fail" : "pass",
    evidence: missingAgentsMd
      ? `${root}/AGENTS.md does not exist: AGENTS.md is required (F1)`
      : `${root}/AGENTS.md exists; ${locations.filter((one) => one.present).length} of ${locations.length} named locations present, ` +
        `${locations.filter((one) => !one.present).length} absent. This table is the working tree; every verdict below reads the ` +
        "staged state (C5)",
    failsIf:
      "a named location exists and is not found, one is reported that does not exist, or a missing AGENTS.md is not a failure",
  });
  results.push({
    id: "F2",
    level: "MUST",
    verdict: "pass",
    evidence: `project ${root} is the root of a git repository (git rev-parse --show-toplevel in it)`,
    failsIf: "a given path is ignored, or a path that is not a git root is checked instead of being a usage error",
  });
  results.push({
    id: "F3",
    level: "MUST",
    verdict: "pass",
    evidence:
      `this run created, changed and deleted nothing; it wrote ${options.out ? `only ${options.out}` : "nothing"}; ` +
      "every git call ran with GIT_OPTIONAL_LOCKS=0",
    failsIf: "a run changes, creates or deletes any file, ignored files included, other than the report",
  });

  // --- the records of SOURCE_OF_TRUTH_REQUIREMENTS.yaml ----------------------------------------------------------

  const context: SotContext = { projectMemory, indexTool, prefixes, onePerFile, k41, k43, merges, renames };
  for (const record of guidelines.sot) {
    results.push(sotResult(record, context));
  }

  // --- the Core requirements of CACHES.md --------------------------------------------------------------------------

  for (const record of guidelines.caches) {
    results.push(cachesResult(record.id, record.failsIf, cachePresent, root));
  }

  return {
    root,
    snapshot,
    unstaged,
    locations,
    results,
    indexTool,
    notes,
    guidelines,
    exitCode: exitCodeOf(results),
  };
}

/** R3: 0 when no MUST fails or could not run, 1 when one does. CACHES.md gives its requirements no level, so they
 *  cannot gate the exit code; the report says so. */
function exitCodeOf(results: readonly RequirementResult[]): number {
  return results.some(
    (result) => result.level === "MUST" && (result.verdict === "fail" || result.verdict === "could not run"),
  )
    ? 1
    : 0;
}

interface SotContext {
  readonly projectMemory: boolean;
  readonly indexTool: IndexToolRun;
  readonly prefixes: ClauseOutcome;
  readonly onePerFile: ClauseOutcome;
  readonly k41: ClauseOutcome;
  readonly k43: ClauseOutcome;
  readonly merges: ClauseOutcome;
  readonly renames: { prefixes: ClauseOutcome; ids: ClauseOutcome };
}

function sotResult(record: SotRecord, context: SotContext): RequirementResult {
  const level: Level = record.level;
  const base = { id: `SoT:${record.id}`, level, failsIf: record.failsIf };
  if (!context.projectMemory && !OUTSIDE_PROJECT_MEMORY.has(record.id)) {
    return {
      ...base,
      verdict: "not applicable",
      evidence:
        "project-memory/ is absent from the staged state this run checked (git ls-files -s -z -- " +
        "project-memory; F1 names what the working tree holds), so the memory this record is about is absent (C4)",
    };
  }
  if (level === "guidance") {
    return { ...base, verdict: "not applicable", evidence: "guidance: nothing to check (check: none)" };
  }
  return decidedByTool(record, context) ?? {
    ...base,
    verdict: "needs a reviewer",
    evidence: REVIEWER_REASON[record.id] ?? DEFAULT_REVIEWER_REASON,
  };
}

/** The clauses the tool decides for a record, or null when it decides none of them. */
function decidedByTool(record: SotRecord, context: SotContext): RequirementResult | null {
  const base = { id: `SoT:${record.id}`, level: record.level as Level, failsIf: record.failsIf };
  const run = context.indexTool;
  const toolEvidence = `${run.command} → exit ${run.code}${outputOf(run)}`;

  if (record.checks.includes("tool")) {
    if (toolFailedToStart(run)) {
      return {
        ...base,
        verdict: "could not run",
        evidence: `${run.command} could not be run: ${run.stderr.join(" ") || `exit ${run.code}`}`,
      };
    }
    // Rd3.1a's limit is checked by memory_index.py after it compared the index; when it stopped earlier that clause
    // did not run. Its own size line is reported, not judged here a second way (C3).
    if (record.id === "Rd3.1a" && run.mismatch && !run.overLimit && overLimitSize(run.sizeLine)) {
      return {
        ...base,
        verdict: "could not run",
        evidence:
          `${toolEvidence} — memory_index.py printed ${run.sizeLine} and then stopped at the K6 index comparison, ` +
          "before its limit check; nothing is judged here a second way (C3)",
      };
    }
    const findings = run.findings.get(record.id) ?? [];
    const mine = myClauseOf(record, context);
    const breaks = [...findings, ...(mine?.breaks ?? [])];
    if (breaks.length > 0) return { ...base, verdict: "fail", evidence: `${toolEvidence}; ${breaks.join("; ")}` };
    if (mine?.couldNotRun) return { ...base, verdict: "could not run", evidence: `${toolEvidence}; ${mine.couldNotRun}` };
    // The clauses memory_index.py only reaches after every entry parsed: not reaching them is never a pass (C2).
    if (AFTER_ENTRIES.has(record.id) && !run.compared) {
      return { ...base, verdict: "could not run", evidence: `${toolEvidence}; ${indexChecksNotReached(run)}` };
    }
    // The tool stopped on a problem that names no requirement id: it could not judge this clause either way (C2).
    if (run.unmapped.length > 0) {
      return {
        ...base,
        verdict: "could not run",
        evidence:
          `${toolEvidence}; memory_index.py stopped on problems that name no requirement id, so this clause did ` +
          `not run: ${run.unmapped.slice(0, 4).join(" | ")}`,
      };
    }
    if (record.checks.includes("reviewer")) {
      return {
        ...base,
        verdict: "needs a reviewer",
        evidence: `${toolEvidence}; the tool found no break in the clause it checks — ${DEFAULT_REVIEWER_REASON}`,
      };
    }
    return { ...base, verdict: "pass", evidence: `${toolEvidence}${mine ? `; ${mine.clean}` : ""}` };
  }

  switch (record.id) {
    case "K4.1":
      // C2: a record checked by the tool and by a reviewer fails when the tool finds a break, else needs a reviewer.
      return withReviewer(base, context.k41);
    case "K4.3":
      return fromOutcome(base, context.k43);
    case "W6.3a": {
      // C2: checked by the tool and by a reviewer — a break the tool finds fails, else it stays the reviewer's.
      if (context.merges.breaks.length > 0) {
        return { ...base, verdict: "fail", evidence: context.merges.breaks.join("; ") };
      }
      if (context.merges.couldNotRun) {
        return { ...base, verdict: "could not run", evidence: context.merges.couldNotRun };
      }
      return {
        ...base,
        verdict: "needs a reviewer",
        evidence:
          `${context.merges.clean}; whether the two entries that supersede one go unreported (the other half of ` +
          "W6.3a) is judged with the project owner (C2: checked by the tool and by a reviewer)",
      };
    }
    case "W6.1a":
      if (context.onePerFile.breaks.length > 0) {
        return { ...base, verdict: "fail", evidence: context.onePerFile.breaks.join("; ") };
      }
      if (context.onePerFile.couldNotRun) {
        return { ...base, verdict: "could not run", evidence: context.onePerFile.couldNotRun };
      }
      return {
        ...base,
        verdict: "needs a reviewer",
        evidence:
          `${context.onePerFile.clean}; whether a commit adds an entry to an existing file is judged with the ` +
          "project owner (C2: checked by the tool and by a reviewer)",
      };
    default:
      return null;
  }
}

/** The clause this tool judges itself for a record the tool also runs, or undefined when it judges none. */
function myClauseOf(record: SotRecord, context: SotContext): ClauseOutcome | undefined {
  switch (record.id) {
    case "W1.1a":
      return {
        breaks: [...context.prefixes.breaks, ...context.renames.prefixes.breaks],
        clean: `${context.prefixes.clean}; ${context.renames.prefixes.clean}`,
        couldNotRun: context.renames.prefixes.couldNotRun,
        notes: context.renames.prefixes.notes,
      };
    case "W1.1b":
      return context.renames.ids;
    case "K4.1":
      return context.k41;
    case "K4.3":
      return context.k43;
    case "W6.1a":
      return context.onePerFile;
    default:
      return undefined;
  }
}

function outputOf(run: IndexToolRun): string {
  const all = [...run.stdout, ...run.stderr];
  if (all.length === 0) return ", no output";
  const shown = all.slice(0, 4).join(" | ");
  const more = all.length > 4 ? ` … (${all.length - 4} more line(s) under Notes)` : "";
  return `, output: ${shown}${more}`;
}

/** The size line's own numbers, against the limits memory_index.py prints them with. */
function overLimitSize(sizeLine: string | null): boolean {
  if (sizeLine === null) return false;
  const match = /^INDEX\.md: (\d+)\/(\d+) lines, (\d+)\/(\d+) bytes$/.exec(sizeLine);
  if (!match) return false;
  return Number(match[1]) > Number(match[2]) || Number(match[3]) > Number(match[4]);
}

/** The clause of a CACHES requirement a result stands for, named in its evidence. */
function named(base: { id: string; level: string; failsIf: string }, clause: string, result: RequirementResult): RequirementResult {
  return { ...result, evidence: `clause ${clause}: ${result.evidence}` };
}

/** The one part of the warning the reviewer is asked about: what the tool cleared, and what it cannot judge. */
const MIXED_REVIEWER_REASON =
  "whether the written reason is one the owner accepts is judged (C2: a record the tool and a reviewer both check " +
  "is the reviewer's when the tool finds no break)";

/** A clause the tool judges, where the record also names a reviewer: a break fails, nothing broken is the reviewer's. */
function withReviewer(
  base: { id: string; level: string; failsIf: string },
  outcome: ClauseOutcome,
): RequirementResult {
  const result = fromOutcome(base, outcome);
  if (result.verdict !== "pass") return result;
  return {
    ...result,
    verdict: "needs a reviewer",
    evidence: `${result.evidence}; ${MIXED_REVIEWER_REASON}`,
  };
}

function fromOutcome(
  base: { id: string; level: string; failsIf: string },
  outcome: ClauseOutcome,
): RequirementResult {
  if (outcome.breaks.length > 0) {
    return { ...base, verdict: "fail", evidence: outcome.breaks.join("; ") };
  }
  if (outcome.couldNotRun) return { ...base, verdict: "could not run", evidence: outcome.couldNotRun };
  const unresolved = outcome.unresolved ?? [];
  if (unresolved.length > 0) {
    return {
      ...base,
      verdict: "needs a reviewer",
      evidence:
        `${unresolved.join("; ")} — a line of a session-start file this scan cannot read as an instruction to open ` +
        "a cache file nor as one never to, so it is the reviewer's (C2)",
    };
  }
  return { ...base, verdict: "pass", evidence: outcome.clean };
}

function cachesResult(id: string, failsIf: string, cachePresent: boolean, root: string): RequirementResult {
  const base = { id: `CACHES:${id}`, level: "not stated in CACHES.md", failsIf };
  // C4, C6 as changed: with no cache folder every cache requirement is "not applicable", B2.2 included. The cache
  // folder is named from the working tree and nowhere else: it is git-ignored, so it is in no snapshot.
  if (!cachePresent) {
    return {
      ...base,
      verdict: "not applicable",
      evidence:
        "project-memory/.cache/ is absent in the working tree (F1 names it; a git-ignored folder is in no snapshot), " +
        "so the cache requirements are not applicable (C4, C6)",
    };
  }
  // C6, v1: of the Core requirements only B2 (its clause B2.2) and Rd1 (its clause Rd1.1) are checked.
  if (id === "B2") return named(base, "B2.2", fromOutcome(base, checkB22(root)));
  if (id === "Rd1") return named(base, "Rd1.1", fromOutcome(base, checkRd1(root)));
  return {
    ...base,
    verdict: "needs a reviewer",
    evidence:
      "CACHES.md gives this requirement no level and no check field, and its check is the runtime behaviour of a " +
      "cache tool; only B2.2 and Rd1 are checked in this version (C6, design-decisions.md 7)",
  };
}// F1: the memory locations the guidelines name, each reported present or absent. No file inside a location is
// read to decide it: the tool asks the file system whether it is there, and nothing else.
import { existsSync, readdirSync, statSync } from "node:fs";
import path from "node:path";

export interface Location {
  /** The name the guideline uses for it: `AGENTS.md`, `project-memory/entries/`, `agent memory`. */
  readonly name: string;
  /** Absolute path, as given to the file system. */
  readonly path: string;
  readonly present: boolean;
  /** For a folder: how many direct children it holds (a name is never read). */
  readonly children: number | null;
}

export const AGENTS_MD = "AGENTS.md";

const IN_PROJECT: readonly { name: string; path: string }[] = [
  { name: "AGENTS.md", path: "AGENTS.md" },
  { name: "CLAUDE.md", path: "CLAUDE.md" },
  { name: "project-memory/INDEX.md", path: "project-memory/INDEX.md" },
  { name: "project-memory/entries/", path: "project-memory/entries" },
  { name: "project-memory/work/", path: "project-memory/work" },
  { name: "project-memory/journal/", path: "project-memory/journal" },
  { name: "project-memory/.cache/", path: "project-memory/.cache" },
];

export const PROJECT_LOCATIONS = IN_PROJECT;

function isFolder(full: string): boolean {
  try {
    return statSync(full).isDirectory();
  } catch {
    return false;
  }
}

function childrenCount(full: string): number | null {
  if (!isFolder(full)) return null;
  try {
    return readdirSync(full).length;
  } catch {
    return null;
  }
}

/**
 * The agent memory the design places in the home folder (`docs/memory-system/SOURCE_OF_TRUTH.md`, What it is
 * for): one folder per agent name. The tool cannot know which agents work on the project, so it reports the
 * names it finds, and absent when there is no such folder.
 */
function agentMemory(home: string): Location[] {
  const folder = path.join(home, ".claude", "agent-memory");
  const absent: Location = {
    name: "agent memory (<home>/.claude/agent-memory/<name>/)",
    path: folder,
    present: false,
    children: null,
  };
  if (!isFolder(folder)) return [absent];
  let names: string[] = [];
  try {
    names = readdirSync(folder).sort();
  } catch {
    return [absent];
  }
  if (names.length === 0) return [absent];
  return names.map((name) => {
    const full = path.join(folder, name);
    return { name: `agent memory ${name}/`, path: full, present: existsSync(full), children: childrenCount(full) };
  });
}

export function findLocations(root: string, home: string): Location[] {
  const inProject: Location[] = IN_PROJECT.map((location) => {
    const full = path.join(root, location.path);
    return { name: location.name, path: full, present: existsSync(full), children: childrenCount(full) };
  });
  return [...inProject, ...agentMemory(home)];
}

export function agentsMdMissing(root: string): boolean {
  return !existsSync(path.join(root, AGENTS_MD));
}// C3: the index and entry-format checks are `tools/memory_index.py --check`, run from the checked project's root
// and parsed. This file never judges those clauses itself — it maps each of the tool's own messages to the
// requirement id the message belongs to, and every result it gives carries the command and its output as evidence.
import { spawnSync } from "node:child_process";
import { MEMORY_INDEX_PY } from "./guidelines.ts";

export interface IndexToolRun {
  /** The command as it was run, for evidence. */
  readonly command: string;
  readonly code: number;
  readonly stdout: readonly string[];
  readonly stderr: readonly string[];
  /** Requirement id (SoT id, no prefix) -> the lines of the tool that found the break. */
  readonly findings: ReadonlyMap<string, readonly string[]>;
  /** `INDEX.md: 12/200 lines, 900/24000 bytes`, when the tool printed it. */
  readonly sizeLine: string | null;
  /** The tool's own over-limit failure (it prints this only after the index matched). */
  readonly overLimit: boolean;
  /** `project-memory/INDEX.md ... does not match what these entries build`. */
  readonly mismatch: boolean;
  /** `nothing to check: no project-memory/ in ...`. */
  readonly noMemory: boolean;
  /** `nothing to check: HEAD names no commit yet ...`. */
  readonly unbornHead: boolean;
  readonly upToDate: boolean;
  /** The index the entries build was measured against the size limits: the tool printed its size line. */
  readonly measured: boolean;
  /** The index was compared with what the entries build: the tool printed its size line and then judged it. */
  readonly compared: boolean;
  /** python itself failed: a traceback, an exit code no check of a memory uses, or no python3 at all. */
  readonly crashed: boolean;
  /** Problems the tool stopped on that name no requirement id: a check this tool cannot report either way. */
  readonly unmapped: readonly string[];
  /** Tool messages that name no requirement id: reported as notes, never dropped. */
  readonly notes: readonly string[];
}

const SIZE_LINE = /^INDEX\.md: (\d+)\/(\d+) lines, (\d+)\/(\d+) bytes/;

/** The index the tool judges, as it names itself (`INDEX_PATH`, tools/memory_index.py:40). */
const INDEX_NAME = "project-memory/INDEX.md";
const UP_TO_DATE = new RegExp(`^${INDEX_NAME.replace(/\//g, "\\/")} in .+ is up to date$`);
const MISMATCH = new RegExp(`${INDEX_NAME.replace(/\//g, "\\/")} in .+ does not match`);
const OVER_LIMIT = new RegExp(`${INDEX_NAME.replace(/\//g, "\\/")} in .+ is over the limit`);

/** A per-file problem as memory_index.py prints it: `<file name>: <problem>` (`tools/memory_index.py:385`). */
const PER_FILE = /^([^:]+): (.+)$/;

/** Which requirement each of memory_index.py's own problems belongs to. Order matters: longer patterns first. */
function idOfProblem(problem: string): string | null {
  if (/^kind .* is not one of/.test(problem)) return "W1.1a";
  if (/^kind .* does not match the/.test(problem)) return "W1.1a";
  if (/^id .* is not in the form/.test(problem)) return "W1.1b";
  if (/^(empty id|duplicate id)/.test(problem)) return "W1.1b";
  if (/^(no header|header is not closed)/.test(problem)) return "W1.2a";
  if (/^(no \*\*Why:\*\* line|empty claim)/.test(problem)) return "W1.3a";
  if (/^status .* is not one of/.test(problem)) return "W4.1b";
  if (/^unresolved conflict marker/.test(problem)) return "K6.3a";
  return null;
}

export function runMemoryIndex(root: string): IndexToolRun {
  const args = ["--check"];
  const result = spawnSync("python3", [MEMORY_INDEX_PY, ...args], {
    cwd: root,
    encoding: "utf8",
    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
  });
  const code = result.status ?? -1;
  const stdout = (result.stdout ?? "").split("\n").filter((line) => line.trim() !== "");
  const stderr = (result.stderr ?? "").split("\n").filter((line) => line.trim() !== "");
  const command = `python3 ${MEMORY_INDEX_PY} --check   (in ${root})`;

  const findings = new Map<string, string[]>();
  const notes: string[] = [];
  const unmapped: string[] = [];
  let sizeLine: string | null = null;
  let overLimit = false;
  let mismatch = false;
  let noMemory = false;
  let unbornHead = false;
  let upToDate = false;

  const add = (id: string, line: string): void => {
    const bucket = findings.get(id) ?? [];
    bucket.push(line);
    findings.set(id, bucket);
  };

  for (const line of [...stdout, ...stderr]) {
    const message = line.trim();
    if (SIZE_LINE.test(message)) {
      sizeLine = message;
      continue;
    }
    if (/^nothing to check: no project-memory\//.test(message)) {
      noMemory = true;
      continue;
    }
    if (/^nothing to check: HEAD names no commit/.test(message)) {
      unbornHead = true;
      continue;
    }
    if (UP_TO_DATE.test(message)) {
      upToDate = true;
      continue;
    }
    if (MISMATCH.test(message)) {
      mismatch = true;
    }
    if (OVER_LIMIT.test(message)) {
      // The index's own size limit: the clause memory_index.py judges (Rd3.1a), reported as its own failure.
      overLimit = true;
      add("Rd3.1a", message);
      continue;
    }
    // The two index clauses share memory_index.py's one comparison: K6.1a and K6.2 are reported together (C3).
    if (/INDEX\.md in .* does not match what these entries build/.test(message)) {
      add("K6.1a", message);
      add("K6.2", message);
      continue;
    }
    const perFile = PER_FILE.exec(message);
    const problem = perFile ? perFile[2]! : message;
    const id = idOfProblem(problem);
    if (id && !/\(warning\)$/.test(message)) {
      // memory_index.py calls a content problem in an inactive entry a warning, and exits 0 on it: a clause it
      // only warns about is not a break here either (C3: never report a pass the tool fails).
      for (const one of id.split(",")) add(one, message);
      continue;
    }
    // A problem the tool stopped on that names no requirement id: it is not a pass and not a fail here — it is a
    // check that could not run (C2, C3). Diff lines and fix hints arrive only after the size line, once the entries
    // were read, so they are never mistaken for one.
    if (!/\(warning\)$/.test(message) && sizeLine === null && !noMemory && !unbornHead && code !== 0) {
      unmapped.push(message);
      continue;
    }
    // Everything else the tool printed: a per-file warning, a diff line, a fix hint. Not a finding of a
    // requirement id, but never dropped.
    notes.push(message);
  }

  // The tool measures the index only after every entry parsed, so a size line means the entry checks all ran.
  const measured = sizeLine !== null;
  return {
    command,
    code,
    stdout,
    stderr,
    findings,
    sizeLine,
    overLimit,
    mismatch,
    noMemory,
    unbornHead,
    upToDate,
    measured,
    compared: measured && (upToDate || mismatch),
    crashed: code === -1 || (code !== 0 && code !== 1) || stderr.some((line) => /Traceback \(most recent call last\)/.test(line)),
    unmapped,
    notes,
  };
}

/** Whether the tool could not be run at all: no python3, or a crash of its own. */
export function toolFailedToStart(run: IndexToolRun): boolean {
  return run.crashed;
}

/** Why the index clauses did not run: the tool had no snapshot, or it stopped on the entries before comparing. */
export function indexChecksNotReached(run: IndexToolRun): string {
  if (run.noMemory || run.unbornHead) {
    return `memory_index.py had no snapshot to compare (${run.stdout.join(" ")}): the index clauses did not run (C2)`;
  }
  const stopped = [...run.stdout, ...run.stderr].filter((line) => line.trim() !== "" && !SIZE_LINE.test(line.trim()));
  return (
    `memory_index.py stopped at its entry checks and never compared ${INDEX_NAME}, so the index clauses did not ` +
    `run (C2): ${stopped.slice(0, 4).join(" | ") || `exit ${run.code}`}`
  );
}

// The guidelines the tool checks against: its own copy of the two kit files (C1), loaded and parsed here.
// The copy under `guidelines/` is verbatim; the version printed in the report is its content hash, so a report
// names the exact text its results came from.
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import path from "node:path";

export const FOLDER = path.resolve(import.meta.dirname, "..");
export const GUIDELINES_DIR = path.join(FOLDER, "guidelines");
export const SOT_YAML = path.join(GUIDELINES_DIR, "SOURCE_OF_TRUTH_REQUIREMENTS.yaml");
export const CACHES_MD = path.join(GUIDELINES_DIR, "CACHES.md");
export const MEMORY_INDEX_PY = path.resolve(import.meta.dirname, "../../tools/memory_index.py");

export type Level = "MUST" | "SHOULD" | "guidance";

export interface SotRecord {
  readonly id: string;
  readonly level: Level;
  /** The `check` field, split: `tool`, `git`, `reviewer`, `secret scanner`, `none`. */
  readonly checks: readonly string[];
  readonly failsIf: string;
  readonly text: string;
  readonly category: string;
}

export interface CachesRecord {
  readonly id: string;
  readonly title: string;
  readonly failsIf: string;
}

export interface Guidelines {
  readonly sot: readonly SotRecord[];
  readonly caches: readonly CachesRecord[];
  /** Content hash of both kit files: the version the report prints. */
  readonly version: string;
}

function readText(file: string): string {
  return readFileSync(file, "utf8");
}

function squash(text: string): string {
  return text.replace(/\s+/g, " ").trim();
}

function hashOf(file: string): string {
  return createHash("sha256").update(readFileSync(file)).digest("hex").slice(0, 12);
}

/** `Bun.YAML.parse` needs no dependency; the records under `categories[].groups[].requirements[]` are one shape. */
function loadSot(file: string): SotRecord[] {
  const document = Bun.YAML.parse(readText(file)) as {
    categories?: {
      title?: string;
      groups?: { requirements?: Record<string, unknown>[] }[];
    }[];
  };
  const records: SotRecord[] = [];
  for (const category of document.categories ?? []) {
    for (const group of category.groups ?? []) {
      for (const requirement of group.requirements ?? []) {
        const id = String(requirement["id"] ?? "");
        const level = String(requirement["level"] ?? "") as Level;
        const check = String(requirement["check"] ?? "none");
        if (!id) continue;
        records.push({
          id,
          level,
          checks: check.split(";").map((part) => part.trim()).filter(Boolean),
          failsIf: squash(String(requirement["fails_if"] ?? "")),
          text: squash(String(requirement["text"] ?? "")),
          category: String(category.title ?? ""),
        });
      }
    }
  }
  return records;
}

const HEADING = /^\*\*((?:B|K|Rd)\d+) — (.+?)\*\*.*$/;
const FAILS_IF = /^\s*-?\s*\*+Fails if\*+\s*(.+)$/;

/**
 * `CACHES.md` § Core requirements: each requirement is a bold heading, with its Fails-if line inside it. The
 * requirement is the heading, so the sub-bullets (B1.1, K1.2, ...) are not ids of their own.
 */
function loadCaches(file: string): CachesRecord[] {
  const records: CachesRecord[] = [];
  let current: { id: string; title: string; failsIf: string } | null = null;
  let heading = false;
  for (const line of readText(file).split("\n")) {
    if (/^## /.test(line)) {
      if (current) records.push(current);
      current = null;
      heading = false;
    }
    const match = HEADING.exec(line);
    if (match) {
      if (current) records.push(current);
      current = { id: match[1]!, title: squash(match[2]!), failsIf: "" };
      heading = true;
      continue;
    }
    if (!heading || !current) continue;
    const fails = FAILS_IF.exec(line);
    if (fails) current.failsIf = `${current.failsIf} ${squash(fails[1]!)}`.trim();
  }
  if (current) records.push(current);
  return records;
}

export function loadGuidelines(): Guidelines {
  return {
    sot: loadSot(SOT_YAML),
    caches: loadCaches(CACHES_MD),
    version: `SOURCE_OF_TRUTH_REQUIREMENTS.yaml ${hashOf(SOT_YAML)}, CACHES.md ${hashOf(CACHES_MD)}`,
  };
}// The command itself: `bun src/cli.ts [--project <repo root>] [--home <dir>] [--since <rev>] [--out <file>]
// [--warn]` — `cli.ts` launches it, `command.ts` is it.
// R3: exit 0 when no MUST fails or could not run, 1 when one does, 2 on a usage error. Nothing is written but
// `--out`'s file (F3, U5).
import { existsSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";
import { runChecks } from "./checks.ts";
import { loadGuidelines } from "./guidelines.ts";
import { gitOut } from "./git.ts";
import { renderReport } from "./report.ts";
import { renderWarning } from "./warn.ts";

const USAGE = `memory-check — check a project's memory against docs/memory-system's two guidelines

Usage: memory-check [options]
  --project <path>   the git repository root to check (default: the current folder)
  --home <dir>       the home folder that holds .claude/agent-memory/<name>/ (default: the user's home)
  --since <rev>      check history from this commit instead of the first that touches project-memory/
  --out <file>       write the report here instead of printing it
  --warn             print the session-start warning only (failing MUSTs and a missing AGENTS.md)
  --help             this text`;

interface Options {
  readonly project: string | null;
  readonly home: string | null;
  readonly since: string | null;
  readonly out: string | null;
  readonly warn: boolean;
}

class UsageError extends Error {}

function parseArgs(argv: readonly string[]): Options {
  let project: string | null = null;
  let home: string | null = null;
  let since: string | null = null;
  let out: string | null = null;
  let warn = false;
  for (let index = 0; index < argv.length; index++) {
    const flag = argv[index]!;
    const value = (): string => {
      const next = argv[index + 1];
      if (next === undefined || next.startsWith("--")) throw new UsageError(`${flag} needs a value`);
      index += 1;
      return next;
    };
    switch (flag) {
      case "--project":
        project = value();
        break;
      case "--home":
        home = value();
        break;
      case "--since":
        since = value();
        break;
      case "--out":
        out = value();
        break;
      case "--warn":
        warn = true;
        break;
      case "--help":
      case "-h":
        process.stdout.write(`${USAGE}\n`);
        process.exit(0);
        break;
      default:
        throw new UsageError(`unknown option ${flag}`);
    }
  }
  return { project, home, since, out, warn };
}

/** F2: the project must be given, exist, and be the root of a git repository — else a usage error. */
function projectRootOf(given: string | null): string {
  const root = path.resolve(given ?? process.cwd());
  if (!existsSync(root) || !statSync(root).isDirectory()) {
    throw new UsageError(`${root} does not exist`);
  }
  const top = gitOut(root, ["rev-parse", "--show-toplevel"]);
  if (top === "") throw new UsageError(`${root} is not inside a git repository`);
  if (path.resolve(top) !== root) throw new UsageError(`${root} is not the root of its git repository (${top} is)`);
  return root;
}

export function main(argv: readonly string[]): number {
  let options: Options;
  let root: string;
  let home: string;
  try {
    options = parseArgs(argv);
    root = projectRootOf(options.project);
    home = path.resolve(options.home ?? homedir());
    if (!existsSync(home)) throw new UsageError(`${home} does not exist`);
    if (options.since !== null && gitOut(root, ["rev-parse", "--verify", "--quiet", `${options.since}^{commit}`]) === "") {
      throw new UsageError(`--since ${options.since} names no commit in ${root}`);
    }
  } catch (error) {
    const message = error instanceof UsageError ? error.message : String(error);
    process.stderr.write(`memory-check: ${message}\n${USAGE}\n`);
    return 2;
  }

  const run = runChecks({
    root,
    home,
    since: options.since,
    out: options.out ? path.resolve(options.out) : null,
    guidelines: loadGuidelines(),
  });

  if (options.warn) {
    const warning = renderWarning(run);
    if (warning !== "") process.stdout.write(`${warning}\n`);
  } else if (options.out !== null) {
    writeFileSync(path.resolve(options.out), renderReport(run, path.resolve(options.out)));
    process.stdout.write(`${path.resolve(options.out)}\n`);
  } else {
    process.stdout.write(`${renderReport(run, null)}\n`);
  }
  return run.exitCode;
}
// Every git call the tool makes: read-only, with GIT_OPTIONAL_LOCKS=0 so git never writes its index file (F3).
import { spawnSync } from "node:child_process";

export interface GitResult {
  readonly code: number;
  readonly stdout: string;
  readonly stderr: string;
}

export function git(cwd: string, args: readonly string[]): GitResult {
  const result = spawnSync("git", [...args], {
    cwd,
    encoding: "utf8",
    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
  });
  return {
    code: result.status ?? -1,
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
  };
}

/** Whether a read-only git command succeeded. */
export function gitOk(cwd: string, args: readonly string[]): boolean {
  return git(cwd, args).code === 0;
}

export function gitOut(cwd: string, args: readonly string[]): string {
  const result = git(cwd, args);
  return result.code === 0 ? result.stdout.trim() : "";
}

/** The lines of output that are not empty. */
export function lines(text: string): string[] {
  return text.split("\n").map((line) => line.trimEnd()).filter((line) => line !== "");
}// R1: one Markdown report per run — the snapshot in the first line (C5), the locations (F1), how many files under
// `project-memory/` are changed but not staged, then every requirement with its id, level, result and evidence, MUSTs
// first, a list of what needs a reviewer, and last a section holding every "not applicable" result.
import type { CheckRun, RequirementResult, Verdict } from "./checks.ts";
import type { UnstagedMemory } from "./gitchecks.ts";

const LEVEL_ORDER: Record<string, number> = { MUST: 0, SHOULD: 1, guidance: 2, "not stated in CACHES.md": 3 };

function byLevelThenId(a: RequirementResult, b: RequirementResult): number {
  const levels = (LEVEL_ORDER[a.level] ?? 9) - (LEVEL_ORDER[b.level] ?? 9);
  return levels !== 0 ? levels : a.id.localeCompare(b.id);
}

function verdictOf(result: RequirementResult): string {
  return result.verdict;
}

/** One result line, with its evidence on the same line so a diff of two reports shows the change. */
function line(result: RequirementResult): string {
  return `- **${result.id}** (${result.level}) — ${verdictOf(result)} — ${result.evidence}`;
}

function count(results: readonly RequirementResult[], verdict: Verdict): number {
  return results.filter((one) => one.verdict === verdict).length;
}

/** R1: every "not applicable" result is printed in the last section and nowhere else, so each section drops them. */
function applicable(results: readonly RequirementResult[]): RequirementResult[] {
  return results.filter((result) => result.verdict !== "not applicable");
}

/** R1: how many files under `project-memory/` the working tree changed and the staged snapshot does not hold. */
function unstagedLine(unstaged: UnstagedMemory): string[] {
  const command = "(git status --porcelain -uall -- project-memory; the checks read the staged state, C5)";
  if (unstaged.error !== null) {
    return ["", "## Files changed but not staged (R1)", "", `- the count could not be read: ${unstaged.error}`];
  }
  const shown = unstaged.files.slice(0, 5).map((file) => `\`${file}\``);
  const more = unstaged.files.length > 5 ? ` … and ${unstaged.files.length - 5} more` : "";
  return [
    "",
    "## Files changed but not staged (R1)",
    "",
    `- ${unstaged.count} file${unstaged.count === 1 ? "" : "s"} under \`project-memory/\` changed but not staged, and so ` +
      `not checked by this run${shown.length === 0 ? "" : `: ${shown.join(", ")}${more}`} ${command}`,
  ];
}

export function renderReport(run: CheckRun, outFile: string | null): string {
  const { snapshot, results, locations } = run;
  const own = results.filter((result) => !result.id.includes(":"));
  const sot = results.filter((result) => result.id.startsWith("SoT:"));
  const caches = results.filter((result) => result.id.startsWith("CACHES:"));

  const first =
    `# memory-check — snapshot: files: ${snapshot.filesView}; history: ${snapshot.historyView} — project: ${run.root}`;
  const head = [
    first,
    "",
    `Guidelines this report is checked against (the tool's own copy, C1): ${run.guidelines.version}`,
    `Records: ${sot.length} from SOURCE_OF_TRUTH_REQUIREMENTS.yaml (SoT:), ${caches.length} Core requirements from CACHES.md (CACHES:).`,
    "",
  ];

  const locationLines = [
    "## Memory locations (F1, F2)",
    "",
    "| location | path | state |",
    "|---|---|---|",
    ...locations.map(
      (one) =>
        `| ${one.name} | \`${one.path}\` | ${one.present ? "present" : "absent"}${
          one.present && one.children !== null ? ` (${one.children} item(s))` : ""
        } |`,
    ),
    "",
  ];

  const section = (title: string, list: readonly RequirementResult[]): string[] =>
    list.length === 0 ? [] : [`## ${title}`, "", ...list.map(line), ""];

  const body = [
    ...head,
    ...locationLines,
    ...unstagedLine(run.unstaged),
    "",
    "## The tool's own requirements",
    "",
    ...applicable(own).map(line),
    "",
    ...section("Results — MUST", applicable(sot.filter((one) => one.level === "MUST")).sort(byLevelThenId)),
    ...section("Results — SHOULD", applicable(sot.filter((one) => one.level === "SHOULD")).sort(byLevelThenId)),
    ...section("Results — guidance", applicable(sot.filter((one) => one.level === "guidance")).sort(byLevelThenId)),
    ...section("Results — CACHES.md Core requirements (no level in CACHES.md)", applicable(caches).sort(byLevelThenId)),
    ...needsReviewer(results),
    ...notes(run),
    "## This run",
    "",
    `- Report ${outFile ? `written to ${outFile}` : "printed to stdout (no --out)"}`,
    "- Read only: nothing was created, changed or deleted except the report; every git call used GIT_OPTIONAL_LOCKS=0 (F3)",
    "- The session-start hook is not installed: R2 leaves that harness change to the owner (R12.3)",
    "- Not calibrated on a real project: no project has been named to calibrate against (design-decisions.md 15)",
    `- Counts: ${count(results, "fail")} fail, ${count(results, "pass")} pass, ${count(results, "needs a reviewer")} needs a reviewer, ${count(results, "not applicable")} not applicable, ${count(results, "could not run")} could not run`,
    "- CACHES.md gives its requirements no level, so none of them gates the exit code (R3 counts MUSTs only)",
    "",
    ...notApplicable(results),
  ];
  return body.join("\n");
}

/** R1: the last section, holding every "not applicable" result in the same row format as the other sections. */
function notApplicable(results: readonly RequirementResult[]): string[] {
  const list = results.filter((result) => result.verdict === "not applicable").sort(byLevelThenId);
  if (list.length === 0) return ["## Not applicable", "", "- none", ""];
  return ["## Not applicable", "", ...list.map(line), ""];
}

function needsReviewer(results: readonly RequirementResult[]): string[] {
  const list = results.filter((result) => result.verdict === "needs a reviewer");
  if (list.length === 0) return ["## Needs a reviewer", "", "- none", ""];
  return [
    "## Needs a reviewer",
    "",
    ...list.map(
      (result) =>
        `- **${result.id}** (${result.level}) — fails if: ${result.failsIf || "(guidance)"} — why not the tool: ${result.evidence}`,
    ),
    "",
  ];
}

function notes(run: CheckRun): string[] {
  const lines: string[] = ["## Notes from tools/memory_index.py", ""];
  const all = [...run.indexTool.stdout, ...run.indexTool.stderr];
  if (all.length === 0) lines.push("- it printed nothing");
  for (const one of all) lines.push(`- \`${one}\``);
  if (run.notes.length > 0) {
    lines.push("", "## Notes from this tool", "");
    for (const one of run.notes) lines.push(`- ${one}`);
  }
  lines.push("");
  return lines;
}// R2, U3: the warning — one line per MUST that fails or could not run, and for a missing AGENTS.md, with ids and file
// names, never entry text; nothing else; empty when there are none. `--warn` prints it; the session-start hook that
// also prints it is a harness change R2 leaves to the owner (R12.3), and no file under project-memory/.cache/ is ever
// opened here (Rd1): nothing in the run reads a cache file, only whether the folder is there.
//
// The lines are built from three things and nothing else: the requirement id, the category that id stands for, and the
// file names in the evidence. No evidence prose and no part of an entry is ever copied into them, because the
// evidence quotes the entry — a claim, a source — and a warning is read in a session's first lines (R2).
import type { CheckRun, RequirementResult, Verdict } from "./checks.ts";

/** The file names in an evidence line, and nothing else of the entry: no claim, no body, no text. */
const FILE_NAME = /(project-memory\/entries\/[\w.\-]+|project-memory\/INDEX\.md|AGENTS\.md)/g;

/** What each id's failure is about, in words of the guideline rather than of the entry. */
const CATEGORY: Record<string, string> = {
  "SoT:W1.1a": "an entry's kind does not match its name, or its name was renamed",
  "SoT:W1.1b": "an entry's id is malformed, or was renamed",
  "SoT:W1.2a": "an entry's header block is missing or not closed",
  "SoT:W1.3a": "an entry has no claim or no Why",
  "SoT:W4.1b": "an entry's status is not one of active, superseded, retired",
  "SoT:K4.1": "an entry file was deleted, superseded without a link, or retired without a reason",
  "SoT:K4.3": "an entry's claim, source, depends_on or covers changed without the log line for it",
  "SoT:K6.1a": "INDEX.md does not match what the entries build",
  "SoT:K6.2": "the index has a line for an entry that is not active, or none for one that is",
  "SoT:K6.3a": "an entry holds an unresolved conflict marker",
  "SoT:Rd3.1a": "INDEX.md is over its size limit",
  "SoT:W6.1a": "one file holds more than one entry",
  "SoT:W6.3a": "a merge dropped what one side wrote",
};

const GENERIC: Record<Verdict, string> = {
  fail: "a clause of the guideline memory needs",
  "could not run": "a clause of the guideline memory could not be checked",
  pass: "",
  "needs a reviewer": "",
  "not applicable": "",
};

/** How each verdict the warning holds is said, in words of the guideline rather than of the entry. */
const SAYS: Record<Verdict, string> = {
  fail: "fails",
  "could not run": "could not run",
  pass: "",
  "needs a reviewer": "",
  "not applicable": "",
};

function filesIn(evidence: string): string[] {
  return [...new Set([...evidence.matchAll(FILE_NAME)].map((match) => match[1]!))];
}

function warningFor(result: RequirementResult): string {
  const files = filesIn(result.evidence);
  const where = files.length === 0 ? "" : ` — files: ${files.join(", ")}`;
  return `memory-check: ${result.id} ${SAYS[result.verdict]} — ${CATEGORY[result.id] ?? GENERIC[result.verdict]}${where}`;
}

export function renderWarning(run: CheckRun): string {
  // F1 failing is the missing AGENTS.md, which has its own line below: one line per thing, not two.
  // U3 wins over a narrower hook: a MUST that could not run is in the warning too, or a check that never
  // finished would read as a clean session.
  const lines = run.results
    .filter(
      (result) =>
        result.id !== "F1" &&
        result.level === "MUST" &&
        (result.verdict === "fail" || result.verdict === "could not run"),
    )
    .map(warningFor);
  const missingAgents = run.results.find((result) => result.id === "F1" && result.verdict === "fail");
  if (missingAgents) {
    lines.push(`memory-check: AGENTS.md is missing — file: ${run.root}/AGENTS.md (it is required, F1)`);
  }
  return lines.join("\n");
}
