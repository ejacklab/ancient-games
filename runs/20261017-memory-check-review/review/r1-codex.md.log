    git(repo, "add", "-A")
    result = run_index(repo)
    assert result.returncode == 0, output(result)
    assert (repo / INDEX).read_bytes() == SINGLE_INDEX
    git(repo, "add", "-A")
    result = run_index(repo, "--check")
    assert result.returncode == 0, output(result)


