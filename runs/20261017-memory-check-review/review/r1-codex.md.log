// The command itself: `bun src/cli.ts [--project <repo root>] [--home <dir>] [--since <rev>] [--out <file>]
// [--warn]` — `cli.ts` launches it, `command.ts` is it.
// R3: exit 0 when no MUST fails or could not run, 1 when one does, 2 on a usage error. Nothing is written but
// `--out`'s file (F3, U5).
import { existsSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";
import { runChecks } from "./checks.ts";
import { loadGuidelines } from "./guidelines.ts";
import { gitOut } from "./git.ts";
import { renderReport } from "./report.ts";
import { renderWarning } from "./warn.ts";

const USAGE = `memory-check — check a project's memory against docs/memory-system's two guidelines

Usage: memory-check [options]
  --project <path>   the git repository root to check (default: the current folder)
  --home <dir>       the home folder that holds .claude/agent-memory/<name>/ (default: the user's home)
  --since <rev>      check history from this commit instead of the first that touches project-memory/
  --out <file>       write the report here instead of printing it
  --warn             print the session-start warning only (failing MUSTs and a missing AGENTS.md)
  --help             this text`;

interface Options {
  readonly project: string | null;
  readonly home: string | null;
  readonly since: string | null;
  readonly out: string | null;
  readonly warn: boolean;
}

class UsageError extends Error {}

function parseArgs(argv: readonly string[]): Options {
  let project: string | null = null;
  let home: string | null = null;
  let since: string | null = null;
  let out: string | null = null;
  let warn = false;
  for (let index = 0; index < argv.length; index++) {
    const flag = argv[index]!;
    const value = (): string => {
      const next = argv[index + 1];
      if (next === undefined || next.startsWith("--")) throw new UsageError(`${flag} needs a value`);
      index += 1;
      return next;
    };
    switch (flag) {
      case "--project":
        project = value();
        break;
      case "--home":
        home = value();
        break;
      case "--since":
        since = value();
        break;
      case "--out":
        out = value();
        break;
      case "--warn":
        warn = true;
        break;
      case "--help":
      case "-h":
        process.stdout.write(`${USAGE}\n`);
        process.exit(0);
        break;
      default:
        throw new UsageError(`unknown option ${flag}`);
    }
  }
  return { project, home, since, out, warn };
}

/** F2: the project must be given, exist, and be the root of a git repository — else a usage error. */
function projectRootOf(given: string | null): string {
  const root = path.resolve(given ?? process.cwd());
  if (!existsSync(root) || !statSync(root).isDirectory()) {
    throw new UsageError(`${root} does not exist`);
  }
  const top = gitOut(root, ["rev-parse", "--show-toplevel"]);
  if (top === "") throw new UsageError(`${root} is not inside a git repository`);
  if (path.resolve(top) !== root) throw new UsageError(`${root} is not the root of its git repository (${top} is)`);
  return root;
}

export function main(argv: readonly string[]): number {
  let options: Options;
  let root: string;
  let home: string;
  try {
    options = parseArgs(argv);
    root = projectRootOf(options.project);
    home = path.resolve(options.home ?? homedir());
    if (!existsSync(home)) throw new UsageError(`${home} does not exist`);
    if (options.since !== null && gitOut(root, ["rev-parse", "--verify", "--quiet", `${options.since}^{commit}`]) === "") {
      throw new UsageError(`--since ${options.since} names no commit in ${root}`);
    }
  } catch (error) {
    const message = error instanceof UsageError ? error.message : String(error);
    process.stderr.write(`memory-check: ${message}\n${USAGE}\n`);
    return 2;
  }

  const run = runChecks({
    root,
    home,
    since: options.since,
    out: options.out ? path.resolve(options.out) : null,
    guidelines: loadGuidelines(),
  });

  if (options.warn) {
    const warning = renderWarning(run);
    if (warning !== "") process.stdout.write(`${warning}\n`);
  } else if (options.out !== null) {
    writeFileSync(path.resolve(options.out), renderReport(run, path.resolve(options.out)));
    process.stdout.write(`${path.resolve(options.out)}\n`);
  } else {
    process.stdout.write(`${renderReport(run, null)}\n`);
  }
  return run.exitCode;
}
// F1: the memory locations the guidelines name, each reported present or absent. No file inside a location is
// read to decide it: the tool asks the file system whether it is there, and nothing else.
import { existsSync, readdirSync, statSync } from "node:fs";
import path from "node:path";

export interface Location {
  /** The name the guideline uses for it: `AGENTS.md`, `project-memory/entries/`, `agent memory`. */
  readonly name: string;
  /** Absolute path, as given to the file system. */
  readonly path: string;
  readonly present: boolean;
  /** For a folder: how many direct children it holds (a name is never read). */
  readonly children: number | null;
}

export const AGENTS_MD = "AGENTS.md";

const IN_PROJECT: readonly { name: string; path: string }[] = [
  { name: "AGENTS.md", path: "AGENTS.md" },
  { name: "CLAUDE.md", path: "CLAUDE.md" },
  { name: "project-memory/INDEX.md", path: "project-memory/INDEX.md" },
  { name: "project-memory/entries/", path: "project-memory/entries" },
  { name: "project-memory/work/", path: "project-memory/work" },
  { name: "project-memory/journal/", path: "project-memory/journal" },
  { name: "project-memory/.cache/", path: "project-memory/.cache" },
];

export const PROJECT_LOCATIONS = IN_PROJECT;

function isFolder(full: string): boolean {
  try {
    return statSync(full).isDirectory();
  } catch {
    return false;
  }
}

function childrenCount(full: string): number | null {
  if (!isFolder(full)) return null;
  try {
    return readdirSync(full).length;
  } catch {
    return null;
  }
}

/**
 * The agent memory the design places in the home folder (`docs/memory-system/SOURCE_OF_TRUTH.md`, What it is
 * for): one folder per agent name. The tool cannot know which agents work on the project, so it reports the
 * names it finds, and absent when there is no such folder.
 */
function agentMemory(home: string): Location[] {
  const folder = path.join(home, ".claude", "agent-memory");
  const absent: Location = {
    name: "agent memory (<home>/.claude/agent-memory/<name>/)",
    path: folder,
    present: false,
    children: null,
  };
  if (!isFolder(folder)) return [absent];
  let names: string[] = [];
  try {
    names = readdirSync(folder).sort();
  } catch {
    return [absent];
  }
  if (names.length === 0) return [absent];
  return names.map((name) => {
    const full = path.join(folder, name);
    return { name: `agent memory ${name}/`, path: full, present: existsSync(full), children: childrenCount(full) };
  });
}

export function findLocations(root: string, home: string): Location[] {
  const inProject: Location[] = IN_PROJECT.map((location) => {
    const full = path.join(root, location.path);
    return { name: location.name, path: full, present: existsSync(full), children: childrenCount(full) };
  });
  return [...inProject, ...agentMemory(home)];
}

export function agentsMdMissing(root: string): boolean {
  return !existsSync(path.join(root, AGENTS_MD));
}// C3: the index and entry-format checks are `tools/memory_index.py --check`, run from the checked project's root
// and parsed. This file never judges those clauses itself — it maps each of the tool's own messages to the
// requirement id the message belongs to, and every result it gives carries the command and its output as evidence.
import { spawnSync } from "node:child_process";
import { MEMORY_INDEX_PY } from "./guidelines.ts";

export interface IndexToolRun {
  /** The command as it was run, for evidence. */
  readonly command: string;
  readonly code: number;
  readonly stdout: readonly string[];
  readonly stderr: readonly string[];
  /** Requirement id (SoT id, no prefix) -> the lines of the tool that found the break. */
  readonly findings: ReadonlyMap<string, readonly string[]>;
  /** `INDEX.md: 12/200 lines, 900/24000 bytes`, when the tool printed it. */
  readonly sizeLine: string | null;
  /** The tool's own over-limit failure (it prints this only after the index matched). */
  readonly overLimit: boolean;
  /** `project-memory/INDEX.md ... does not match what these entries build`. */
  readonly mismatch: boolean;
  /** `nothing to check: no project-memory/ in ...`. */
  readonly noMemory: boolean;
  /** `nothing to check: HEAD names no commit yet ...`. */
  readonly unbornHead: boolean;
  readonly upToDate: boolean;
  /** The index the entries build was measured against the size limits: the tool printed its size line. */
  readonly measured: boolean;
  /** The index was compared with what the entries build: the tool printed its size line and then judged it. */
  readonly compared: boolean;
  /** python itself failed: a traceback, an exit code no check of a memory uses, or no python3 at all. */
  readonly crashed: boolean;
  /** Problems the tool stopped on that name no requirement id: a check this tool cannot report either way. */
  readonly unmapped: readonly string[];
  /** Tool messages that name no requirement id: reported as notes, never dropped. */
  readonly notes: readonly string[];
}

const SIZE_LINE = /^INDEX\.md: (\d+)\/(\d+) lines, (\d+)\/(\d+) bytes/;

/** The index the tool judges, as it names itself (`INDEX_PATH`, tools/memory_index.py:40). */
const INDEX_NAME = "project-memory/INDEX.md";
const UP_TO_DATE = new RegExp(`^${INDEX_NAME.replace(/\//g, "\\/")} in .+ is up to date$`);
const MISMATCH = new RegExp(`${INDEX_NAME.replace(/\//g, "\\/")} in .+ does not match`);
const OVER_LIMIT = new RegExp(`${INDEX_NAME.replace(/\//g, "\\/")} in .+ is over the limit`);

/** A per-file problem as memory_index.py prints it: `<file name>: <problem>` (`tools/memory_index.py:385`). */
const PER_FILE = /^([^:]+): (.+)$/;

/** Which requirement each of memory_index.py's own problems belongs to. Order matters: longer patterns first. */
function idOfProblem(problem: string): string | null {
  if (/^kind .* is not one of/.test(problem)) return "W1.1a";
  if (/^kind .* does not match the/.test(problem)) return "W1.1a";
  if (/^id .* is not in the form/.test(problem)) return "W1.1b";
  if (/^(empty id|duplicate id)/.test(problem)) return "W1.1b";
  if (/^(no header|header is not closed)/.test(problem)) return "W1.2a";
  if (/^(no \*\*Why:\*\* line|empty claim)/.test(problem)) return "W1.3a";
  if (/^status .* is not one of/.test(problem)) return "W4.1b";
  if (/^unresolved conflict marker/.test(problem)) return "K6.3a";
  return null;
}

export function runMemoryIndex(root: string): IndexToolRun {
  const args = ["--check"];
  const result = spawnSync("python3", [MEMORY_INDEX_PY, ...args], {
    cwd: root,
    encoding: "utf8",
    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
  });
  const code = result.status ?? -1;
  const stdout = (result.stdout ?? "").split("\n").filter((line) => line.trim() !== "");
  const stderr = (result.stderr ?? "").split("\n").filter((line) => line.trim() !== "");
  const command = `python3 ${MEMORY_INDEX_PY} --check   (in ${root})`;

  const findings = new Map<string, string[]>();
  const notes: string[] = [];
  const unmapped: string[] = [];
  let sizeLine: string | null = null;
  let overLimit = false;
  let mismatch = false;
  let noMemory = false;
  let unbornHead = false;
  let upToDate = false;

  const add = (id: string, line: string): void => {
    const bucket = findings.get(id) ?? [];
    bucket.push(line);
    findings.set(id, bucket);
  };

  for (const line of [...stdout, ...stderr]) {
    const message = line.trim();
    if (SIZE_LINE.test(message)) {
      sizeLine = message;
      continue;
    }
    if (/^nothing to check: no project-memory\//.test(message)) {
      noMemory = true;
      continue;
    }
    if (/^nothing to check: HEAD names no commit/.test(message)) {
      unbornHead = true;
      continue;
    }
    if (UP_TO_DATE.test(message)) {
      upToDate = true;
      continue;
    }
    if (MISMATCH.test(message)) {
      mismatch = true;
    }
    if (OVER_LIMIT.test(message)) {
      // The index's own size limit: the clause memory_index.py judges (Rd3.1a), reported as its own failure.
      overLimit = true;
      add("Rd3.1a", message);
      continue;
    }
    // The two index clauses share memory_index.py's one comparison: K6.1a and K6.2 are reported together (C3).
    if (/INDEX\.md in .* does not match what these entries build/.test(message)) {
      add("K6.1a", message);
      add("K6.2", message);
      continue;
    }
    const perFile = PER_FILE.exec(message);
    const problem = perFile ? perFile[2]! : message;
    const id = idOfProblem(problem);
    if (id && !/\(warning\)$/.test(message)) {
      // memory_index.py calls a content problem in an inactive entry a warning, and exits 0 on it: a clause it
      // only warns about is not a break here either (C3: never report a pass the tool fails).
      for (const one of id.split(",")) add(one, message);
      continue;
    }
    // A problem the tool stopped on that names no requirement id: it is not a pass and not a fail here — it is a
    // check that could not run (C2, C3). Diff lines and fix hints arrive only after the size line, once the entries
    // were read, so they are never mistaken for one.
    if (!/\(warning\)$/.test(message) && sizeLine === null && !noMemory && !unbornHead && code !== 0) {
      unmapped.push(message);
      continue;
    }
    // Everything else the tool printed: a per-file warning, a diff line, a fix hint. Not a finding of a
    // requirement id, but never dropped.
    notes.push(message);
  }

  // The tool measures the index only after every entry parsed, so a size line means the entry checks all ran.
  const measured = sizeLine !== null;
  return {
    command,
    code,
    stdout,
    stderr,
    findings,
    sizeLine,
    overLimit,
    mismatch,
    noMemory,
    unbornHead,
    upToDate,
    measured,
    compared: measured && (upToDate || mismatch),
    crashed: code === -1 || (code !== 0 && code !== 1) || stderr.some((line) => /Traceback \(most recent call last\)/.test(line)),
    unmapped,
    notes,
  };
}

/** Whether the tool could not be run at all: no python3, or a crash of its own. */
export function toolFailedToStart(run: IndexToolRun): boolean {
  return run.crashed;
}

/** Why the index clauses did not run: the tool had no snapshot, or it stopped on the entries before comparing. */
export function indexChecksNotReached(run: IndexToolRun): string {
  if (run.noMemory || run.unbornHead) {
    return `memory_index.py had no snapshot to compare (${run.stdout.join(" ")}): the index clauses did not run (C2)`;
  }
  const stopped = [...run.stdout, ...run.stderr].filter((line) => line.trim() !== "" && !SIZE_LINE.test(line.trim()));
  return (
    `memory_index.py stopped at its entry checks and never compared ${INDEX_NAME}, so the index clauses did not ` +
    `run (C2): ${stopped.slice(0, 4).join(" | ") || `exit ${run.code}`}`
  );
}

// Every git call the tool makes: read-only, with GIT_OPTIONAL_LOCKS=0 so git never writes its index file (F3).
import { spawnSync } from "node:child_process";

export interface GitResult {
  readonly code: number;
  readonly stdout: string;
  readonly stderr: string;
}

export function git(cwd: string, args: readonly string[]): GitResult {
  const result = spawnSync("git", [...args], {
    cwd,
    encoding: "utf8",
    env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" },
  });
  return {
    code: result.status ?? -1,
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
  };
}

/** Whether a read-only git command succeeded. */
export function gitOk(cwd: string, args: readonly string[]): boolean {
  return git(cwd, args).code === 0;
}

export function gitOut(cwd: string, args: readonly string[]): string {
  const result = git(cwd, args);
  return result.code === 0 ? result.stdout.trim() : "";
}

/** The lines of output that are not empty. */
export function lines(text: string): string[] {
  return text.split("\n").map((line) => line.trimEnd()).filter((line) => line !== "");
}
