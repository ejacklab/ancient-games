    assert result.returncode == 1, output(result)
    assert "INDEX.md" in output(result)
    assert delegated.is_file(), "pre-merge-commit must delegate to pre-commit"


def test_check_catches_commit_that_bypassed_hook(tmp_path):
    """G1.1 G2.3 — a no-verify commit with a stale index must be rejected by the committed snapshot check."""
    repo = make_repo(tmp_path)
    stage_single_entry(repo)
    git(repo, "commit", "-m", "Valid baseline")
    git(repo, "config", "core.hooksPath", ".githooks")
    write_entry(repo, claim="Changed without rebuilding index.")
    git(repo, "add", "-A")
    git(repo, "commit", "--no-verify", "-m", "Bypass convenience hook")
    result = run_index(repo, "--check", "HEAD")
    assert result.returncode == 1, output(result)
    assert "INDEX.md" in output(result)


def test_index_merge_attribute_uses_normal_text(tmp_path):
    """G3.1 — [static] repository attributes must not select union, binary or a custom merge driver."""
    repo = make_repo(tmp_path, copy_tool=False)
    result = git(repo, "check-attr", "merge", "--", "project-memory/INDEX.md")
    assert result.stdout.strip().rsplit(": ", 1)[-1] in {"unspecified", "set"}, result.stdout


def test_conflicted_index_is_regenerated_from_merged_entries(tmp_path):
    """G3.2 — resolving entry changes and regenerating must replace conflicted index text with the exact merged index."""
    repo = make_repo(tmp_path)
    stage_single_entry(repo)
    git(repo, "commit", "-m", "Common memory")
    git(repo, "checkout", "-b", "other")
    write_entry(repo, "F-other.md", id="14-10-other0-2026", kind="fact", claim="Other branch fact.")
    git(repo, "add", "-A")
    result = run_index(repo)
    assert result.returncode == 0, output(result)
    git(repo, "add", "-A")
    git(repo, "commit", "-m", "Other branch entry")
    git(repo, "checkout", "main")
    write_entry(repo, claim="Main branch decision.")
    git(repo, "add", "-A")
    result = run_index(repo)
    assert result.returncode == 0, output(result)
    git(repo, "add", "-A")
    git(repo, "commit", "-m", "Main branch change")
    merge = git(repo, "merge", "--no-commit", "other", check=False)
    assert merge.returncode == 1, output(merge)
    assert "project-memory/INDEX.md" in git(repo, "diff", "--name-only", "--diff-filter=U").stdout
    assert b"<<<<<<<" in (repo / INDEX).read_bytes()
    result = run_index(repo)
    assert result.returncode == 0, output(result)
    expected = HEADER + (
        b"- [14-10-a1b2c3-2026](entries/D-one.md) decision: Main branch decision.\n"
        b"- [14-10-other0-2026](entries/F-other.md) fact: Other branch fact.\n"
    )
    assert (repo / INDEX).read_bytes() == expected
    git(repo, "add", "-A")
    git(repo, "config", "core.hooksPath", ".githooks")
    git(repo, "commit", "-m", "Regenerate merged memory")
    result = run_index(repo, "--check", "HEAD")
    assert result.returncode == 0, output(result)

