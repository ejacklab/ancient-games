// Tests for the enhance round (runs/20261017-memory-check/enhance-q/compare.md, the main agent's picks): R1's
// unstaged line and final Not applicable section, R2/U3's could-not-run MUSTs in the warning. Written by the main
// agent (Claude), which wrote none of src/.
import { afterEach, describe, expect, test } from "bun:test";
import { execSync } from "node:child_process";
import { chmodSync, mkdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { Project, entryPath } from "./fixtures/project";

const projects: Project[] = [];
function fixture(memory = true) { const p = new Project(memory); projects.push(p); return p; }
afterEach(() => { for (const p of projects.splice(0)) p.close(); });

const ROW = /^- \*\*((?:SoT|CACHES):[^*]+)\*\* \(([^)]+)\) — (pass|fail|needs a reviewer|not applicable|could not run) — (.*)$/;

describe("enhance round", () => {
  test("R1: every not applicable result is in a final ## Not applicable section, and only there", () => {
    const text = fixture(false).run().stdout;
    const lines = text.split("\n");
    const start = lines.indexOf("## Not applicable");
    expect(start).toBeGreaterThan(0);
    expect(lines.slice(start + 1).some((l) => l.startsWith("## "))).toBe(false); // it is the last section
    const before = lines.slice(0, start).map((l) => ROW.exec(l)).filter(Boolean);
    const after = lines.slice(start + 1).map((l) => ROW.exec(l)).filter(Boolean);
    expect(before.some((m) => m![3] === "not applicable")).toBe(false);
    expect(after.length).toBeGreaterThan(0);
    expect(after.every((m) => m![3] === "not applicable")).toBe(true);
  });

  test("R1: the report counts project-memory files changed but not staged", () => {
    const p = fixture();
    writeFileSync(join(p.project, entryPath), "an unstaged edit\n");
    p.write("project-memory/entries/O-18-10-new000-2026-x.md", "an untracked new file\n");
    const text = p.run().stdout;
    expect(text).toMatch(/2 files? under `?project-memory\/`? (are )?changed but not staged/);
  });

  test("R1: with nothing unstaged the count is 0", () => {
    expect(fixture().run().stdout).toMatch(/0 files? under `?project-memory\/`? (are )?changed but not staged/);
  });

  test("R2/U3: a MUST that could not run is in the warning", () => {
    const p = fixture();
    const bin = join(p.base, "bin"); mkdirSync(bin);
    const real = execSync("command -v git", { encoding: "utf8" }).trim();
    writeFileSync(join(bin, "git"), `#!/bin/sh\nfor a in "$@"; do [ "$a" = log ] && { echo "fatal: injected" >&2; exit 128; }; done\nexec ${real} "$@"\n`);
    chmodSync(join(bin, "git"), 0o755);
    p.env.PATH = `${bin}:${p.env.PATH}`;
    const report = p.run().stdout;
    const notRun = report.split("\n").map((l) => ROW.exec(l)).filter((m) => m && m[2] === "MUST" && m[3] === "could not run").map((m) => m![1]);
    expect(notRun.length).toBeGreaterThan(0);
    const warning = p.run(["--warn"]).stdout;
    for (const id of notRun) expect(warning).toContain(id!);
  });
});
import { expect } from "bun:test";
import { createHash } from "node:crypto";
import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync, copyFileSync, openSync, closeSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { spawnSync } from "node:child_process";

export const toolRoot = resolve(import.meta.dir, "../..");
export const repository = resolve(toolRoot, "..");
export const entryPath = "project-memory/entries/D-17-10-abc123-2026-choice.md";
export const claim = "Use UTC for stored timestamps.";
export const entry = `---
id: 17-10-abc123-2026
kind: decision
status: active
author: fixture
recorded: 2026-10-17
covers:
  - src/time.ts
source: docs/clock.md
depends_on: []
supersedes: []
superseded_by: []
changed:
  - 2026-10-17T00:00:00Z fixture created
---
Use UTC for stored timestamps.

**Why:** Shared clocks need one time zone.

**How to apply:** Store UTC timestamps.
`;
// Literal expected bytes, transcribed from the documented format, never generated by the CLI.
export const indexHeader = "# Project memory index\n\n<!-- Generated by tools/memory_index.py from project-memory/entries/. Do not edit by hand. Rebuild: python3 tools/memory_index.py -->\n\n";
export const emptyIndex = indexHeader + "(no active entries)\n";
export const singleIndex = indexHeader + "- [17-10-abc123-2026](entries/D-17-10-abc123-2026-choice.md) decision: Use UTC for stored timestamps.\n";

export class Project {
  base = mkdtempSync(join(tmpdir(), "memory-check-acceptance-"));
  project = join(this.base, "project");
  home = join(this.base, "home");
  env: NodeJS.ProcessEnv;
  constructor(memory = true) {
    this.env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !key.startsWith("GIT_") && key !== "HOME"));
    Object.assign(this.env, { HOME: this.home, GIT_CONFIG_GLOBAL: "/dev/null", GIT_CONFIG_NOSYSTEM: "1", GIT_OPTIONAL_LOCKS: "0", GIT_AUTHOR_NAME: "Fixture", GIT_AUTHOR_EMAIL: "fixture@example.invalid", GIT_COMMITTER_NAME: "Fixture", GIT_COMMITTER_EMAIL: "fixture@example.invalid", PYTHONDONTWRITEBYTECODE: "1" });
    mkdirSync(this.project); mkdirSync(this.home);
    this.git("init", "-q", "-b", "main");
    this.git("config", "core.hooksPath", "/dev/null");
    this.write("AGENTS.md", "Read project-memory/INDEX.md at session start.\n");
    this.write(".gitignore", "project-memory/.cache/\n");
    mkdirSync(join(this.project, "tools"));
    copyFileSync(join(repository, "tools/memory_index.py"), join(this.project, "tools/memory_index.py"));
    if (memory) { this.write(entryPath, entry); this.write("project-memory/INDEX.md", singleIndex); }
    this.commit("Initial fixture");
  }
  write(path: string, text: string) { const full = join(this.project, path); mkdirSync(dirname(full), { recursive: true }); writeFileSync(full, text); }
  git(...args: string[]) {
    const r = spawnSync("git", args, { cwd: this.project, env: this.env, encoding: "utf8" });
    if (r.status !== 0) throw new Error(`git ${args.join(" ")}: ${r.stdout}${r.stderr}`);
    return r.stdout.trim();
  }
  commit(message: string) { this.git("add", "-A"); this.git("commit", "-qm", message); }
  plant(path: string, oldLine: string, newLine: string) {
    const before = readFileSync(join(this.project, path), "utf8");
    expect(before.split(oldLine).length - 1).toBe(1);
    const offset = before.indexOf(oldLine);
    expect(offset).toBeGreaterThan(0); expect(offset + oldLine.length).toBeLessThan(before.length);
    this.write(path, before.replace(oldLine, newLine));
    expect(readFileSync(join(this.project, path), "utf8")).toBe(before.replace(oldLine, newLine));
    this.git("add", path);
  }
  run(args: string[] = [], cwd = toolRoot, explicitProject = true) {
    // Bun 1.4.3 loses piped writes at process.exit(); file descriptors retain the CLI bytes.
    const capture = mkdtempSync(join(tmpdir(), "memory-check-capture-"));
    const stdout = openSync(join(capture, "stdout"), "w");
    const stderr = openSync(join(capture, "stderr"), "w");
    try {
      const r = spawnSync("bun", [cwd === toolRoot ? "src/cli.ts" : join(toolRoot, "src/cli.ts"), ...(explicitProject ? ["--project", this.project] : []), "--home", this.home, ...args], { cwd, env: this.env, stdio: ["ignore", stdout, stderr], timeout: 20000 });
      if (r.error) throw r.error;
      return { status: r.status, stdout: readFileSync(join(capture, "stdout"), "utf8"), stderr: readFileSync(join(capture, "stderr"), "utf8") };
    } finally { closeSync(stdout); closeSync(stderr); rmSync(capture, { recursive: true, force: true }); }
  }

  hashes() {
    const files: Record<string, string> = {};
    const walk = (path: string) => { for (const item of readdirSync(path, { withFileTypes: true })) { const file = join(path, item.name); if (item.isDirectory()) walk(file); else files[file.slice(this.base.length + 1)] = createHash("sha256").update(readFileSync(file)).digest("hex"); } };
    walk(this.base); return files;
  }
  close() { rmSync(this.base, { recursive: true, force: true }); }
}

