@pytest.mark.parametrize("mode", ["staged", "commit"])
@pytest.mark.parametrize("valid", [True, False])
def test_check_does_not_write_files_or_git_state(tmp_path, mode, valid):
    """C1.4 — passing and failing checks must leave working files, staging and refs untouched."""
    repo = make_repo(tmp_path)
    stage_single_entry(repo)
    if not valid:
        (repo / INDEX).write_bytes(b"wrong staged bytes\n")
    args = snapshot_args(repo, mode)
    (repo / INDEX).write_bytes(b"unstaged working-tree bytes\n")
    paths = [path for path in repo.rglob("*") if path.is_file() and ".git" not in path.relative_to(repo).parts]
    before = {path.relative_to(repo): (path.read_bytes(), path.stat().st_mtime_ns, path.stat().st_ino) for path in paths}
    index_before = (repo / ".git/index").read_bytes()
    refs_before = git(repo, "show-ref").stdout
    result = run_index(repo, *args)
    assert result.returncode == (0 if valid else 1), output(result)
    paths = [path for path in repo.rglob("*") if path.is_file() and ".git" not in path.relative_to(repo).parts]
    after = {path.relative_to(repo): (path.read_bytes(), path.stat().st_mtime_ns, path.stat().st_ino) for path in paths}
    assert after == before
    assert (repo / ".git/index").read_bytes() == index_before
    assert git(repo, "show-ref").stdout == refs_before


