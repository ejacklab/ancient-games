   554	def self_test() -> int:
   555	    """A settings file with no deny list must come out `absent` — the check can fail."""
   556	    w = Where(Path("/nonexistent/home"), Path("/nonexistent/proj"), {})
   557	    user = w.claude / "settings.json"
   558	
   559	    def reader(settings):
   560	        return lambda p: (settings, "") if p == user else ({}, "absent")
   561	    bad = [f.finding for f in claude_lines(w, reader({"permissions": {"allow": ["Bash(ls:*)"]}}))
   562	           if f.item == "deny rules"]
   563	    good = [f.finding for f in claude_lines(w, reader({"permissions": {"deny": ["Read(./.env)"]}}))
   564	            if f.item == "deny rules"]
   565	    if bad == ["absent"] and good == ["present"]:
   566	        print("self-test PASS: no deny list → absent, a deny list → present — the check can fail.")
   567	        return 0
   568	    print(f"self-test FAIL: bad={bad} good={good}")
   569	    return 1
