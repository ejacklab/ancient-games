+def guard_answers():
+    return {
+        "doctor": {"harnesses": [{"harness": "claude-code", "guard": "installed", "answers": True,
+                                   "note": "planted hook state"}], "health": {"ok": True, "summary": "ok"}},
+        "rates": {"rows": []},
+        "insight": {"open": [], "invalid": [], "unreadable": []},
+    }
+
