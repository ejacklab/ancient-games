INIT = """
window.__ev = [];
for (const t of ["touchstart","touchmove","touchend","touchcancel"]) {
  document.addEventListener(t, (e) => {
    const p = e.changedTouches[0];
    window.__ev.push([t, e.touches.length, Math.round(p ? p.clientX : -1), Math.round(p ? p.clientY : -1)]);
  }, {passive:true, capture:true});
}
"""
with sync_playwright() as pw:
    b=pw.chromium.launch(); ctx=b.new_context(viewport={"width":412,"height":915},device_scale_factor=3.5,is_mobile=True,has_touch=True)
