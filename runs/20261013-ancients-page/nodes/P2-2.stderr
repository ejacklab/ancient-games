from playwright.sync_api import sync_playwright
URL="file:///tmp/opencode/plain.html"
def run(label, **launch):
    with sync_playwright() as pw:
        b=pw.chromium.launch(**launch); ctx=b.new_context(viewport={"width":412,"height":915},is_mobile=True,has_touch=True,device_scale_factor=3.5)
        p=ctx.new_page(); p.goto(URL); p.wait_for_timeout(300)
        cdp=ctx.new_cdp_session(p)
        st=lambda: p.evaluate("()=>Math.round(document.getElementById('s').scrollLeft)")
        cdp.send("Input.synthesizeScrollGesture", {"x":330,"y":400,"xDistance":-247,"yDistance":0,"speed":800,"gestureSourceType":"touch"})
        p.wait_for_timeout(700)
        print(label, "synth-touch ->", st())
        # manual with timestamps
        p.evaluate("()=>{document.getElementById('s').scrollLeft=0}")
        t=1000.0
        cdp.send("Input.dispatchTouchEvent", {"type":"touchStart","touchPoints":[{"x":330,"y":400,"radiusX":2,"radiusY":2,"force":1}],"timestamp":t})
        for i,x in enumerate((300,260,220,180,150,130)):
            t+=0.016
            cdp.send("Input.dispatchTouchEvent", {"type":"touchMove","touchPoints":[{"x":x,"y":400,"radiusX":2,"radiusY":2,"force":1}],"timestamp":t})
            p.wait_for_timeout(16)
        t+=0.016
        cdp.send("Input.dispatchTouchEvent", {"type":"touchEnd","touchPoints":[],"timestamp":t})
        p.wait_for_timeout(900)
        print(label, "manual-touch ->", st())
        b.close()
run("default")
run("touch-events=enabled", args=["--touch-events=enabled"])
