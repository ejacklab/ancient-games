    p.wait_for_timeout(700)
    ev = p.evaluate("() => window.__ev.slice(0,12)")
    print("vertical events:", ev, "count:", p.evaluate("()=>window.__ev.length"))
    print("panel scrollTop:", p.evaluate("()=>document.querySelectorAll('section.person')[0].scrollTop"))
    b.close()
