import json,re
d=json.load(open('content/ancients.json'))
fields=[]
for p in d['persons']:
    fields.append(('who:'+p['id'], p['who']['markdown']))
    for it in p['items']:
        for k in ('title','rule','words','source','label','from'):
            fields.append((k+':'+p['id'], str(it[k])))
pats={'pipe_table':r'^\|.*\|','fence':r'^\`\`\`','inline_code':r'\`[^\`]+\`','heading':r'^#{1,6} ','list':r'^[*-] ','ol':r'^\d+\. ','bold':r'\*\*[^*]+\*\*','emph':r'(?<![*\w])\*[^*\n]+\*(?!\*)','link':r'\[[^]]+\]\([^)]+\)','html':r'<[a-zA-Z/]','blockquote':r'^> ','longword':r'\S{40,}'}
from collections import Counter
c=Counter()
ex={}
for name,v in fields:
    for pn,pv in pats.items():
        if re.search(pv,v,re.M):
            c[pn]+=1
            ex.setdefault(pn,(name,v[:400]))
for k,v in c.most_common(): print(k, v)
print()
for k in ('pipe_table','fence','html','blockquote','ol'):
    if k in ex: print('==',k,'==', ex[k][0]); print(ex[k][1][:500]); print()
"
