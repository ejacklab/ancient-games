+class ReferenceRenderer(RendererHTML):
+    """Renders a Markdown link as its label plus the address, both readable, the way the rest of this data
+    cites sources (Linus's sources carry bare URLs). The page is one offline file a phone reads, so a link
+    that hides its address behind a tap is the wrong shape here, and R5.1 wants a field's own text on the
+    page: keeping the address in the text keeps the rendered letters identical to the field's letters."""
 
+    def link_open(self, tokens, idx, options, env):
+        return ""
+
+    def link_close(self, tokens, idx, options, env):
+        for k in range(idx - 1, -1, -1):
+            if tokens[k].type == "link_open":
+                url = tokens[k].attrGet("href") or ""
+                return f' (<a class="url" href="{html.escape(url, quote=True)}">{html.escape(url)}</a>)'
+        return ""
+
+
+MD = MarkdownIt(
+    "commonmark", {"html": False, "typographer": True}, renderer_cls=ReferenceRenderer
+).enable(["table", "strikethrough"])
