+def test_rt_13_blueprint_workflows_and_usage_errors(sandbox):
+    bp, wf, nope = (sandbox.cwd / name for name in ("bp", "wf", "nope"))
+    for name in ("README.md", "a.md", "b.md", "notes.txt"):
