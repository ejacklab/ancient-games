+    assert_row(offline, "agy", "verified", "agy-fake 1.2.14", "`agy --version`", "Tools")
+    assert_row(offline, "agy login (model list)", "unknown",
+               "offline run: not provable without `agy models`; rerun with --net", "`agy models` (network)")
