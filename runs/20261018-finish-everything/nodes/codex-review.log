// Reading one entry file's header and body: the few fields the tool's own git checks compare (K4.1, K4.3,
// W1.1a, W1.1b, W6.1a). The format clauses W1.1a, W1.1b, W1.2a, W1.3a, W4.1b and K6.3a are not judged here — they
// are `tools/memory_index.py --check`'s, and the tool runs it instead of checking them a second way (C3).

export interface Field {
  /** The value on the `key:` line, whitespace collapsed. */
  readonly value: string;
  /** The value plus every indented or `- ` continuation line under it, as one text. */
  readonly full: string;
  /** The continuation lines under the `key:` (`- ` items, or wrapped values), one per line. */
  readonly items: readonly string[];
  /** The 1-based line the `key:` is on, for evidence. */
  readonly line: number;
}

export interface Entry {
  readonly name: string;
  readonly text: string;
  readonly fields: ReadonlyMap<string, Field>;
  /** The body up to `**Why:**`, whitespace collapsed: the claim. */
  readonly claim: string;
  readonly claimLine: number;
  /** The `id:` lines at top level: more than one means more than one entry in the file (W6.1a). */
  readonly idLines: number[];
  /** The lines that are exactly `---`: more than two means more than one header block (W6.1a). */
  readonly headerBlocks: number;
  readonly headerStartLine: number;
  readonly headerEndLine: number;
}

const WHY = "**Why:**";

function squash(text: string): string {
  return text.replace(/\s+/g, " ").trim();
}

/** One pair of surrounding quotes, as memory_index.py's `unquote` strips (tools/memory_index.py:127): a header
 *  scalar written `status: "superseded"` is the status `superseded`, and comparing it unquoted is comparing what
 *  the index checker reads. */
function unquote(value: string): string {
  const first = value[0];
  return value.length >= 2 && first === value[value.length - 1] && (first === '"' || first === "'")
    ? value.slice(1, -1)
    : value;
}

const FENCE = /^\s{0,3}(`{3,}|~{3,})/;

/**
 * The lines that are exactly `---`, as line numbers. A line inside a fenced code block is the entry's own content —
 * a Markdown example of a header is not a second header (W6.1a), so fences are stepped over.
 */
function delimiterLines(lines: readonly string[]): number[] {
  const found: number[] = [];
  let fence = "";
  for (const [index, line] of lines.entries()) {
    const marker = FENCE.exec(line);
    if (marker) {
      const token = marker[1]!;
      if (fence === "") fence = token[0]!;
      else if (token.startsWith(fence)) fence = "";
      continue;
    }
    if (fence !== "") continue;
    if (line === "---") found.push(index);
  }
  return found;
}

/** A top-level `key:` line: what a header block is made of, and what a thematic break in the body is not. */
function isFieldLine(line: string): boolean {
  if (line.trim() === "" || /^\s/.test(line) || line.startsWith("- ")) return false;
  return line.indexOf(":") > 0;
}

/** The header blocks the delimiters close: a pair of `---` lines holds one only when the lines between them are a
 * header, so two thematic breaks in a body are content and not a second entry (C9). */
function headerDelimiters(lines: readonly string[]): number[] {
  const raw = delimiterLines(lines);
  const found: number[] = [];
  for (let index = 0; index + 1 < raw.length; index += 2) {
    const open = raw[index]!;
    const close = raw[index + 1]!;
    if (!lines.slice(open + 1, close).some(isFieldLine)) break; // not a header, so no later pair is read as one
    found.push(open, close);
  }
  return found;
}

export function parseEntry(name: string, text: string): Entry {
  const lines = text.replace(/\r\n/g, "\n").split("\n");
  const fences = headerDelimiters(lines);
  const start = fences[0] ?? -1;
  const end = fences[1] ?? -1;
  const fields = new Map<string, Field>();
  const idLines: number[] = [];
  if (start === 0 && end > 0) {
    let current: { key: string; value: string; parts: string[]; items: string[]; line: number } | null = null;
    const close = (): void => {
      if (current) {
        fields.set(current.key, {
          value: current.value,
          full: squash(current.parts.join(" ")),
          items: current.items,
          line: current.line,
        });
      }
      current = null;
    };
    for (let index = start + 1; index < end; index++) {
      const line = lines[index] ?? "";
      if (line.trim() === "") continue;
      const indented = /^\s/.test(line);
      if (indented || line.startsWith("- ")) {
        if (current) {
          current.parts.push(line.trim());
          current.items.push(line.trim().replace(/^-\s*/, ""));
        }
        continue;
      }
      const colon = line.indexOf(":");
      if (colon <= 0) continue;
      close();
      const key = line.slice(0, colon).trim();
      const value = unquote(line.slice(colon + 1).trim());
      current = { key, value, parts: value ? [value] : [], items: value ? [value] : [], line: index + 1 };
      if (key === "id") idLines.push(index + 1);
    }
    close();
  }
  const body = lines.slice(end >= 0 ? end + 1 : 0);
  let claim = "";
  let claimLine = (end >= 0 ? end : 0) + 2;
  for (const [offset, line] of body.entries()) {
    if (line.startsWith(WHY)) break;
    if (squash(line) !== "") {
      if (claim === "") claimLine = (end >= 0 ? end : 0) + 2 + offset;
      claim = claim === "" ? squash(line) : `${claim} ${squash(line)}`;
    }
  }
  return {
    name,
    text,
    fields,
    claim,
    claimLine,
    idLines,
    headerBlocks: Math.max(0, Math.floor(fences.length / 2)),
    headerStartLine: start + 1,
    headerEndLine: end + 1,
  };
}

export function fieldValue(entry: Entry, key: string): string {
  return entry.fields.get(key)?.full ?? "";
}

/** The id form of W1.1b, the same one tools/memory_index.py checks (`ID_FORM`, tools/memory_index.py:57). */
const ID_FORM = /\d{2}-\d{2}-[0-9a-z]{6}-\d{4}/;

/** `<prefix>-<id>-<slug>.md` (W1.1c): the prefix is the first letter, the id the W1.1b form in the name. A name
 *  with no id in it has none to compare, and that is W1.1c's (a reviewer's) to say. */
export function nameParts(name: string): { prefix: string; id: string | null } {
  return { prefix: name.slice(0, 1), id: ID_FORM.exec(name)?.[0] ?? null };
}// C6, the first version: of CACHES.md's Core requirements only B2.2 (the cache folder is ignored by git) and Rd1
// (no start hook or instruction opens a cache file) are checked. Rd1's scan reads the session-start surface —
// the harness settings, the git hooks, the instruction files — and never opens a file under
// `project-memory/.cache/` itself (Rd1, R2).
import { existsSync, readFileSync, readdirSync, type Dirent } from "node:fs";
import path from "node:path";
import { cacheIsIgnored, sessionStartFiles, stagedFiles, type GitErrors } from "./gitchecks.ts";
import type { ClauseOutcome } from "./gitrequirements.ts";

const CACHE_REFERENCE = /(?:\bproject-memory\/)?\.cache\/[^\s`"')]*/;
const OPENS = /\b(read|open|load|cat|head|tail|less|more|sqlite3|query|search|grep|rg|glob|import|attach|select|list)\b/i;
const NEGATED = /\b(never|no|not|avoid|without|don'?t|do not|nothing)\b/i;
/** What ties an instruction to the start of a session: Rd1's subject is the start of one, not any time (C6). */
const SESSION_START =
  /\b(at (?:the |a )?(?:session )?start|start of (?:the |a )?session|session start|on startup|at startup|when (?:a |the )?session (?:begins|starts)|every session|each session)\b/i;
/** Something that reaches the cache without saying so on the line: a run command, a hook or a script. */
const INDIRECT = /\b(script|hook|command|npm|pnpm|bun|yarn|bash|sh|tools\/)\b/i;
const CLAUSE_SPLIT = /[;,]|\bbut\b|\bhowever\b/;

/**
 * What one line says about the cache, and what the tool can decide about it:
 * - `opens` true and `atStart` false: an on-demand read, which CACHES.md allows — nothing to decide (Rd1 is about
 *   the start of a session).
 * - `opens` true, `atStart` true and not negated: an instruction to open a cache file at the start of a session —
 *   a break, with the line's number.
 * - `atStart` true with no verb the tool knows, or with a run command: the instruction is not clear enough to be
 *   called a break, and not clear enough to be cleared — the reviewer's (C2).
 * - `negated` true: an instruction not to read a cache is not an instruction to read it.
 */
interface LineReading {
  readonly atStart: boolean;
  readonly opens: boolean;
  readonly negated: boolean;
  readonly indirect: boolean;
}

function readLine(line: string): LineReading {
  const atStart = SESSION_START.test(line);
  // A clause is judged on its own words: a negation in one clause does not exempt another (a line that both forbids
  // and does the thing is not a clean "never read the cache").
  const clauses = line.split(CLAUSE_SPLIT).filter((clause) => clause.trim() !== "");
  const cacheClauses = clauses.filter((clause) => CACHE_REFERENCE.test(clause));
  const subject = cacheClauses.length > 0 ? cacheClauses.join(" ") : line;
  return {
    atStart,
    opens: OPENS.test(subject),
    negated: cacheClauses.length > 0 ? cacheClauses.every((clause) => NEGATED.test(clause)) : NEGATED.test(line),
    indirect: INDIRECT.test(subject),
  };
}

/** The harness settings files whose `hooks` name their events: a hook is a session-start hook by where it sits. */
const SETTINGS_FILES = new Set([".claude/settings.json", ".claude/settings.local.json"]);
const SESSION_START_EVENT = /^session_?start$/i;

/** Every `command` string under a value, however the hooks nest them. */
function commandsUnder(value: unknown): string[] {
  if (Array.isArray(value)) return value.flatMap(commandsUnder);
  if (value === null || typeof value !== "object") return [];
  return Object.entries(value).flatMap(([key, one]) =>
    key === "command" && typeof one === "string" ? [one] : commandsUnder(one),
  );
}

/**
 * The commands the SessionStart hooks of a harness settings file run. Such a command opens a cache file at the start
 * of a session by being registered there: it says nothing about *when* it runs, so the line-by-line wording test
 * cannot see it, and it was read as an on-demand read (C4, A3).
 */
function sessionStartHookCommands(text: string): string[] {
  let document: unknown;
  try {
    document = JSON.parse(text);
  } catch {
    return []; // not JSON: the line scan above is the whole reading of it
  }
  const hooks = (document as { hooks?: unknown } | null)?.hooks;
  if (hooks === null || typeof hooks !== "object") return [];
  const commands: string[] = [];
  for (const [event, entries] of Object.entries(hooks as Record<string, unknown>)) {
    if (SESSION_START_EVENT.test(event)) commands.push(...commandsUnder(entries));
  }
